---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentByline from "~/components/ContentByline.astro";
import CompareRail from "~/components/CompareRail.astro";
import ZipForm from "~/components/ZipForm.astro";
import type { Vertical } from "~/data/verticals";

interface Section {
  heading?: string;
  body: string;          // HTML or markdown-rendered content
}

interface RelatedLink {
  label: string;
  href: string;
  desc?: string;
}

interface Props {
  vertical: Vertical;
  /** Breadcrumb segment for this page, e.g. "Cheapest carriers" */
  topic: string;
  /** Page H1 — usually mirrors topic with a vertical-aware verb */
  headline: string;
  /** One- or two-sentence lede under the headline */
  lede: string;
  /** Optional eyebrow line (defaults to the vertical label) */
  eyebrow?: string;
  /** Main editorial content — array of sections, rendered in order */
  sections: Section[];
  /** Optional related-links rail at the bottom */
  related?: RelatedLink[];
  /** Optional CTA over-ride; defaults to the picker */
  showCTA?: boolean;
  /** SEO overrides */
  seoTitle?: string;
  seoDescription?: string;
  /** Optional author/reviewer override (defaults to Rai/David) */
  author?: string;
  reviewer?: string;
  /** Optional publish/update dates */
  publishDate?: string | Date;
  updatedDate?: string | Date;
}

const {
  vertical,
  topic,
  headline,
  lede,
  eyebrow,
  sections,
  related = [],
  showCTA = true,
  seoTitle,
  seoDescription,
  author,
  reviewer,
  publishDate,
  updatedDate,
} = Astro.props;

// Default updated date to today if none provided — these are evergreen
// support pages, so a recent date keeps them from looking stale.
const effectiveUpdated = updatedDate ?? new Date();
const effectivePublished = publishDate ?? effectiveUpdated;
---

<BaseLayout
  title={seoTitle ?? `${headline} | ${vertical.label}`}
  description={seoDescription ?? lede}
  pageType="article"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: vertical.short, url: vertical.path },
    { name: topic, url: Astro.url.pathname },
  ]}
  article={{
    publishDate: new Date(effectivePublished).toISOString(),
    modifiedDate: new Date(effectiveUpdated).toISOString(),
    authorName: author,
    reviewerName: reviewer,
    tags: [vertical.short, topic],
  }}
>
  <article class="topic">
    <header class="topic__hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__sep" aria-hidden="true">›</span>
          <a href={vertical.path}>{vertical.short}</a>
          <span class="breadcrumbs__sep" aria-hidden="true">›</span>
          <span aria-current="page">{topic}</span>
        </nav>
        <p class="topic__eyebrow">
          <img src={vertical.icon} alt="" width="18" height="18" />
          {eyebrow ?? `${vertical.label} · ${topic}`}
        </p>
        <ContentByline
          variant="inline"
          author={author}
          reviewer={reviewer}
          publishDate={effectivePublished}
          updatedDate={effectiveUpdated}
          compareVertical={vertical.key}
        />
        <h1 class="topic__h1">{headline}</h1>
        <p class="topic__lede">{lede}</p>
      </div>
    </header>

    <div class="topic__body">
      <div class="container topic__body-wrap">
        <div class="topic__body-prose">
          {sections.map((s) => (
            <section class="topic__section">
              {s.heading && <h2>{s.heading}</h2>}
              <div set:html={s.body} />
            </section>
          ))}

        {showCTA && (
          <div class="topic__cta">
            <div class="topic__cta-stage">
              <img
                src="/assets/images/bob-the-yeti-head.png"
                alt=""
                class="topic__cta-yeti"
                aria-hidden="true"
              />
              <div class="topic__cta-wrap">
                <ZipForm
                  variant="picker"
                  vertical={vertical.key}
                  eyebrow="See live rates"
                  heading={`See ${vertical.short.toLowerCase()} rates`}
                />
              </div>
            </div>
          </div>
        )}

        {related.length > 0 && (
          <aside class="topic__related" aria-label="Related">
            <h3 class="topic__related-title">Related on {vertical.short}</h3>
            <ul class="topic__related-list">
              {related.map((r) => (
                <li>
                  <a href={r.href}>
                    <span class="topic__related-label">{r.label}</span>
                    {r.desc && <span class="topic__related-desc">{r.desc}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
        </div>
        <div class="topic__body-rail">
          <CompareRail vertical={vertical.key} />
        </div>
      </div>
    </div>
  </article>

  <style>
    .topic__hero {
      padding-block: var(--space-14) var(--space-10);
      background: var(--section-accent-soft);
      border-bottom: 1px solid var(--color-border);
    }
    .breadcrumbs {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      margin-bottom: var(--space-5);
      display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;
    }
    .breadcrumbs a { color: var(--color-text-muted); text-decoration: none; }
    .breadcrumbs a:hover { color: var(--section-accent); }
    .breadcrumbs__sep { opacity: 0.4; }
    .topic__eyebrow {
      display: inline-flex; align-items: center; gap: var(--space-2);
      font-family: var(--font-display);
      font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--section-accent);
      background: var(--color-white);
      padding: var(--space-2) var(--space-4);
      border-radius: 100px;
      margin: 0 0 var(--space-5);
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .topic__h1 {
      font-size: clamp(2rem, 3.75vw, 2.75rem);
      letter-spacing: -0.025em;
      line-height: 1.1;
      margin: 0 0 var(--space-4);
    }
    .topic__lede {
      font-size: 1.1875rem;
      color: var(--color-text-strong);
      line-height: 1.55;
      max-width: 640px;
      margin: 0;
    }
    .topic__hero-cta { display: none; } /* deprecated — was the dark band */
    .topic__body {
      padding-block: var(--space-12) var(--space-20);
      background: var(--color-white);
    }
    .topic__body-wrap {
      display: grid;
      grid-template-columns: minmax(0, 720px) 280px;
      gap: var(--space-12);
      align-items: start;
      justify-content: center;
    }
    .topic__body-prose { min-width: 0; }
    .topic__body-rail {
      position: sticky;
      top: calc(var(--header-height, 72px) + var(--space-4));
    }
    @media (max-width: 1100px) {
      .topic__body-wrap { grid-template-columns: minmax(0, 720px) 260px; gap: var(--space-8); }
    }
    @media (max-width: 960px) {
      .topic__body-wrap { grid-template-columns: 1fr; gap: var(--space-6); justify-content: stretch; }
      .topic__body-prose { max-width: 780px; margin-inline: auto; }
      .topic__body-rail { position: static; max-width: 780px; margin-inline: auto; }
      .topic__body-rail :global(.compare-rail) { max-width: none; }
    }
    .container--narrow { max-width: 760px; margin: 0 auto; }
    .topic__section {
      font-size: 1.0625rem;
      line-height: 1.7;
      margin-bottom: var(--space-10);
    }
    .topic__section h2 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.5rem;
      letter-spacing: -0.015em;
      color: var(--color-resolution);
      margin: 0 0 var(--space-5);
    }
    .topic__section :global(h3) {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.1875rem;
      color: var(--color-resolution);
      margin-top: var(--space-7);
      margin-bottom: var(--space-4);
    }
    .topic__section :global(p) { margin: 0 0 var(--space-5); }
    .topic__section :global(ul),
    .topic__section :global(ol) {
      margin: 0 0 var(--space-5);
      padding-left: var(--space-6);
    }
    .topic__section :global(li) { margin-bottom: var(--space-2); }
    .topic__section :global(strong) { color: var(--color-resolution); }
    .topic__section :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 0 0 var(--space-6);
      font-size: 0.9375rem;
    }
    .topic__section :global(th),
    .topic__section :global(td) {
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--color-border);
      text-align: left;
    }
    .topic__section :global(th) {
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--color-resolution);
      background: var(--color-alice);
    }
    .topic__section :global(blockquote) {
      border-left: 3px solid var(--section-accent);
      background: var(--section-accent-soft);
      padding: var(--space-4) var(--space-5);
      border-radius: 0 8px 8px 0;
      margin: var(--space-6) 0;
      font-style: italic;
      color: var(--color-resolution);
    }
    .topic__cta {
      margin: var(--space-12) 0 var(--space-10);
    }
    .topic__cta-stage {
      position: relative;
      isolation: isolate;
      padding-top: 100px;
      max-width: 540px;
      margin: 0 auto;
    }
    .topic__cta-yeti {
      position: absolute;
      top: -30px;
      left: 50%;
      transform: translateX(-50%);
      width: 280px;
      height: auto;
      z-index: 1;
      pointer-events: none;
      filter: drop-shadow(0 12px 24px rgba(44, 69, 119, 0.25))
              drop-shadow(0 3px 6px rgba(44, 69, 119, 0.10));
    }
    .topic__cta-wrap { position: relative; z-index: 2; }
    .topic__cta-wrap :global(.zipcta--picker) {
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 24px 48px -12px rgba(44, 69, 119, 0.25),
        0 8px 20px -8px color-mix(in srgb, var(--section-accent) 35%, transparent);
      border: 1px solid color-mix(in srgb, var(--section-accent) 25%, transparent);
    }
    .topic__related {
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-10);
      margin-top: var(--space-10);
    }
    .topic__related-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--section-accent);
      margin: 0 0 var(--space-5);
    }
    .topic__related-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
    .topic__related-list a {
      display: block;
      padding: var(--space-4) var(--space-5);
      background: var(--color-alice);
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      transition: background 0.2s;
    }
    .topic__related-list a:hover {
      background: var(--section-accent-soft);
    }
    .topic__related-label {
      display: block;
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--color-resolution);
      font-size: 0.9375rem;
      margin-bottom: 2px;
    }
    .topic__related-desc {
      display: block;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      line-height: 1.4;
    }
    @media (max-width: 720px) {
      .topic__related-list { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
