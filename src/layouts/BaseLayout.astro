---
import "~/styles/tokens.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { detectVertical } from "~/data/verticals";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  /** Override section detection. Useful for utility pages that should adopt a specific vertical's accent. */
  sectionOverride?: import("~/data/verticals").VerticalKey | null;
}

const {
  title,
  description = "QuoteYeti helps you compare insurance — auto, home, life, business, health, renters, pet, and travel — without the sales pressure.",
  ogImage = "/assets/images/hero-peaks.svg",
  canonical = Astro.url.href,
  noindex = false,
  sectionOverride,
} = Astro.props;

const detectedVertical = detectVertical(Astro.url.pathname);
const sectionKey = sectionOverride !== undefined ? sectionOverride : detectedVertical?.key;
const sectionAttr = sectionKey ?? "default";

const siteName = "QuoteYeti";
const fullTitle = title.includes(siteName) ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/assets/images/footprint.svg" />

    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lqp1bjs.css" />

    <slot name="head" />
  </head>
  <body data-section={sectionAttr}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer section={sectionKey} />

    <style>
      .skip-link {
        position: absolute; top: -100px; left: 0;
        background: var(--color-resolution); color: var(--color-white);
        padding: var(--space-3) var(--space-5);
        z-index: 100; transition: top var(--transition);
      }
      .skip-link:focus { top: 0; color: var(--color-white); }
    </style>
  </body>
</html>
