---
import "~/styles/tokens.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Seo, { type BreadcrumbItem, type ArticleData, type ReviewData } from "~/components/Seo.astro";
import { detectVertical } from "~/data/verticals";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  pageType?: "website" | "article" | "review" | "default";
  breadcrumbs?: BreadcrumbItem[];
  article?: ArticleData;
  review?: ReviewData;
  sectionOverride?: import("~/data/verticals").VerticalKey | null;
}

const {
  title,
  description = "QuoteYeti helps you compare insurance — auto, home, life, business, health, renters, pet, and travel — without the sales pressure.",
  ogImage,
  ogImageAlt,
  canonical,
  noindex = false,
  pageType = "default",
  breadcrumbs,
  article,
  review,
  sectionOverride,
} = Astro.props;

const detectedVertical = detectVertical(Astro.url.pathname);
const sectionKey = sectionOverride !== undefined ? sectionOverride : detectedVertical?.key;
const sectionAttr = sectionKey ?? "default";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      noindex={noindex}
      pageType={pageType}
      breadcrumbs={breadcrumbs}
      article={article}
      review={review}
    />

    <link rel="icon" type="image/svg+xml" href="/assets/images/footprint.svg" />

    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lqp1bjs.css" />

    <slot name="head" />
  </head>
  <body data-section={sectionAttr}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer section={sectionKey} />

    <style>
      .skip-link {
        position: absolute; top: -100px; left: 0;
        background: var(--color-resolution); color: var(--color-white);
        padding: var(--space-3) var(--space-5);
        z-index: 100; transition: top var(--transition);
      }
      .skip-link:focus { top: 0; color: var(--color-white); }
    </style>
  </body>
</html>
