    /* ==================================================
       Responsive
    ================================================== */
    @media (max-width: 950px) {
      .review-page__layout { grid-template-columns: 1fr; }
      .review-sidebar {
        position: static;
        margin-bottom: var(--space-8);
      }
      .ratings-overview { grid-template-columns: 1fr; }
      .cost-summary, .cx-cards, .methodology__factors, .prosCons-grid { grid-template-columns: 1fr; }
      .review-hero__head { flex-direction: column; }
      .review-hero__h1 { font-size: 1.875rem; }
      .data-table { font-size: 0.875rem; }
      .data-table th, .data-table td { padding: var(--space-2) var(--space-3); }
      .editors-note p { font-size: 1.125rem; }
      .pull-quote p { font-size: 1.25rem; }
      .takeaways-list li { grid-template-columns: 44px 1fr; gap: var(--space-3); }
      .takeaways-list__num { font-size: 2rem; }
    }
    @media (max-width: 640px) {
      .review-hero { padding-block: var(--space-10) clamp(5rem, 18vw, 7rem); }
      .review-hero__h1 { font-size: 1.5rem; line-height: 1.15; }
      .review-content { font-size: 0.9375rem; }
      .review-content h2 { font-size: 1.625rem; }
      .key-takeaways { padding: var(--space-6); }
      .key-takeaways h2 { font-size: 1.5rem; }
      .data-table { font-size: 0.8125rem; }
