  </style>

  <script>
    /**
     * Sitemap interactivity:
     *
     * 1. SEARCH — typing in the search input filters every `<li data-search>`
     *    AND closes/opens parents (facet sections, brand families, top-level
     *    vertical details) so a search for "Honda" finds it inside the
     *    collapsed Auto > Brands > Honda hierarchy.
     *
     * 2. TABS — clicking a tab hides sections whose `data-tab-target` doesn't
     *    match the selected tab. "All sections" shows everything.
     *
     * 3. The two interactions compose: tab filters which sections render,
     *    then search filters within whatever remains visible.
     */
    (function () {
      const search = document.getElementById("sm-search-input") as HTMLInputElement | null;
      const clear = document.getElementById("sm-search-clear") as HTMLButtonElement | null;
      const countWrap = document.getElementById("sm-search-count") as HTMLElement | null;
      const countNum = document.getElementById("sm-search-num") as HTMLElement | null;
      const emptyState = document.getElementById("sm-empty-state") as HTMLElement | null;
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".sm2-tab"));
      const sections = Array.from(document.querySelectorAll<HTMLElement>(".sm2-section"));

      let activeTab = "all";
      let activeQuery = "";

      function matchTab(section: HTMLElement): boolean {
        if (activeTab === "all") return true;
        return section.dataset.tabTarget === activeTab;
      }

      function applyFilters() {
        let totalMatches = 0;
        let visibleSections = 0;

        for (const section of sections) {
          const passesTab = matchTab(section);
          if (!passesTab) {
            section.hidden = true;
            continue;
          }

          if (!activeQuery) {
            // No query — restore everything
            section.hidden = false;
            visibleSections++;
            section.querySelectorAll<HTMLElement>("li[hidden]").forEach((el) => { el.hidden = false; });
            // Close everything except auto (the first section)
            const isFirst = section === sections[0];
            (section as HTMLDetailsElement).open = isFirst;
            // Close nested family details
            section.querySelectorAll<HTMLDetailsElement>(".sm2-family details").forEach((d) => { d.open = false; });
            continue;
          }

          // With a query, search through all searchable items inside this section
          const searchables = Array.from(section.querySelectorAll<HTMLElement>("li[data-search]"));
          let sectionMatches = 0;

          for (const li of searchables) {
            const txt = li.dataset.search ?? "";
            const hit = txt.includes(activeQuery);
            li.hidden = !hit;
            if (hit) sectionMatches++;
          }

          // Also handle brand families: a family is visible if its name matches
          // OR any of its models matches. When a family matches, open it.
          for (const fam of Array.from(section.querySelectorAll<HTMLElement>(".sm2-family"))) {
            const famText = fam.dataset.search ?? "";
            const famNameOnly = fam.dataset.familyName ?? "";
            const famNameHit = famNameOnly.includes(activeQuery);
            const anyChild = Array.from(fam.querySelectorAll<HTMLElement>(".sm2-models li")).some(
              (li) => !li.hidden
            );
            const famHit = famText.includes(activeQuery) || famNameHit || anyChild;
            fam.hidden = !famHit;

            // If we're searching, expand the family so the matching models are visible
            const det = fam.querySelector<HTMLDetailsElement>("details");
            if (det) det.open = famHit;
            // If the family name itself matches, show ALL its models
            if (famNameHit && det) {
              fam.querySelectorAll<HTMLElement>(".sm2-models li").forEach((li) => { li.hidden = false; });
              sectionMatches += fam.querySelectorAll(".sm2-models li").length;
            }
          }

          // Show the section if it has any matches
          section.hidden = sectionMatches === 0;
          if (sectionMatches > 0) {
            (section as HTMLDetailsElement).open = true;
            visibleSections++;
            totalMatches += sectionMatches;
          }
        }

        // Update count & empty state
        if (activeQuery && countWrap && countNum) {
          countWrap.hidden = false;
          countNum.textContent = String(totalMatches);
        } else if (countWrap) {
          countWrap.hidden = true;
        }
        if (emptyState) emptyState.hidden = visibleSections > 0;
        if (clear) clear.hidden = !activeQuery;
      }

      // Wire search
      search?.addEventListener("input", () => {
        activeQuery = (search.value ?? "").trim().toLowerCase();
        applyFilters();
      });
      clear?.addEventListener("click", () => {
        if (!search) return;
        search.value = "";
        activeQuery = "";
        applyFilters();
        search.focus();
      });

      // Wire tabs
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          activeTab = tab.dataset.tab ?? "all";
          tabs.forEach((t) => t.classList.remove("is-active"));
          tab.classList.add("is-active");
          applyFilters();
        });
      });

      // Keyboard shortcut: ⌘K / Ctrl+K focuses search
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          search?.focus();
          search?.select();
        }
      });
    })();
  </script>
</BaseLayout>
