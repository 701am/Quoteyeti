      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .sm2-link-grid a:hover {
      background: var(--c-accent-soft);
      color: var(--c-accent, var(--color-malibu));
    }

    /* ============ A–Z LETTERS ============ */
    .sm2-letters {
