    }
    .sm2-link-grid li { margin: 0; }
    .sm2-link-grid li[hidden] { display: none; }
    .sm2-link-grid a {
      display: block;
      padding: 7px 10px;
      font-family: var(--font-display);
      font-size: 0.875rem;
      color: var(--sm2-link-color);
