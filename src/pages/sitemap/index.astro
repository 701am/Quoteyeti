---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { VERTICAL_LIST, type Vertical } from "~/data/verticals";

/**
 * Sitemap data layer.
 *
 * Pulls every non-draft entry from every collection, organizes them per
 * vertical into facets, generates compare-page slugs, and groups brands
 * into families. The template below renders this into a search-first,
 * tab-filtered structure.
 */

async function safeCollection(name: string) {
  try {
    return await getCollection(name as any, ({ data }: any) => !data.draft);
  } catch {
    return [];
  }
}

// Per-vertical content (reviews, guides, locations)
const reviews: Record<string, any[]> = {};
const guides: Record<string, any[]> = {};
const locations: Record<string, any[]> = {};

for (const v of VERTICAL_LIST) {
  reviews[v.key] = await safeCollection(`${v.key}-reviews`);
  // Non-auto verticals expose guides via the bare-key collection;
  // auto has dedicated /auto/guides/ items too — pulled separately.
  guides[v.key] = await safeCollection(v.key === "auto" ? "auto-guides" : v.key);
  if (["auto", "home", "life", "business"].includes(v.key)) {
    locations[v.key] = await safeCollection(`${v.key}-locations`);
  } else {
    locations[v.key] = [];
  }
}

// Auto-only collections
const autoBrands = await safeCollection("auto-brands");
const autoFaqs = await safeCollection("auto-faqs");
const autoGlossary = await safeCollection("auto-glossary");
const posts = (await safeCollection("posts")).sort((a, b) => {
  const aD = a.data.publishDate?.valueOf() ?? 0;
  const bD = b.data.publishDate?.valueOf() ?? 0;
  return bD - aD;
});

// ============ Brand family grouping ============
// Slug convention: brand parent = single token ("honda"), model = multi-token ("honda-crv").
// Use the `brand` frontmatter field when present; fall back to slug parsing.
function brandFamilyKey(b: any): string {
  if (b.data?.brand) return b.data.brand.toString().toLowerCase().split(" ")[0];
  return (b.id ?? "").split("-")[0];
}

interface BrandFamily {
  key: string;
  name: string;
  parent: any | null;
  models: any[];
}

const familyMap: Record<string, BrandFamily> = {};
for (const b of autoBrands) {
  const k = brandFamilyKey(b);
  if (!familyMap[k]) {
    familyMap[k] = {
      key: k,
      name: k.charAt(0).toUpperCase() + k.slice(1),
      parent: null,
      models: [],
    };
  }
  if (b.id === k) {
    familyMap[k].parent = b;
    if (b.data.brand) familyMap[k].name = b.data.brand;
  } else {
    familyMap[k].models.push(b);
  }
}

const brandFamilies: BrandFamily[] = Object.values(familyMap).sort((a, b) =>
  a.name.localeCompare(b.name)
);
for (const f of brandFamilies) {
  f.models.sort((a, b) => {
    const aT = (a.data.title ?? a.id).toString();
    const bT = (b.data.title ?? b.id).toString();
    return aT.localeCompare(bT);
  });
}

// Letter index for the brand quick-jump
const brandLetters = new Set<string>();
for (const f of brandFamilies) brandLetters.add(f.name.charAt(0).toUpperCase());
const allLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");

// Strip the "Car Insurance Rates" suffix from model titles for compact display
function modelLabel(t: string): string {
  return t
    .replace(/ Car Insurance Rates?$/i, "")
    .replace(/ Insurance Rates?$/i, "")
    .replace(/ Auto Insurance$/i, "")
    .replace(/ Insurance$/i, "");
}

// ============ Compare page generator ============
// Mirrors the logic in /[vertical]/compare/[slug].astro getStaticPaths so
// the sitemap lists exactly the URLs that exist.
function buildComparePaths(vReviews: any[]) {
  const sorted = [...vReviews].sort((a, b) => {
    const ra = a.data.overallRank ?? 99;
    const rb = b.data.overallRank ?? 99;
    if (ra !== rb) return ra - rb;
    return (b.data.overallScore ?? 0) - (a.data.overallScore ?? 0);
  });

  const out: { slug: string; label: string; count: number }[] = [];
  // All pairs
  for (let i = 0; i < sorted.length; i++) {
    for (let j = i + 1; j < sorted.length; j++) {
      const ids = [sorted[i].id, sorted[j].id].sort();
      const names = [sorted[i].data.company, sorted[j].data.company];
      out.push({ slug: ids.join("-vs-"), label: names.join(" vs "), count: 2 });
    }
  }
  // Top-3 triple
  if (sorted.length >= 3) {
    const t = sorted.slice(0, 3);
    const ids = [t[0].id, t[1].id, t[2].id].sort();
    const names = [t[0].data.company, t[1].data.company, t[2].data.company];
    out.push({ slug: ids.join("-vs-"), label: names.join(" vs "), count: 3 });
  }
  // Top-1 + top-2 + tail triples
  if (sorted.length >= 4) {
    const top = sorted[0], second = sorted[1];
    const tail = sorted.slice(2, Math.min(sorted.length, 6));
    for (const cc of tail) {
      if (cc.id === second.id) continue;
      const ids = [top.id, second.id, cc.id].sort();
      const label = [top.data.company, second.data.company, cc.data.company].join(" vs ");
      const slug = ids.join("-vs-");
      if (!out.some((x) => x.slug === slug)) {
        out.push({ slug, label, count: 3 });
      }
    }
  }
  return out;
}

// ============ Per-vertical assembled view-model ============
interface VerticalSection {
  v: Vertical;
  reviews: any[];
  comparisons: { slug: string; label: string; count: number }[];
  guides: any[];
  locations: any[];
  faqs: any[];           // auto only
  glossary: any[];       // auto only
  brandFamilies: BrandFamily[]; // auto only
  totalPages: number;
}

const sections: VerticalSection[] = VERTICAL_LIST.map((v) => {
  const r = reviews[v.key] ?? [];
  const cmp = r.length >= 2 ? buildComparePaths(r) : [];
  const g = guides[v.key] ?? [];
  const loc = locations[v.key] ?? [];
  const isAuto = v.key === "auto";

  // Count of pages surfaced under this vertical
  const planAndCompare = 2 + (["auto","home","life","business"].includes(v.key) ? 4 : 1); // overview, best, [cheapest, how-much, coverage, discounts], quotes
  const total =
    planAndCompare +
    r.length +
    cmp.length +
    g.length +
    loc.length +
    (isAuto ? autoFaqs.length + autoGlossary.length + autoBrands.length : 0);

  return {
    v,
    reviews: r,
    comparisons: cmp,
    guides: g,
    locations: loc,
    faqs: isAuto ? autoFaqs : [],
    glossary: isAuto ? autoGlossary : [],
    brandFamilies: isAuto ? brandFamilies : [],
    totalPages: total,
  };
});

// Totals strip
const grandTotal = sections.reduce((s, x) => s + x.totalPages, 0) + posts.length + 8; // +8 for cross-site pages

// Cross-vertical / company pages (not tied to a vertical)
const crossLinks: { label: string; href: string }[] = [
  { label: "Methodology", href: "/methodology/" },
  { label: "Editorial standards", href: "/editorial/" },
  { label: "About the team", href: "/about/team/" },
  { label: "Press", href: "/press/" },
  { label: "Contact", href: "/contact/" },
  { label: "Partner with us", href: "/partners/" },
  { label: "Newsletter", href: "/newsletter/" },
  { label: "Privacy policy", href: "/privacy-policy/" },
  { label: "Terms of use", href: "/terms/" },
  { label: "Accessibility", href: "/accessibility/" },
];

// Editorial / blog
const blog = {
  total: posts.length,
  recent: posts.slice(0, 10),
  all: posts,
};
---

<BaseLayout
  title="Sitemap — Every QuoteYeti page, organized"
  description={`Search and browse every page on QuoteYeti — ${grandTotal} pages across 8 insurance verticals, carrier reviews, brand & model rates, guides, comparisons, state pages, and resources.`}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Sitemap", url: "/sitemap/" },
  ]}
>
  <!-- ============== HERO + SEARCH ============== -->
  <section class="sm2-hero">
    <div class="container">
      <p class="sm2-hero__eyebrow">Sitemap</p>
      <h1 class="sm2-hero__h1">Every page on <span class="serif-italic">QuoteYeti</span>.</h1>
      <p class="sm2-hero__lede">
        {grandTotal.toLocaleString()} pages across 8 insurance verticals, carrier reviews, brand &amp; model rates, comparisons, guides, state pages, and editorial. Search to jump to anything.
      </p>

      <div class="sm2-search">
        <label for="sm-search-input" class="sm2-search__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
            <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </label>
        <input
          id="sm-search-input"
          type="text"
          placeholder="Search — try 'Honda', 'GEICO', 'California', 'collision', 'gap insurance'…"
          autocomplete="off"
        />
        <button type="button" class="sm2-search__clear" id="sm-search-clear" aria-label="Clear search" hidden>×</button>
      </div>
      <p class="sm2-search__count" id="sm-search-count" hidden>
        <strong id="sm-search-num">0</strong> matches
      </p>
    </div>
  </section>

  <!-- ============== TAB FILTERS ============== -->
  <section class="sm2-tabs-wrap">
    <div class="container">
      <div class="sm2-tabs" role="tablist" aria-label="Filter by section">
        <button class="sm2-tab is-active" data-tab="all" type="button">All sections <span class="sm2-tab__count">{grandTotal.toLocaleString()}</span></button>
        {sections.map((s) => (
          <button class="sm2-tab" data-tab={s.v.key} type="button">
            {s.v.short}
            <span class="sm2-tab__count">{s.totalPages.toLocaleString()}</span>
          </button>
        ))}
        <button class="sm2-tab" data-tab="editorial" type="button">Editorial <span class="sm2-tab__count">{blog.total}</span></button>
        <button class="sm2-tab" data-tab="company" type="button">Company <span class="sm2-tab__count">{crossLinks.length}</span></button>
      </div>
    </div>
  </section>

  <!-- ============== EMPTY STATE ============== -->
  <section class="container">
    <p class="sm2-empty" id="sm-empty-state" hidden>No matches for that search. Try a brand, carrier, or state.</p>
  </section>

  <!-- ============== VERTICAL SECTIONS ============== -->
  <section class="container sm2-sections">
    {sections.map((s, i) => {
      const isAuto = s.v.key === "auto";
      return (
        <details
          class="sm2-section"
          data-tab-target={s.v.key}
          data-search-text={`${s.v.short} ${s.v.label}`.toLowerCase()}
          open={i === 0}
        >
          <summary class="sm2-section__head" style={`--c-accent: ${s.v.accent}; --c-accent-soft: ${s.v.accentSoft};`}>
            <span class="sm2-section__badge">
              <img src={s.v.icon} alt="" width="20" height="20" />
            </span>
            <span class="sm2-section__title-wrap">
              <span class="sm2-section__title">{s.v.label}</span>
              <span class="sm2-section__meta">
                {s.totalPages.toLocaleString()} pages
                {s.reviews.length > 0 && <> · {s.reviews.length} {s.reviews.length === 1 ? "carrier" : "carriers"}</>}
                {s.comparisons.length > 0 && <> · {s.comparisons.length} {s.comparisons.length === 1 ? "comparison" : "comparisons"}</>}
                {isAuto && s.brandFamilies.length > 0 && <> · {autoBrands.length} brand &amp; model pages</>}
                {s.guides.length > 0 && <> · {s.guides.length} guides</>}
                {s.locations.length > 0 && <> · {s.locations.length} states</>}
                {isAuto && s.faqs.length > 0 && <> · {s.faqs.length} FAQs</>}
                {isAuto && s.glossary.length > 0 && <> · {s.glossary.length} glossary terms</>}
              </span>
            </span>
            <span class="sm2-section__chev" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>

          <div class="sm2-section__body">

            <!-- Plan & compare facet -->
            <div class="sm2-facet">
              <header class="sm2-facet__head">
                <h3 class="sm2-facet__title">Plan &amp; compare</h3>
              </header>
              <ul class="sm2-link-grid">
                <li><a href={s.v.path}>{s.v.short} insurance overview</a></li>
                <li><a href={`${s.v.path}best/`}>Best {s.v.short.toLowerCase()} insurance</a></li>
                {["auto", "home", "life", "business"].includes(s.v.key) && <>
                  <li><a href={`${s.v.path}cheapest/`}>Cheapest {s.v.short.toLowerCase()} insurance</a></li>
                  <li><a href={`${s.v.path}how-much-do-i-need/`}>How much do I need?</a></li>
                  <li><a href={`${s.v.path}coverage-types/`}>Coverage types</a></li>
                  <li><a href={`${s.v.path}discounts/`}>Discounts</a></li>
                </>}
                <li><a href={`${s.v.path}quotes/`}>See {s.v.short.toLowerCase()} rates</a></li>
              </ul>
            </div>

            <!-- Carrier reviews -->
            {s.reviews.length > 0 && (
              <div class="sm2-facet">
                <header class="sm2-facet__head">
                  <h3 class="sm2-facet__title">Carrier reviews <span class="sm2-facet__count">· {s.reviews.length}</span></h3>
                  <a href={`${s.v.path}reviews/`} class="sm2-facet__action">View carrier index →</a>
                </header>
                <ul class="sm2-link-grid" data-searchable>
                  {s.reviews.map((r: any) => (
                    <li data-search={`${r.data.company ?? r.data.title}`.toLowerCase()}>
                      <a href={`${s.v.path}reviews/${r.id}/`}>{r.data.company ?? r.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Brands & models — auto only — A-Z + collapsible families -->
            {isAuto && s.brandFamilies.length > 0 && (
              <div class="sm2-facet">
                <header class="sm2-facet__head">
                  <h3 class="sm2-facet__title">Brands &amp; models <span class="sm2-facet__count">· {autoBrands.length} pages, {s.brandFamilies.length} brands</span></h3>
                  <a href="/auto/brands/" class="sm2-facet__action">View brand index →</a>
                </header>

                <nav class="sm2-letters" aria-label="Jump to brand letter">
                  {allLetters.map((L) => (
                    brandLetters.has(L) ? (
                      <a href={`#brand-${L}`} class="sm2-letter">{L}</a>
                    ) : (
                      <span class="sm2-letter sm2-letter--off" aria-disabled="true">{L}</span>
                    )
                  ))}
                </nav>

                <ul class="sm2-families" data-searchable>
                  {s.brandFamilies.map((fam) => {
                    const letter = fam.name.charAt(0).toUpperCase();
                    const allText = `${fam.name} ${fam.models.map((m) => modelLabel(m.data.title ?? m.id)).join(" ")}`.toLowerCase();
                    return (
                      <li
                        class="sm2-family"
                        id={`brand-${letter}`}
                        data-search={allText}
                        data-family-name={fam.name.toLowerCase()}
                      >
                        <details>
                          <summary>
                            <span class="sm2-family__chev" aria-hidden="true">
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span>
                            {fam.parent ? (
                              <a href={`/auto/brands/${fam.parent.id}/`} class="sm2-family__name sm2-family__name--linked" onclick="event.stopPropagation()">{fam.name}</a>
                            ) : (
                              <span class="sm2-family__name">{fam.name}</span>
                            )}
                            <span class="sm2-family__count">{fam.models.length} {fam.models.length === 1 ? "model" : "models"}</span>
                          </summary>
                          {fam.models.length > 0 && (
                            <ul class="sm2-models">
                              {fam.models.map((m) => (
                                <li data-search={modelLabel(m.data.title ?? m.id).toLowerCase()}>
                                  <a href={`/auto/brands/${m.id}/`}>{modelLabel(m.data.title ?? m.id)}</a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </details>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            <!-- Comparisons -->
            {s.comparisons.length > 0 && (
              <div class="sm2-facet">
                <header class="sm2-facet__head">
                  <h3 class="sm2-facet__title">Compare carriers <span class="sm2-facet__count">· {s.comparisons.length}</span></h3>
                  <a href={`${s.v.path}compare/`} class="sm2-facet__action">Build your own →</a>
                </header>
                <ul class="sm2-link-grid" data-searchable>
                  {s.comparisons.map((c) => (
                    <li data-search={c.label.toLowerCase()}>
                      <a href={`${s.v.path}compare/${c.slug}/`}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Guides -->
            {s.guides.length > 0 && (
              <div class="sm2-facet">
                <header class="sm2-facet__head">
                  <h3 class="sm2-facet__title">Guides <span class="sm2-facet__count">· {s.guides.length}</span></h3>
                  <a href={`${s.v.path}guides/`} class="sm2-facet__action">View all guides →</a>
                </header>
                <ul class="sm2-link-grid" data-searchable>
                  {s.guides.map((g: any) => (
                    <li data-search={(g.data.title ?? "").toLowerCase()}>
                      <a href={`${s.v.path}guides/${g.id}/`}>{g.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- State pages -->
            {s.locations.length > 0 && (
              <div class="sm2-facet">
                <header class="sm2-facet__head">
                  <h3 class="sm2-facet__title">By state <span class="sm2-facet__count">· {s.locations.length}</span></h3>
                  <a href={`${s.v.path}by-state/`} class="sm2-facet__action">View state index →</a>
                </header>
                <ul class="sm2-link-grid" data-searchable>
                  {s.locations.map((l: any) => (
                    <li data-search={(l.data.state ?? l.data.title ?? "").toLowerCase()}>
                      <a href={`${s.v.path}by-state/${l.id}/`}>{l.data.state ?? l.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Auto FAQs -->
            {isAuto && s.faqs.length > 0 && (
              <div class="sm2-facet">
                <header class="sm2-facet__head">
                  <h3 class="sm2-facet__title">FAQs <span class="sm2-facet__count">· {s.faqs.length}</span></h3>
                  <a href="/auto/faqs/" class="sm2-facet__action">View all FAQs →</a>
                </header>
                <ul class="sm2-link-grid" data-searchable>
                  {s.faqs.map((f: any) => (
                    <li data-search={(f.data.question ?? f.data.title ?? "").toLowerCase()}>
                      <a href={`/auto/faqs/${f.id}/`}>{f.data.question ?? f.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Auto glossary -->
            {isAuto && s.glossary.length > 0 && (
              <div class="sm2-facet">
                <header class="sm2-facet__head">
                  <h3 class="sm2-facet__title">Glossary <span class="sm2-facet__count">· {s.glossary.length}</span></h3>
                  <a href="/auto/glossary/" class="sm2-facet__action">View glossary →</a>
                </header>
                <ul class="sm2-link-grid" data-searchable>
                  {s.glossary.map((g: any) => (
                    <li data-search={(g.data.term ?? g.data.title ?? "").toLowerCase()}>
                      <a href={`/auto/glossary/${g.id}/`}>{g.data.term ?? g.data.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

          </div>
        </details>
      );
    })}

    <!-- Editorial section -->
    <details class="sm2-section" data-tab-target="editorial" data-search-text="editorial dispatch blog">
      <summary class="sm2-section__head" style="--c-accent: #2C4577; --c-accent-soft: rgba(44, 69, 119, 0.08);">
        <span class="sm2-section__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M4 5h16v14H4z M4 9h16M9 13h7M9 17h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="sm2-section__title-wrap">
          <span class="sm2-section__title">Editorial</span>
          <span class="sm2-section__meta">{blog.total} Dispatch posts</span>
        </span>
        <span class="sm2-section__chev" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </summary>
      <div class="sm2-section__body">
        <div class="sm2-facet">
          <header class="sm2-facet__head">
            <h3 class="sm2-facet__title">The Dispatch <span class="sm2-facet__count">· {blog.total}</span></h3>
            <a href="/blog/" class="sm2-facet__action">View blog →</a>
          </header>
          <ul class="sm2-link-grid" data-searchable>
            {blog.all.map((p: any) => (
              <li data-search={(p.data.title ?? "").toLowerCase()}>
                <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </details>

    <!-- Company section -->
    <details class="sm2-section" data-tab-target="company" data-search-text="company about contact legal team">
      <summary class="sm2-section__head" style="--c-accent: #5F5E5A; --c-accent-soft: rgba(95, 94, 90, 0.08);">
        <span class="sm2-section__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M12 2l3 6 6 1-4 4 1 6-6-3-6 3 1-6-4-4 6-1 3-6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="sm2-section__title-wrap">
          <span class="sm2-section__title">QuoteYeti as a company</span>
          <span class="sm2-section__meta">Editorial standards · About · Contact · Legal</span>
        </span>
        <span class="sm2-section__chev" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </summary>
      <div class="sm2-section__body">
        <div class="sm2-facet">
          <ul class="sm2-link-grid" data-searchable>
            {crossLinks.map((link) => (
              <li data-search={link.label.toLowerCase()}>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
            <li data-search="rai antonio writer"><a href="/about/team/rai-antonio/">Rai Antonio — Senior Writer</a></li>
            <li data-search="david krug editor"><a href="/about/team/david-krug/">David Krug — Editor-in-Chief</a></li>
            <li data-search="felix lucero data"><a href="/about/team/felix-lucero/">Felix Lucero — Data Scientist</a></li>
          </ul>
        </div>
      </div>
    </details>
  </section>

  <style>
