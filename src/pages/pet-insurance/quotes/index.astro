---
import FunnelLayout from "~/layouts/FunnelLayout.astro";
import LeadFlow from "~/components/lead-flow/LeadFlow.astro";
import { FLOWS } from "~/lib/lead-flow/vertical-flows";

const flow = FLOWS.pet;
---

<FunnelLayout
  title="Get Pet Insurance Quotes — Compare Offers"
  description="Compare pet insurance offers from our partner network. Free, fast, and you choose who contacts you."
  noindex={true}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Pet", url: "/pet-insurance/" },
    { name: "Get quotes", url: "/pet-insurance/quotes/" },
  ]}
>
  <LeadFlow config={flow} />
</FunnelLayout>
