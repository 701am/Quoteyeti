---
import BestOfHub from "~/layouts/BestOfHub.astro";
import { VERTICALS } from "~/data/verticals";
const v = VERTICALS.pet;
---

<BestOfHub
  vertical={v}
  hero={{
    headline: "Best Pet Insurance Companies of 2026",
    lede: "Compare the top pet insurance providers on coverage, claims experience, breed-specific exclusions, and reimbursement structure.",
  }}
  intro={`<p>Pet insurance carriers differ more than they appear at first glance. Reimbursement structures, pre-existing condition treatment, lifetime caps, and waiting periods all vary significantly — and matter most at claim time.</p><p>We weighted three factors: cost (35%), coverage terms (35%), and customer experience (30%). Cost was scored across multiple breed and age tiers for dogs and cats.</p><p>Skip to the carrier that fits your pet, or read all six summaries below.</p>`}
  keyTakeaways={[
    "Healthy Paws leads on claim payout speed; Trupanion on lifetime coverage.",
    "Enroll while your pet is young — pre-existing conditions are never covered.",
    "Most policies cap reimbursement at 80–90% after the deductible.",
  ]}
  carriers={[
    { rank: 1, name: "Healthy Paws", score: 4.65, bestFor: "Lifetime conditions", monthlyRate: "$48/mo", satisfactionScore: 738, complaintRating: 0.48, financialStrength: "A", description: "Healthy Paws is one of the only carriers with no annual or lifetime payout caps, which matters most for chronic conditions.", pros: ["No annual or lifetime payout caps", "Fast claim processing", "Includes hereditary conditions"], cons: ["No wellness coverage option", "Higher rates for older pets"] },
    { rank: 2, name: "Lemonade Pet", score: 4.42, bestFor: "Fast claims", monthlyRate: "$32/mo", description: "Lemonade's app-based pet insurance pays straightforward claims in minutes and offers a clean experience for first-time buyers.", pros: ["Fastest claims processing", "Lowest rates for many profiles", "Bundle with renters/home for savings"], cons: ["Annual caps may be too low for some pets", "Wellness add-ons cost extra"] },
    { rank: 3, name: "Embrace", score: 4.38, bestFor: "Wellness add-ons", monthlyRate: "$44/mo", satisfactionScore: 695, complaintRating: 0.55, financialStrength: "A", description: "Embrace's optional Wellness Rewards add-on reimburses routine care like checkups, vaccines, and dental cleanings.", pros: ["Strong wellness package option", "Diminishing deductible feature", "Covers exam fees"], cons: ["Slightly higher premiums than Lemonade", "Some breed-specific exclusions"] },
    { rank: 4, name: "Trupanion", score: 4.25, bestFor: "Direct vet payment", monthlyRate: "$58/mo", satisfactionScore: 712, complaintRating: 0.62, financialStrength: "A-", description: "Trupanion is the rare carrier that can pay the vet directly at checkout, so you don't have to front the cost and wait for reimbursement.", pros: ["Direct vet payment at checkout (Trupanion Express)", "No payout limits", "Covers prosthetics and implants"], cons: ["Among the more expensive options", "30-day waiting period for illness"] },
    { rank: 5, name: "Spot", score: 4.12, bestFor: "Customizable limits", monthlyRate: "$36/mo", description: "Spot lets you build your policy with deductibles from $100 to $1,000 and reimbursement levels from 70% to 90%.", pros: ["Highly customizable policy", "Microchip and behavioral therapy covered", "Multi-pet discount"], cons: ["Newer brand", "Wait periods on certain conditions"] },
    { rank: 6, name: "Fetch (Pet Insurance)", score: 4.05, bestFor: "Comprehensive coverage", monthlyRate: "$42/mo", description: "Fetch (formerly Petplan) includes behavioral therapy, holistic care, and exam fees in its base policy at competitive rates.", pros: ["Includes behavioral therapy and holistic care", "Covers exam fees by default", "No upper age limit"], cons: ["6-month waiting period for orthopedic conditions", "Slower claim turnaround"] },
  ]}
  methodologyPoints={[
    "Cost (35%): premium quotes pulled across multiple breed and age tiers for dogs and cats, normalized to comparable coverage limits and deductible structure",
    "Coverage terms (35%): hereditary, behavioral, dental, exam fees, prescription coverage, alternative therapies",
    "Customer experience (30%): average claim turnaround, satisfaction surveys, denial rates, reimbursement timing",
    "Baseline: 3-year-old medium-breed mixed dog, $5K annual limit, $250 deductible, 80% reimbursement.",
  ]}
  methodologyWeights={[
    { weight: 35, label: "Cost", body: "Premium quotes pulled across multiple breed and age tiers for dogs and cats, normalized to comparable coverage limits and deductible structure." },
    { weight: 35, label: "Coverage terms", body: "Hereditary, behavioral, dental, exam fees, prescription coverage, alternative therapies." },
    { weight: 30, label: "Customer experience", body: "Average claim turnaround, satisfaction surveys, denial rates, reimbursement timing." },
  ]}
  faqs={[
    { q: "Is pet insurance worth it?", a: "Yes for most pets, especially purebreds with known hereditary conditions. Math heavily favors enrollment before any health issues develop." },
    { q: "What's not covered?", a: "Pre-existing conditions are excluded by every carrier. Routine care (vaccines, dental cleanings) require a wellness add-on." },
    { q: "Should I get accident-only or comprehensive?", a: "Accident-only is much cheaper but limited. Most owners are better served by accident + illness, with wellness optional." },
  ]}
/>
