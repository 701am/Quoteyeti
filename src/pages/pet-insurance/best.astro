    { rank: 5, name: "Spot", score: 4.12, bestFor: "Customizable limits", monthlyRate: "$36/mo", description: "Excepteur sint occaecat — Spot lets you build your policy with deductibles from $100 to $1,000 and reimbursement levels from 70% to 90%.", pros: ["Highly customizable policy", "Microchip and behavioral therapy covered", "Multi-pet discount"], cons: ["Newer brand", "Wait periods on certain conditions"] },
    { rank: 6, name: "Fetch (Pet Insurance)", score: 4.05, bestFor: "Comprehensive coverage", monthlyRate: "$42/mo", description: "Lorem ipsum — Fetch (formerly Petplan) includes behavioral therapy, holistic care, and exam fees in its base policy at competitive rates.", pros: ["Includes behavioral therapy and holistic care", "Covers exam fees by default", "No upper age limit"], cons: ["6-month waiting period for orthopedic conditions", "Slower claim turnaround"] },
  ]}
  methodologyPoints={[
    "Coverage breadth (40%): hereditary, behavioral, dental, exam fees, prescription coverage, alternative therapies",
    "Claims experience (35%): average claim turnaround, satisfaction surveys, denial rates",
    "Value (25%): premium relative to coverage limits and deductible structure",
    "Baseline: 3-year-old medium-breed mixed dog, $5K annual limit, $250 deductible, 80% reimbursement",
  ]}
  faqs={[
    { q: "Is pet insurance worth it?", a: "Lorem ipsum dolor sit amet — yes for most pets, especially purebreds with known hereditary conditions. Math heavily favors enrollment before any health issues develop." },
