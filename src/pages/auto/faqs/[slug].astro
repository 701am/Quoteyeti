---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const faqs = await getCollection("auto-faqs", ({ data }) => !data.draft);
  return faqs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={d.seoTitle ?? d.question ?? d.title} description={d.seoDescription ?? d.description}>
  <article>
    <header class="entry-hero">
      <div class="container-narrow">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> › <a href="/auto/">Auto</a> › <a href="/auto/faqs/">FAQs</a> › <span>{d.title}</span>
        </nav>
        <p class="eyebrow">FAQ</p>
        <h1>{d.question ?? d.title}</h1>
      </div>
    </header>
    <div class="container-narrow entry-body"><Content /></div>
  </article>
  <style>
    .entry-hero { padding-block: var(--space-12) var(--space-10); background: var(--section-accent-soft); }
    .breadcrumbs { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: var(--space-5); }
    .breadcrumbs a { color: var(--color-text-muted); }
    .breadcrumbs a:hover { color: var(--section-accent); }
    .entry-body { padding-block: var(--space-10) var(--space-20); font-size: 1.0625rem; line-height: 1.7; }
    .entry-body :global(p) { margin-bottom: var(--space-5); }
    .entry-body :global(ul), .entry-body :global(ol) { margin-bottom: var(--space-5); padding-left: var(--space-6); }
  </style>
</BaseLayout>
