---
import VerticalHub from "~/layouts/VerticalHub.astro";
import { VERTICALS } from "~/data/verticals";

const v = VERTICALS.auto;
---

<VerticalHub
  vertical={v}
  hero={{
    headline: "Your coverage, simplified.",
    lede: "Compare car insurance rates from the carriers actually competing for your business — no spam calls, no inflated premiums.",
    ctaLabel: "Get auto quotes",
    ctaHref: "/auto/quotes/",
  }}
  pillars={[
    {
      title: "Compare 70+ carriers",
      body: "Compare quotes from 70+ carriers in one place — the same panel of insurers your local agent shops, without the followup calls.",
      href: "/auto/compare/",
      cta: "Compare carriers",
    },
    {
      title: "Reviews you can trust",
      body: "Independent provider reviews — pros, cons, ratings, and real customer experience data.",
      href: "/auto/reviews/",
      cta: "Read reviews",
    },
    {
      title: "Brand-specific rates",
      body: "Average insurance cost for every make and model, from Acura to Volvo.",
      href: "/auto/brands/",
      cta: "Browse brands",
    },
  ]}
  calculators={[
    { label: "Auto insurance calculator", href: "/auto/calculator/" },
    { label: "How much coverage do I need?", href: "/auto/how-much-do-i-need/" },
    { label: "Discount finder", href: "/auto/discounts/" },
  ]}
  subtopics={[
    { title: "Cheapest full coverage", href: "/auto/cheapest-full-coverage/", desc: "Lowest premiums for full coverage policies, ranked by state." },
    { title: "Best for young drivers", href: "/auto/best-for-young-drivers/", desc: "Carriers that don't punish you for being under 25." },
    { title: "SR-22 insurance", href: "/auto/sr-22/", desc: "What it is, who needs it, and how to file." },
    { title: "Bundling auto + home", href: "/auto/bundling/", desc: "How much you really save by combining policies." },
    { title: "Telematics programs", href: "/auto/telematics/", desc: "Drive-tracking discounts compared across carriers." },
    { title: "After an accident", href: "/auto/after-accident/", desc: "Filing claims, dealing with adjusters, and what to expect." },
  ]}
  faqs={[
    { q: "How much car insurance do I need?", a: "Most states require minimum liability coverage by law, but state minimums are typically inadequate. For most drivers, 100/300/100 liability is the modern baseline, plus collision and comprehensive if your vehicle is worth more than ~$3,000 or is financed." },
    { q: "What is full coverage?", a: "Full coverage is an informal term for a policy that combines liability, collision, and comprehensive. Liability pays for damage to others; collision pays for your vehicle in a crash; comprehensive covers non-crash events like theft and weather." },
    { q: "Can I switch carriers mid-policy?", a: "Yes. Check for cancellation fees on your existing policy and overlap your new policy's start date with the old policy's end date so you never have a coverage gap." },
    { q: "Does credit score affect my rate?", a: "In most states, yes — carriers use credit-based insurance scores to predict claim likelihood. California, Hawaii, and Massachusetts prohibit it; Michigan, Maryland, and Washington restrict it." },
  ]}
/>
