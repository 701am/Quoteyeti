  hero={{
    headline: "Your coverage, simplified.",
    lede: "Compare car insurance rates from the carriers actually competing for your business — no spam calls, no inflated premiums.",
    ctaLabel: "Get auto quotes",
    ctaHref: "/auto/quotes/",
  }}
  pillars={[
    {
      title: "Compare 70+ carriers",
      body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.",
      href: "/auto/compare/",
      cta: "Compare carriers",
    },
    {
      title: "Reviews you can trust",
      body: "Independent provider reviews — pros, cons, ratings, and real customer experience data.",
      href: "/auto/reviews/",
      cta: "Read reviews",
    },
    {
      title: "Brand-specific rates",
      body: "Average insurance cost for every make and model, from Acura to Volvo.",
      href: "/auto/brands/",
      cta: "Browse brands",
    },
  ]}
  calculators={[
    { label: "Auto insurance calculator", href: "/auto/calculator/" },
    { label: "How much coverage do I need?", href: "/auto/how-much-do-i-need/" },
