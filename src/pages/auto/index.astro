    { title: "Telematics programs", href: "/auto/telematics/", desc: "Drive-tracking discounts compared across carriers." },
    { title: "After an accident", href: "/auto/after-accident/", desc: "Filing claims, dealing with adjusters, and what to expect." },
  ]}
  faqs={[
    { q: "How much car insurance do I need?", a: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Most states require at minimum liability coverage." },
    { q: "What is full coverage?", a: "Sed do eiusmod tempor incididunt ut labore — full coverage typically includes liability + collision + comprehensive." },
    { q: "Can I switch carriers mid-policy?", a: "Ut enim ad minim veniam — yes, but check for cancellation fees and overlap your start dates." },
