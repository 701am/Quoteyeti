---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentByline from "~/components/ContentByline.astro";
import CompareRail from "~/components/CompareRail.astro";
import { getCollection, render } from "astro:content";
import { VERTICALS } from "~/data/verticals";

export async function getStaticPaths() {
  const brands = await getCollection("auto-brands", ({ data }) => !data.draft);
  return brands.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const v = VERTICALS.auto;
const d = entry.data;

const effectiveUpdated = d.updatedDate ?? d.publishDate ?? new Date();
const effectivePublished = d.publishDate ?? effectiveUpdated;
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.description}
  ogImage={d.ogImage ?? d.heroImage}
  pageType="article"
  noindex={d.noindex}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Auto", url: "/auto/" },
    { name: "Brands", url: "/auto/brands/" },
    { name: d.brand ?? d.title, url: `/auto/brands/${entry.id}/` },
  ]}
  article={{
    publishDate: new Date(effectivePublished).toISOString(),
    modifiedDate: new Date(effectiveUpdated).toISOString(),
    authorName: d.author,
    tags: ["Auto", d.brand ?? "Brand"],
  }}
>

  <article class="entry-article">
    <header class="entry-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> ›
          <a href="/auto/">Auto</a> ›
          <a href="/auto/brands/">Brands</a> ›
          <span>{d.brand ?? d.title}</span>
        </nav>
        <p class="eyebrow">Auto Insurance · Brand Guide</p>
        <ContentByline
          variant="inline"
          author={d.author}
          publishDate={effectivePublished}
          updatedDate={effectiveUpdated}
          showData={true}
          compareVertical="auto"
        />
        <h1>{d.title}</h1>
        {d.description && <p class="entry-hero__lede">{d.description}</p>}
      </div>
    </header>

    <div class="container entry-body-wrap">
      <div class="entry-body"><Content /></div>
      <div class="entry-rail">
        <CompareRail
          vertical="auto"
          eyebrow={`${d.brand ?? "Vehicle"} rates`}
          heading={`Compare ${d.brand ?? "vehicle"} insurance from top carriers.`}
        />
      </div>
    </div>
  </article>

  <style>
    .entry-hero {
      padding-block: var(--space-12) var(--space-10);
      background: var(--section-accent-soft);
    }
    .breadcrumbs {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-bottom: var(--space-5);
    }
    .breadcrumbs a { color: var(--color-text-muted); }
    .breadcrumbs a:hover { color: var(--section-accent); }
    .entry-hero__lede { font-size: 1.25rem; color: var(--color-text-strong); margin-top: var(--space-4); }
    .entry-body-wrap {
      padding-block: var(--space-10) var(--space-20);
      display: grid;
      grid-template-columns: minmax(0, 720px) 280px;
      gap: var(--space-12);
      align-items: start;
      justify-content: center;
    }
    .entry-rail {
      position: sticky;
      top: calc(var(--header-height, 72px) + var(--space-4));
    }
    @media (max-width: 1100px) {
      .entry-body-wrap { grid-template-columns: minmax(0, 720px) 260px; gap: var(--space-8); }
    }
    @media (max-width: 960px) {
      .entry-body-wrap { grid-template-columns: 1fr; gap: var(--space-6); justify-content: stretch; }
      .entry-body { max-width: 780px; margin-inline: auto; }
      .entry-rail { position: static; max-width: 780px; margin-inline: auto; }
      .entry-rail :global(.compare-rail) { max-width: none; }
    }
    .entry-body { font-size: 1.0625rem; line-height: 1.7; }
    .entry-body :global(h2) { margin-top: var(--space-12); margin-bottom: var(--space-5); }
    .entry-body :global(h3) { margin-top: var(--space-8); margin-bottom: var(--space-4); }
    .entry-body :global(p) { margin-bottom: var(--space-5); }
    .entry-body :global(ul), .entry-body :global(ol) { margin-bottom: var(--space-5); padding-left: var(--space-6); }
    .entry-body :global(li) { margin-bottom: var(--space-2); }
    .entry-body :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  </style>
</BaseLayout>
