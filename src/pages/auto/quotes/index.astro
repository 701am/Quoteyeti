---
import FunnelLayout from "~/layouts/FunnelLayout.astro";
import LeadFlow from "~/components/lead-flow/LeadFlow.astro";
import { FLOWS } from "~/lib/lead-flow/vertical-flows";

const flow = FLOWS.auto;
---

<FunnelLayout
  title="Get Auto Insurance Quotes — Compare Offers"
  description="Compare auto insurance offers from our partner network. Free, fast, and you choose who contacts you."
  noindex={true}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Auto", url: "/auto/" },
    { name: "See rates", url: "/auto/quotes/" },
  ]}
>
  <LeadFlow config={flow} />
</FunnelLayout>
