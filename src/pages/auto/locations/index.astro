---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const locations = await getCollection("auto-locations", ({ data }) => !data.draft);
locations.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Auto Insurance by State and City - QuoteYeti"
  description="Average auto insurance rates and minimum coverage requirements for every state and major city."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Auto Insurance</p>
      <h1>Insurance rates by <span class="highlight underline-accent">location</span></h1>
      <p class="page-hero__lede">Rates and minimum coverage requirements by state and city.</p>
    </div>
  </section>

  <section class="container index-list">
    {locations.length === 0 ? (
      <p class="index-list__empty">No locations published yet.</p>
    ) : (
      <ul class="index-list__grid">
        {locations.map((entry) => (
          <li>
            <a href={`/auto/locations/${entry.id}/`} class="index-card">
              <h2 class="index-card__title">{entry.data.title}</h2>
              {entry.data.description && <p class="index-card__desc">{entry.data.description}</p>}
              <span class="index-card__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <style>
    .page-hero { padding-block: var(--space-16) var(--space-10); background: var(--section-accent-soft); }
    .page-hero__lede { font-size: 1.25rem; color: var(--color-text-strong); max-width: 640px; }
    .index-list { padding-block: var(--space-16); }
    .index-list__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
    .index-list__empty { font-size: 1.125rem; color: var(--color-text-muted); text-align: center; padding-block: var(--space-12); }
    .index-card {
      display: block; padding: var(--space-5);
      background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius);
      position: relative; transition: all var(--transition);
    }
    .index-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--section-accent); }
    .index-card__title { font-size: 1.0625rem; margin-bottom: var(--space-2); }
    .index-card__desc { font-size: 0.875rem; color: var(--color-text); margin: 0; }
    .index-card__arrow { position: absolute; right: var(--space-5); top: var(--space-5); color: var(--section-accent); }
    @media (max-width: 950px) { .index-list__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .index-list__grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
