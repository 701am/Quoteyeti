---
import { getCollection, render } from "astro:content";
import ReviewLayout from "~/layouts/ReviewLayout.astro";
import { VERTICALS } from "~/data/verticals";

export async function getStaticPaths() {
  const reviews = await getCollection("auto-reviews", ({ data }) => !data.draft);
  return reviews.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const v = VERTICALS.auto;
---

<ReviewLayout
  vertical={v}
  carrier={{
    name: d.company,
    logo: d.companyLogo,
    founded: d.foundedYear,
    headline: d.positioning,
    updated: d.updatedDate ? d.updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) : "",
    author: d.author ? { name: d.author, bio: d.authorBio ?? "" } : undefined,
    editor: d.editor ? { name: d.editor } : undefined,
    website: d.websiteUrl,
    phone: d.phoneNumber,
    headquarters: d.address,
    entityType: d.entityType,
    aggregatorBannerLede: d.aggregatorBannerLede,
    aggregatorBannerExplain: d.aggregatorBannerExplain,
    referenceNotes: d.referenceNotes,
    quickFacts: d.quickFacts,
  }}
  takeaways={d.takeaways}
  ratings={{
    overall: d.overallScore,
    rank: d.overallRank,
    breakdown: d.ratings,
  }}
  cost={{
    summary: d.costSummary ?? "",
    avgMonthly: d.avgMonthly,
    avgAnnual: d.avgAnnual,
    differenceFromAvg: d.differenceFromAvg,
    byCategory: d.costByCategory,
  }}
  customerExperience={{
    summary: d.cxSummary ?? "",
    buying: d.cxBuying ?? "",
    policyManagement: d.cxPolicyManagement ?? "",
    claims: d.cxClaims ?? "",
  }}
  industryRatings={d.industryRatings ?? []}
  discounts={d.discounts}
  coverage={{
    summary: d.coverageSummary ?? "",
    addOns: d.coverageAddOns ?? [],
  }}
  pros={d.pros}
  cons={d.cons}
  bottomLine={d.bottomLine ?? ""}
  faqs={d.faqs ?? []}
  methodology={{
    intro: d.methodologyIntro ?? "",
    factors: d.methodologyFactors ?? [],
  }}
>
  <Content slot="body" />
</ReviewLayout>
