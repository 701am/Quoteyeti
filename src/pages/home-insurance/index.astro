---
import VerticalHub from "~/layouts/VerticalHub.astro";
import { VERTICALS } from "~/data/verticals";

const v = VERTICALS.home;
---

<VerticalHub
  vertical={v}
  hero={{
    headline: "Protect what matters",
    lede: "Compare home insurance rates from the carriers that actually cover your area — including the ones the big aggregators skip.",
  }}
  pillars={[
    {
      title: "Best home insurers",
      body: "Independent rankings based on rates, claims experience, and coverage breadth — not on which carrier paid us the most.",
      href: "/home-insurance/best/",
      cta: "See the rankings",
    },
    {
      title: "Cheapest by state",
      body: "Rates vary wildly by state and ZIP. See who's cheapest where you live.",
      href: "/home-insurance/cheapest/",
      cta: "Find cheap rates",
    },
    {
      title: "How much coverage?",
      body: "Dwelling, contents, liability — figure out the right limits before you quote.",
      href: "/home-insurance/how-much-do-i-need/",
      cta: "Calculate coverage",
    },
  ]}
  calculators={[
    { label: "Home insurance calculator", href: "/home-insurance/calculator/" },
    { label: "Dwelling coverage estimator", href: "/home-insurance/coverage-estimator/" },
    { label: "Replacement cost tool", href: "/home-insurance/replacement-cost/" },
  ]}
  subtopics={[
    { title: "Condo (HO-6) insurance", href: "/home-insurance/condo/", desc: "What HO-6 covers and how it differs from a homeowner's policy." },
    { title: "Manufactured home", href: "/home-insurance/manufactured/", desc: "Specialized coverage for mobile and manufactured homes." },
    { title: "Flood insurance", href: "/home-insurance/flood/", desc: "Why most home policies don't cover flooding — and what does." },
    { title: "Landlord insurance", href: "/home-insurance/landlord/", desc: "Dwelling, liability, and lost-rent coverage for rental properties." },
    { title: "Filing a claim", href: "/home-insurance/claims/", desc: "Step-by-step from damage to payout, and how to avoid claim denials." },
    { title: "Bundling with auto", href: "/home-insurance/bundling/", desc: "Real savings ranges when you combine home + auto." },
  ]}
  faqs={[
    { q: "What does home insurance actually cover?", a: "Standard policies cover four things: dwelling (rebuilding your home), personal property (your stuff), liability (lawsuits if someone is hurt at your home), and loss of use (temporary housing while your home is being repaired)." },
    { q: "How much home insurance do I need?", a: "Your dwelling coverage should equal the current replacement cost of your home — not its market value, not your mortgage balance. Replacement cost has risen significantly in recent years; get a current estimate." },
    { q: "Is flood damage covered?", a: "No. Flood is excluded from every standard homeowners policy. You need a separate NFIP policy or private flood insurance. If you're in any flood-prone area, get one." },
    { q: "Does my mortgage require home insurance?", a: "Yes. Every lender requires homeowners insurance for the duration of the loan. Most will set up an escrow account that pays the premium from your monthly mortgage payment." },
  ]}
/>
