---
import BestOfHub from "~/layouts/BestOfHub.astro";
import { VERTICALS } from "~/data/verticals";
const v = VERTICALS.home;
---

<BestOfHub
  vertical={v}
  hero={{
    headline: "Best Home Insurance Companies of 2026",
    lede: "We ranked the top home insurers on rates, claims experience, financial stability, and coverage options. Find the right fit for your property.",
  }}
  intro={`<p>The best home insurance company depends on your situation — your home's age, your location's risk profile, your claim history, and how much you value digital tools versus a local agent. There's no universal winner.</p><p>We weighted three factors: cost (50%), customer satisfaction (35%), and coverage breadth (15%). Each carrier was scored using a baseline $300,000 dwelling in a moderate-risk market. Data sources include public regulatory rate filings, J.D. Power home insurance satisfaction studies, NAIC complaint data, and carrier policy documents.</p><p>Skip to the carrier that fits your situation, or read all six summaries below.</p>`}
  keyTakeaways={[
    "Amica leads on customer satisfaction; USAA on price for military families.",
    "State Farm is the strongest default if you want a local agent.",
    "Nationwide's bundling discount is the most aggressive in the category.",
  ]}
  carriers={[
    { rank: 1, name: "Amica", score: 4.78, bestFor: "Customer satisfaction", monthlyRate: "$112/mo", satisfactionScore: 749, complaintRating: 0.42, financialStrength: "A+", description: "Amica consistently tops J.D. Power's customer satisfaction rankings, with strong claims handling and dividend payments to policyholders.", pros: ["Highest customer satisfaction in the category", "Policyholder dividends in eligible states", "Strong claims-paying reputation"], cons: ["Not available in every state", "Premiums slightly above average"] },
    { rank: 2, name: "State Farm", score: 4.42, bestFor: "Local agent service", monthlyRate: "$118/mo", satisfactionScore: 711, complaintRating: 0.74, financialStrength: "A++", description: "State Farm's agent network and broad availability make it the default choice for homeowners who want a relationship, not an app.", pros: ["Largest agent network in the country", "Strong financial stability (AM Best A++)", "Bundling discounts with auto"], cons: ["Less competitive online experience", "Variable claims experience by region"] },
    { rank: 3, name: "USAA", score: 4.85, bestFor: "Military families", monthlyRate: "$94/mo", satisfactionScore: 776, complaintRating: 0.55, financialStrength: "A++", description: "USAA dominates this category for military families with industry-leading rates and replacement-cost coverage included as standard.", pros: ["Cheapest rates for qualified members", "Replacement cost included by default", "Top-tier claims satisfaction"], cons: ["Membership limited to military and families", "Smaller agent footprint"] },
    { rank: 4, name: "Allstate", score: 4.05, bestFor: "Customizable coverage", monthlyRate: "$129/mo", satisfactionScore: 642, complaintRating: 1.05, financialStrength: "A+", description: "Allstate offers the broadest list of optional add-ons, from yard and garden coverage to identity theft protection.", pros: ["Most customizable policy in the category", "Strong agent and digital hybrid", "Claim Satisfaction Guarantee in select states"], cons: ["Higher base premiums", "Mixed reviews on rate hikes after claims"] },
    { rank: 5, name: "Liberty Mutual", score: 3.92, bestFor: "First-time homeowners", monthlyRate: "$124/mo", satisfactionScore: 605, complaintRating: 1.18, financialStrength: "A", description: "Liberty Mutual's discount structure and online quote process work especially well for first-time buyers building a new policy from scratch.", pros: ["Wide range of optional discounts", "Strong online quoting experience", "Inflation protection rider available"], cons: ["Mixed claims satisfaction scores", "Premium creep on renewal"] },
    { rank: 6, name: "Nationwide", score: 3.88, bestFor: "Bundling auto + home", monthlyRate: "$122/mo", satisfactionScore: 660, complaintRating: 0.88, financialStrength: "A+", description: "Nationwide's bundling discounts are among the most aggressive in the market, especially when combined with auto and umbrella.", pros: ["Significant multi-policy savings", "Brand New Belongings replacement coverage", "Better Roof Replacement discount"], cons: ["Not available in every state", "Mid-pack customer experience"] },
  ]}
  methodologyPoints={[
    "Cost (50%): rates pulled for a $400K single-family home with $250K dwelling coverage across multiple ZIPs",
    "Claims satisfaction (35%): combined J.D. Power scores, NAIC complaint ratios, and consumer review aggregates",
    "Coverage breadth (15%): base policy features plus availability of riders and endorsements",
    "Baseline: $250,000 dwelling, $125,000 personal property, $300,000 liability, $1,000 deductible",
  ]}
  methodologyWeights={[
    { weight: 50, label: "Cost", body: "Rates pulled for a $400K single-family home with $250K dwelling coverage across multiple ZIPs." },
    { weight: 35, label: "Claims satisfaction", body: "Combined J.D. Power scores, NAIC complaint ratios, and consumer review aggregates." },
    { weight: 15, label: "Coverage breadth", body: "Base policy features plus availability of riders and endorsements." },
  ]}
  faqs={[
    { q: "How much home insurance do I need?", a: "At minimum, enough dwelling coverage to rebuild your home at current construction costs (not market value)." },
    { q: "Is flood damage covered?", a: "No, standard policies exclude flooding. You need a separate NFIP or private flood policy." },
    { q: "Should I bundle with auto?", a: "Usually yes; bundle discounts typically range 10-25% but always price standalone first to be sure." },
    { q: "What's the difference between replacement cost and actual cash value?", a: "Replacement cost pays to rebuild or replace items at today's prices. Actual cash value (ACV) subtracts depreciation — a 10-year-old roof might pay out 30% of its replacement cost. Pay for replacement cost on dwelling coverage and personal property if you can afford the small premium difference." },
    { q: "How does my deductible affect my premium?", a: "Roughly: doubling your deductible (from $1,000 to $2,000) cuts premiums 10-15%. Tripling it cuts another 5-8%. Pick the highest deductible you could comfortably pay out of pocket — claims under it just disappear into your budget anyway." },
    { q: "Does my home insurance cover earthquakes or hurricanes?", a: "Earthquakes: no, every standard policy excludes them — separate policy required. Hurricanes: damage from wind is usually covered, but the deductible is often a percentage (1-5% of dwelling coverage) rather than a flat dollar amount. Flooding from hurricane storm surge is excluded — that's NFIP territory." },
  ]}
/>
