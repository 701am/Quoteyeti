---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ZipForm from "~/components/ZipForm.astro";

const pressLogos = [
  { src: "/assets/images/fox.svg", alt: "Fox News", fallback: "Fox" },
  { src: "/assets/images/usa-today.svg", alt: "USA Today", fallback: "USA Today" },
  { src: "/assets/images/digital-journal.svg", alt: "Digital Journal", fallback: "Digital Journal" },
  { src: "/assets/images/benzinga.svg", alt: "Benzinga", fallback: "Benzinga" },
  { src: "/assets/images/market-watch.svg", alt: "MarketWatch", fallback: "MarketWatch" },
];

const categoryCards = [
  {
    title: "Brands",
    icon: "/assets/images/footprint.svg",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit on all major makes and models.",
    href: "/brands/",
    cta: "Browse Brands",
  },
  {
    title: "Reviews",
    icon: "/assets/images/footprint.svg",
    body: "Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua reviews.",
    href: "/reviews/",
    cta: "Browse Reviews",
  },
  {
    title: "FAQs",
    icon: "/assets/images/footprint.svg",
    body: "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.",
    href: "/faqs/",
    cta: "Browse FAQs",
  },
];
---

<BaseLayout
  title="Welcome to QuoteYeti! - QuoteYeti"
  description="Lorem ipsum dolor sit amet — our goal is to make your life safer by providing the information needed to choose the best auto insurance coverage for you."
>

  <!-- ============== HERO ============== -->
  <section class="hero">
    <div class="hero__art" aria-hidden="true">
      <img src="/assets/images/hero-peaks.svg" alt="" class="hero__peaks" />
      <img src="/assets/images/yeti-hero.svg" alt="" class="hero__yeti" />
    </div>
    <div class="container hero__inner">
      <h1>Your coverage, <span class="highlight underline">simplified</span>.</h1>
      <p class="hero__lede">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Insurance doesn't have to be a dirty word.
      </p>
      <ZipForm variant="header" ctaLabel="Get Quotes" />
    </div>
  </section>

  <!-- ============== TRUSTED-BY ============== -->
  <section class="trusted container">
    <h2 class="trusted__heading">Trusted by thousands of car enthusiasts</h2>
    <p class="trusted__lede">
      Lorem ipsum dolor sit amet — QuoteYeti readers come from all over the country with the goal of getting great coverage for less.
    </p>

    <figure class="trusted__quote">
      <blockquote>
        <p>
          "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. I was looking at my bills and realized
          I could save $40 a month by switching my car insurance."
        </p>
      </blockquote>
      <figcaption>
        <img src="/assets/images/keyshia-davis.jpeg" alt="" width="64" height="64" class="trusted__avatar" />
        <span>
          <strong>Lorem Ipsum</strong><br />
          2018 Honda Civic
        </span>
      </figcaption>
    </figure>
  </section>

  <!-- ============== SAVINGS CTA ============== -->
  <section class="savings">
    <div class="container savings__inner">
      <div class="savings__copy">
        <h2><span class="highlight">Bring on the savings!</span></h2>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. The days of shopping
          around for car insurance are over. We've done the research and have the tools
          to find you the best coverage for you.
        </p>
        <a href="#start-for-free" class="btn btn-primary">Start for free</a>
      </div>
      <div class="savings__art" aria-hidden="true">
        <img src="/assets/images/thumbs-up-left.svg" alt="" />
      </div>
    </div>
  </section>

  <!-- ============== PRESS STRIP ============== -->
  <section class="press container">
    <p class="press__label">QuoteYeti in the wild.</p>
    <ul class="press__logos">
      {pressLogos.map((logo) => (
        <li class="press__logo">
          <span>{logo.fallback}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============== CATEGORY CARDS ============== -->
  <section class="categories container">
    <h2 class="categories__heading">How can we help?</h2>
    <p class="categories__lede">Lorem ipsum — search our knowledge base by category.</p>
    <div class="categories__grid">
      {categoryCards.map((card) => (
        <article class="category-card">
          <div class="category-card__icon" aria-hidden="true">
            <img src={card.icon} alt="" width="48" height="48" />
          </div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <a href={card.href} class="category-card__link">{card.cta} →</a>
        </article>
      ))}
    </div>
  </section>

  <!-- ============== FINAL CTA ============== -->
  <section class="final-cta">
    <div class="final-cta__art" aria-hidden="true">
      <img src="/assets/images/hero-peaks.svg" alt="" />
    </div>
    <div class="container final-cta__inner">
      <p class="final-cta__overline">Ready to get started?</p>
      <h2><span class="highlight">We've got you covered.</span></h2>
      <a href="#start-for-free" class="btn btn-primary">Start for free</a>
    </div>
  </section>

  <style>
    /* ---------- Hero ---------- */
    .hero {
      position: relative;
      padding-block: var(--space-24) var(--space-16);
      overflow: hidden;
      background: linear-gradient(180deg, var(--color-alice) 0%, var(--color-white) 100%);
    }
    .hero__art {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero__peaks {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: auto;
      opacity: 0.85;
    }
    .hero__yeti {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 36%;
      max-width: 480px;
      height: auto;
    }
    .hero__inner {
      position: relative;
      z-index: 1;
      max-width: 720px;
    }
    .hero__lede {
      font-size: 1.25rem;
      color: var(--color-text-strong);
      margin-bottom: var(--space-8);
      max-width: 540px;
    }

    /* ---------- Trusted ---------- */
    .trusted { padding-block: var(--space-24); text-align: center; }
    .trusted__heading { margin-bottom: var(--space-5); }
    .trusted__lede { max-width: 640px; margin: 0 auto var(--space-12); color: var(--color-text-strong); }
    .trusted__quote {
      max-width: 640px;
      margin: 0 auto;
      padding: var(--space-8);
      background: var(--color-alice);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }
    .trusted__quote blockquote {
      margin: 0 0 var(--space-6);
      font-family: var(--font-serif);
      font-size: 1.375rem;
      line-height: 1.5;
      color: var(--color-resolution);
      font-style: italic;
    }
    .trusted__quote figcaption {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      justify-content: center;
      font-size: 0.95rem;
      color: var(--color-text);
    }
    .trusted__avatar {
      border-radius: 50%;
      object-fit: cover;
    }

    /* ---------- Savings ---------- */
    .savings {
      background: var(--color-resolution);
      color: var(--color-white);
      padding-block: var(--space-24);
    }
    .savings__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
      align-items: center;
    }
    .savings__copy h2 { color: var(--color-white); margin-bottom: var(--space-5); }
    .savings__copy p { margin-bottom: var(--space-8); font-size: 1.125rem; opacity: 0.9; }
    .savings__art { text-align: center; }
    .savings__art img { max-width: 320px; width: 100%; }
    @media (max-width: 950px) {
      .savings__inner { grid-template-columns: 1fr; }
      .savings__art { order: -1; }
    }

    /* ---------- Press ---------- */
    .press {
      padding-block: var(--space-16);
      text-align: center;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
    .press__label {
      font-family: var(--font-display);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.875rem;
      color: var(--color-ship-cove);
      margin-bottom: var(--space-8);
    }
    .press__logos {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: var(--space-12);
    }
    .press__logo {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      color: var(--color-ship-cove);
      opacity: 0.7;
      transition: opacity var(--transition);
    }
    .press__logo:hover { opacity: 1; }

    /* ---------- Categories ---------- */
    .categories {
      padding-block: var(--space-24);
      text-align: center;
    }
    .categories__heading { margin-bottom: var(--space-5); }
    .categories__lede { color: var(--color-text); margin-bottom: var(--space-12); }
    .categories__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
    .category-card {
      padding: var(--space-10) var(--space-6);
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-align: center;
      transition: all var(--transition);
    }
    .category-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow);
      border-color: var(--color-malibu);
    }
    .category-card__icon { margin-bottom: var(--space-5); }
    .category-card h3 { font-size: 1.5rem; margin-bottom: var(--space-3); }
    .category-card p { color: var(--color-text); margin-bottom: var(--space-6); }
    .category-card__link {
      font-weight: 600;
      font-family: var(--font-display);
    }
    @media (max-width: 950px) {
      .categories__grid { grid-template-columns: 1fr; }
    }

    /* ---------- Final CTA ---------- */
    .final-cta {
      position: relative;
      padding-block: var(--space-24);
      background: var(--color-alice);
      text-align: center;
      overflow: hidden;
    }
    .final-cta__art {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .final-cta__art img {
      position: absolute;
      bottom: 0;
      width: 100%;
      opacity: 0.4;
    }
    .final-cta__inner { position: relative; z-index: 1; }
    .final-cta__overline {
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.875rem;
      color: var(--color-ship-cove);
      margin-bottom: var(--space-3);
    }
    .final-cta h2 { margin-bottom: var(--space-8); }
  </style>

</BaseLayout>
