---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { VERTICAL_LIST } from "~/data/verticals";

const featuredVerticals = VERTICAL_LIST.filter((v) => ["auto", "home", "business"].includes(v.key));
const secondaryVerticals = VERTICAL_LIST.filter((v) => !["auto", "home", "business"].includes(v.key));

const calculators = [
  { label: "Auto Insurance Calculator", href: "/auto/calculator/", vertical: "auto" },
  { label: "Life Insurance Calculator", href: "/life-insurance/calculator/", vertical: "life" },
  { label: "Health Insurance Calculator", href: "/health-insurance/calculator/", vertical: "health" },
  { label: "Home Insurance Calculator", href: "/home-insurance/calculator/", vertical: "home" },
  { label: "Business Insurance Calculator", href: "/business-insurance/calculator/", vertical: "business" },
  { label: "Pet Insurance Calculator", href: "/pet-insurance/calculator/", vertical: "pet" },
];

const carriers = ["Progressive", "GEICO", "State Farm", "Allstate", "Liberty Mutual", "Nationwide", "Farmers", "Travelers"];
const press = ["Fox", "USA Today", "Digital Journal", "Benzinga", "MarketWatch"];

const topGuides = [
  { title: "Types of Insurance: See Which Is Right for You", href: "/insurance/", category: "Insurance 101" },
  { title: "Car Insurance Basics 101 — Plain English", href: "/auto/basics/", category: "Auto" },
  { title: "Business Insurance: What Does It Cover?", href: "/business-insurance/coverage/", category: "Business" },
  { title: "Is Life Insurance Worth It? Expert Take", href: "/life-insurance/is-it-worth-it/", category: "Life" },
  { title: "How Much Home Insurance Do You Need?", href: "/home-insurance/how-much-do-i-need/", category: "Home" },
  { title: "How to Get Health Insurance in 2026", href: "/health-insurance/how-to-get/", category: "Health" },
];

const faqs = [
  { q: "What is QuoteYeti?", a: "QuoteYeti is an insurance comparison marketplace covering eight insurance verticals. We analyze rates from top carriers, publish independent guides, and connect you with the right coverage for your situation." },
  { q: "How does QuoteYeti make money?", a: "Carriers pay us a commission when you purchase a policy through us. Our editorial rankings and recommendations are independent of those partnerships." },
  { q: "Is QuoteYeti an insurance company?", a: "No. We're a marketplace and editorial team. We don't underwrite or sell policies directly — we connect you with the companies that do." },
  { q: "Do you share my personal data?", a: "We don't sell personal data to third parties. When you request quotes, your information goes only to the carriers and licensed partners you choose." },
];
---

<BaseLayout
  title="QuoteYeti - The Smarter Way to Track Down Insurance Savings"
  description="We navigate the wilderness of the insurance market so you don't have to. Compare auto, home, life, business, health, renters, pet, and travel insurance — all in one place."
>

  <!-- ============== HERO ============== -->
  <section class="hero">
    <div class="hero__art" aria-hidden="true">
      <img src="/assets/images/hero-clouds.svg" alt="" class="hero__clouds" />
      <img src="/assets/images/hero-peaks.svg" alt="" class="hero__peaks" />
      <img src="/assets/images/yeti-hero.svg" alt="" class="hero__yeti" />
    </div>
    <div class="container hero__inner">
      <p class="hero__eyebrow">QuoteYeti, your insurance research assistant</p>
      <h1>The smarter way to <span class="highlight underline-accent">track down savings</span>.</h1>
      <p class="hero__lede">
        We navigate the wilderness of the insurance market so you don't have to. By analyzing variables across eight distinct categories, we isolate the absolute rarest rates — leaving no stone unturned, and no legendary deal undiscovered.
      </p>
      <p class="hero__lede hero__lede--kicker">
        Spot the savings. Pay less. Zero relentless sales calls.
      </p>

      <div class="hero__tiles">
        {featuredVerticals.map((v) => (
          <a href={v.path} class="hero-tile hero-tile--featured" style={`--tile-accent: ${v.accent}; --tile-accent-soft: ${v.accentSoft};`}>
            <img src={v.icon} alt="" class="hero-tile__icon" />
            <span class="hero-tile__label">{v.label}</span>
            <span class="hero-tile__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="hero__chips">
        <p class="hero__chips-label">More coverage:</p>
        <div class="hero__chips-row">
          {secondaryVerticals.map((v) => (
            <a href={v.path} class="hero-chip" style={`--chip-accent: ${v.accent};`}>
              <img src={v.icon} alt="" />
              <span>{v.short}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============== CARRIER STRIP ============== -->
  <section class="carriers">
    <div class="container">
      <p class="carriers__label">Compare coverage and costs across America's top insurers</p>
      <ul class="carriers__list">
        {carriers.map((c) => <li class="carrier-logo">{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============== VALUE PROPS ============== -->
  <section class="value-props">
    <div class="container">
      <p class="eyebrow">Why smarter shoppers use QuoteYeti</p>
      <h2>The work <span class="highlight">before</span> the work.</h2>
      <div class="value-props__grid">
        <article class="value-prop">
          <h3 class="value-prop__title">Find the right coverage without overpaying</h3>
          <p>Compare insurance options that fit your life and your budget — without guesswork or sales pressure.</p>
        </article>
        <article class="value-prop">
          <h3 class="value-prop__title">Expert recommendations you can rely on</h3>
          <p>Choose confidently with guidance from licensed insurance experts and data analysts who evaluate pricing, customer satisfaction, and coverage options.</p>
        </article>
        <article class="value-prop">
          <h3 class="value-prop__title">Personalized tools that do the math</h3>
          <p>Save time and money with free calculators and tools tailored to your ZIP code, budget, and coverage needs.</p>
        </article>
      </div>
      <a href="/about/" class="btn btn-secondary value-props__cta">About the Yeti</a>
    </div>
  </section>

  <!-- ============== CALCULATORS ============== -->
  <section class="calc-grid">
    <div class="container">
      <header class="calc-grid__header">
        <p class="eyebrow">Tools that do the math</p>
        <h2>Estimate your rate <span class="highlight">before</span> talking to anyone</h2>
      </header>
      <div class="calc-grid__tiles">
        {calculators.map((c) => (
          <a href={c.href} class="calc-tile" data-vertical={c.vertical}>
            <span class="calc-tile__label">{c.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== STATS BANNER ============== -->
  <section class="stats">
    <div class="container stats__inner">
      <h2 class="stats__heading">The numbers don't lie</h2>
      <p class="stats__lede">
        We've analyzed millions of quotes and evaluated every major provider so you can compare insurance options with confidence.
      </p>
      <ul class="stats__grid">
        <li>
          <span class="stats__number">2.4M+</span>
          <span class="stats__label">Insurance quotes<br />analyzed nationwide</span>
        </li>
        <li>
          <span class="stats__number">125+</span>
          <span class="stats__label">Top insurance<br />companies reviewed</span>
        </li>
        <li>
          <span class="stats__number">8</span>
          <span class="stats__label">Insurance verticals,<br />one expert team</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============== PRESS ============== -->
  <section class="press">
    <div class="container">
      <p class="eyebrow">Trusted by top media</p>
      <h3 class="press__heading">Our research has been featured in:</h3>
      <ul class="press__list">
        {press.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============== TOP GUIDES ============== -->
  <section class="guides">
    <div class="container">
      <header class="guides__header">
        <p class="eyebrow">Top insurance guides</p>
        <h2>The reading that pays for itself</h2>
      </header>
      <div class="guides__grid">
        {topGuides.map((g) => (
          <a href={g.href} class="guide-card">
            <p class="guide-card__category">{g.category}</p>
            <h3 class="guide-card__title">{g.title}</h3>
            <span class="guide-card__cta">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== EXPLORE GRID — 8 VERTICALS ============== -->
  <section class="explore">
    <div class="container">
      <header class="explore__header">
        <p class="eyebrow">All eight verticals</p>
        <h2>Pick your line of coverage</h2>
      </header>
      <div class="explore__grid">
        {VERTICAL_LIST.map((v) => (
          <article class="explore-card" style={`--card-accent: ${v.accent}; --card-accent-soft: ${v.accentSoft};`}>
            <div class="explore-card__icon">
              <img src={v.icon} alt="" />
            </div>
            <h3 class="explore-card__title">{v.label}</h3>
            <p class="explore-card__desc">{v.description}</p>
            <a href={v.path} class="explore-card__cta">
              Compare {v.short.toLowerCase()} insurance <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== FAQ ============== -->
  <section class="home-faq">
    <div class="container-narrow">
      <header class="home-faq__header">
        <p class="eyebrow">Frequently asked</p>
        <h2>Common questions</h2>
      </header>
      <div class="home-faq__list">
        {faqs.map((faq) => (
          <details class="home-faq__item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* ---------- Hero ---------- */
    .hero {
      position: relative;
      padding-block: var(--space-24) var(--space-16);
      overflow: hidden;
      background: linear-gradient(180deg, var(--color-alice) 0%, var(--color-white) 100%);
    }
    .hero__art { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
    .hero__clouds { position: absolute; top: 4%; left: -8%; width: 56%; opacity: 0.45; }
    .hero__peaks { position: absolute; bottom: 0; left: 0; width: 100%; opacity: 0.9; }
    .hero__yeti { position: absolute; right: 0; bottom: 0; width: 28%; max-width: 380px; }
    .hero__inner { position: relative; z-index: 1; max-width: 820px; }
    .hero__eyebrow {
      font-family: var(--font-display); font-size: 0.875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--color-ship-cove);
      margin: 0 0 var(--space-5);
    }
    .hero__lede {
      font-size: 1.25rem; color: var(--color-text-strong);
      margin-bottom: var(--space-5); max-width: 620px;
    }
    .hero__lede--kicker {
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--color-resolution);
      margin-bottom: var(--space-10);
    }

    .hero__tiles {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
    .hero-tile {
      display: flex; flex-direction: column; gap: var(--space-3);
      padding: var(--space-6);
      background: var(--color-white);
      border: 2px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-decoration: none;
      transition: all var(--transition);
      position: relative;
      min-height: 140px;
    }
    .hero-tile:hover {
      border-color: var(--tile-accent);
      background: var(--tile-accent-soft);
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
    .hero-tile__icon {
      width: 40px; height: 40px;
      color: var(--tile-accent);
    }
    .hero-tile__label {
      font-family: var(--font-display); font-weight: 600;
      font-size: 1.125rem; color: var(--color-resolution);
    }
    .hero-tile__arrow {
      position: absolute; right: var(--space-5); bottom: var(--space-5);
      color: var(--tile-accent);
      font-size: 1.25rem;
      transition: transform var(--transition);
    }
    .hero-tile:hover .hero-tile__arrow { transform: translateX(4px); }

    .hero__chips { margin-top: var(--space-4); }
    .hero__chips-label {
      font-family: var(--font-display); font-size: 0.8125rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--color-text-muted);
      margin: 0 0 var(--space-3);
    }
    .hero__chips-row { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .hero-chip {
      display: inline-flex; align-items: center; gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: 100px;
      color: var(--color-resolution);
      font-family: var(--font-display); font-weight: 600;
      font-size: 0.875rem;
      transition: all var(--transition);
    }
    .hero-chip img { width: 18px; height: 18px; color: var(--chip-accent); }
    .hero-chip:hover {
      border-color: var(--chip-accent);
      color: var(--chip-accent);
    }

    /* ---------- Carrier strip ---------- */
    .carriers {
      padding-block: var(--space-10);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
    .carriers__label {
      text-align: center;
      font-family: var(--font-display); font-size: 0.875rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--color-ship-cove);
      margin: 0 0 var(--space-6);
    }
    .carriers__list {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; justify-content: center;
      align-items: center; gap: var(--space-10);
    }
    .carrier-logo {
      font-family: var(--font-serif); font-style: italic;
      font-size: 1.125rem;
      color: var(--color-ship-cove);
      opacity: 0.7;
      transition: opacity var(--transition);
    }
    .carrier-logo:hover { opacity: 1; }

    /* ---------- Value props ---------- */
    .value-props { padding-block: var(--space-24); }
    .value-props h2 { max-width: 720px; margin-bottom: var(--space-12); }
    .value-props__grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8);
      margin-bottom: var(--space-12);
    }
    .value-prop {
      padding-top: var(--space-6);
      border-top: 4px solid var(--color-malibu);
    }
    .value-prop__title { font-size: 1.375rem; margin-bottom: var(--space-3); }
    .value-prop p { color: var(--color-text); }

    /* ---------- Calculators ---------- */
    .calc-grid {
      background: var(--color-alice);
      padding-block: var(--space-24);
    }
    .calc-grid__header { text-align: center; margin-bottom: var(--space-12); max-width: 640px; margin-inline: auto; }
    .calc-grid__tiles {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4);
    }
    .calc-tile {
      display: flex; justify-content: space-between; align-items: center;
      padding: var(--space-5) var(--space-6);
      background: var(--color-white);
      border-radius: var(--radius);
      color: var(--color-resolution);
      font-family: var(--font-display); font-weight: 600;
      font-size: 1.0625rem;
      transition: all var(--transition);
      border: 1px solid transparent;
    }
    .calc-tile:hover {
      border-color: var(--color-malibu);
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }

    /* ---------- Stats ---------- */
    .stats {
      background: var(--color-resolution);
      color: var(--color-white);
      padding-block: var(--space-20);
    }
    .stats__inner { text-align: center; max-width: 900px; }
    .stats__heading { color: var(--color-white); }
    .stats__lede { font-size: 1.125rem; opacity: 0.92; margin-bottom: var(--space-12); }
    .stats__grid {
      list-style: none; margin: 0; padding: 0;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8);
    }
    .stats__number {
      display: block;
      font-family: var(--font-serif); font-style: italic; font-weight: 700;
      font-size: 4rem; line-height: 1;
      color: var(--color-malibu);
      margin-bottom: var(--space-3);
    }
    .stats__label {
      font-family: var(--font-display); font-size: 0.9375rem;
      opacity: 0.85;
    }

    /* ---------- Press ---------- */
    .press { padding-block: var(--space-20); text-align: center; }
    .press__heading {
      font-family: var(--font-body); font-weight: 400;
      font-size: 1.125rem;
      color: var(--color-text);
      margin-bottom: var(--space-8);
    }
    .press__list {
      list-style: none; margin: 0; padding: 0;
      display: flex; justify-content: center; align-items: center;
      flex-wrap: wrap; gap: var(--space-10);
    }
    .press__list li {
      font-family: var(--font-serif); font-style: italic;
      font-size: 1.25rem;
      color: var(--color-ship-cove);
      opacity: 0.75;
    }

    /* ---------- Top guides ---------- */
    .guides {
      background: var(--color-alice);
      padding-block: var(--space-24);
    }
    .guides__header { text-align: center; margin-bottom: var(--space-12); }
    .guides__grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5);
    }
    .guide-card {
      display: block;
      padding: var(--space-6);
      background: var(--color-white);
      border-radius: var(--radius-lg);
      border: 1px solid var(--color-border);
      transition: all var(--transition);
    }
    .guide-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
      border-color: var(--color-malibu);
    }
    .guide-card__category {
      font-family: var(--font-display); font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--color-malibu);
      margin: 0 0 var(--space-3);
    }
    .guide-card__title {
      font-size: 1.125rem; line-height: 1.3;
      margin-bottom: var(--space-4);
    }
    .guide-card__cta {
      font-family: var(--font-display); font-weight: 600;
      color: var(--color-resolution);
    }

    /* ---------- Explore (8 verticals) ---------- */
    .explore { padding-block: var(--space-24); }
    .explore__header { text-align: center; margin-bottom: var(--space-12); }
    .explore__grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5);
    }
    .explore-card {
      padding: var(--space-6);
      background: var(--color-white);
      border-radius: var(--radius-lg);
      border: 1px solid var(--color-border);
      border-top: 4px solid var(--card-accent);
      display: flex; flex-direction: column; gap: var(--space-3);
      transition: all var(--transition);
    }
    .explore-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow);
    }
    .explore-card__icon {
      width: 48px; height: 48px;
      background: var(--card-accent-soft);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      color: var(--card-accent);
    }
    .explore-card__icon img { width: 28px; height: 28px; }
    .explore-card__title { font-size: 1.25rem; margin-bottom: var(--space-2); }
    .explore-card__desc { font-size: 0.9375rem; color: var(--color-text); margin: 0; flex: 1; }
    .explore-card__cta {
      font-family: var(--font-display); font-weight: 600;
      font-size: 0.9375rem;
      color: var(--card-accent);
      margin-top: var(--space-4);
    }

    /* ---------- FAQ ---------- */
    .home-faq {
      background: var(--color-alice);
      padding-block: var(--space-20);
    }
    .home-faq__header { text-align: center; margin-bottom: var(--space-10); }
    .home-faq__list { display: flex; flex-direction: column; gap: var(--space-3); }
    .home-faq__item {
      background: var(--color-white);
      border-radius: var(--radius);
      border: 1px solid var(--color-border);
    }
    .home-faq__item summary {
      cursor: pointer;
      padding: var(--space-5) var(--space-6);
      font-family: var(--font-display); font-weight: 600;
      font-size: 1.0625rem;
      color: var(--color-resolution);
      display: flex; justify-content: space-between; align-items: center;
      list-style: none;
    }
    .home-faq__item summary::-webkit-details-marker { display: none; }
    .home-faq__item summary::after {
      content: "+"; font-size: 1.5rem; color: var(--color-malibu);
    }
    .home-faq__item[open] summary::after { content: "−"; }
    .home-faq__item p {
      padding: 0 var(--space-6) var(--space-5); margin: 0;
      color: var(--color-text); line-height: 1.6;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 950px) {
      .hero__tiles, .value-props__grid, .calc-grid__tiles, .stats__grid, .guides__grid { grid-template-columns: 1fr; }
      .explore__grid { grid-template-columns: repeat(2, 1fr); }
      .hero__yeti { width: 40%; opacity: 0.45; }
      .stats__number { font-size: 3rem; }
    }
    @media (max-width: 600px) {
      .explore__grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
