---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ZipForm from "~/components/ZipForm.astro";
import FootprintDivider from "~/components/editorial/FootprintDivider.astro";
import MastheadPill from "~/components/editorial/MastheadPill.astro";
import { VERTICAL_LIST } from "~/data/verticals";
import { getCollection } from "astro:content";

async function safeCollection(name: string) {
  try { return await getCollection(name as any, ({ data }: any) => !data.draft); }
  catch { return []; }
}

const reviewCounts: Record<string, number> = {};
const scoredReviewCounts: Record<string, number> = {};
const guideCounts: Record<string, number> = {};
let totalReviews = 0, totalGuides = 0, totalLocations = 0;
let totalScoredReviews = 0;

for (const v of VERTICAL_LIST) {
  const r = await safeCollection(`${v.key}-reviews`);
  const realCarriers = r.filter((x: any) =>
    !x.data.entityType || x.data.entityType === "carrier"
  );
  reviewCounts[v.key] = realCarriers.length;
  const scoredThis = realCarriers.filter((x: any) => typeof x.data.overallScore === "number").length;
  scoredReviewCounts[v.key] = scoredThis;
  totalReviews += realCarriers.length;
  totalScoredReviews += scoredThis;
  if (v.key !== "auto") {
    const g = await safeCollection(v.key);
    guideCounts[v.key] = g.length;
    totalGuides += g.length;
  } else { guideCounts[v.key] = 0; }
  if (["auto", "home", "life", "business"].includes(v.key)) {
    const locs = await safeCollection(`${v.key}-locations`);
    totalLocations += locs.length;
  }
}

const allPosts = await safeCollection("posts");
const featuredPosts = allPosts
  .sort((a: any, b: any) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0))
  .slice(0, 4);

const homeGuides = await safeCollection("home");
const lifeGuides = await safeCollection("life");
const healthGuides = await safeCollection("health");

const featuredGuides = [
  homeGuides[0] && { ...homeGuides[0], _verticalSlug: "home-insurance", _verticalLabel: "Home", _accent: "#8FB339" },
  lifeGuides[0] && { ...lifeGuides[0], _verticalSlug: "life-insurance", _verticalLabel: "Life", _accent: "#6B5B95" },
  healthGuides[0] && { ...healthGuides[0], _verticalSlug: "health-insurance", _verticalLabel: "Health", _accent: "#14A38B" },
].filter(Boolean);

const faqs = [
  { q: "What is QuoteYeti?", a: "QuoteYeti is an independent insurance research and comparison site covering eight insurance verticals — auto, home, life, business, health, renters, pet, and travel. We publish carrier reviews, in-depth guides, and state-by-state breakdowns, then connect you with the carriers that fit your situation." },
  { q: "How does QuoteYeti make money?", a: "Carriers and licensed partners pay us a commission when you purchase a policy through our quote flow. Our editorial reviews, rankings, and recommendations are independent of those commercial relationships — we'd rather lose a referral than recommend a carrier we don't believe in." },
  { q: "Is QuoteYeti an insurance company?", a: "No. We're a research and editorial team. We don't underwrite policies, we don't sell directly, and we don't have an in-house sales force calling you. We connect you with the companies that do issue coverage — only when you ask." },
  { q: "Do you share my personal data?", a: "We never sell personal data. When you request quotes, your information goes only to the carriers and licensed partners you specifically choose. We don't auto-route data to anyone you didn't ask to hear from." },
  { q: "Why eight verticals?", a: "Most insurance research sites focus on one or two categories — usually auto and home. We built across all eight because the same household typically needs multiple types of coverage, and the same carriers compete across multiple verticals. Cross-vertical knowledge produces better recommendations than single-vertical expertise." },
];
---

<BaseLayout
  title="QuoteYeti — Independent insurance research across eight verticals"
  description="Compare insurance the smart way. Independent research across auto, home, life, business, health, renters, pet, and travel — no sales pressure, no paid rankings."
>

  <section class="hero">
    <div class="hero__art" aria-hidden="true">
      <img src="/assets/images/hero-clouds.svg" alt="" class="hero__clouds" loading="eager" width="1000" height="600" />
      <img src="/assets/images/hero-peaks.svg" alt="" class="hero__peaks" loading="eager" width="1920" height="400" />
    </div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">QuoteYeti — independent insurance research</p>
        <h1 class="hero__h1">
          Independent insurance research
          <span class="hero__h1-emph"><span class="serif-italic">across eight verticals</span>.</span>
        </h1>
        <p class="hero__lede">
          We navigate the wilderness of the insurance market so you don't have to. No paid rankings. No data routing. No relentless sales calls.
        </p>
        <p class="hero__supports">
          <a href="/methodology/" class="hero__support-link">
            <span>See our methodology</span>
            <svg width="11" height="9" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <span class="hero__support-sep" aria-hidden="true">·</span>
          <a href="/about/" class="hero__support-link">
            <span>About the Yeti</span>
            <svg width="11" height="9" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </p>
      </div>
      <div class="hero__zip-col">
        <div class="hero__cta-stage">
          <img src="/assets/images/bob-the-yeti-head.png" alt="" class="hero__cta-yeti" aria-hidden="true" loading="eager" fetchpriority="high" width="408" height="208" />
          <div class="hero__cta-wrap">
            <ZipForm variant="picker" eyebrow="Start comparing" heading="What are you insuring?" />
          </div>
        </div>
        <ul class="trust-badges hero__trust">
          <li class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="4" y="11" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M8 11V8a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>256-bit secure</span>
          </li>
          <li class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2l8 4v6c0 5-3.5 9.5-8 10-4.5-.5-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Editorially independent</span>
          </li>
          <li class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
              <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>60-second comparison</span>
          </li>
          <li class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 8h14M5 12h14M5 16h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>Zero spam calls</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="hstats">
    <div class="container">
      <header class="hstats__header">
        <p class="hstats__eyebrow">By the numbers</p>
      </header>
      <div class="hstats__grid">
        <div class="hstat">
          <div class="hstat__num">{VERTICAL_LIST.length}</div>
          <div class="hstat__label">Insurance verticals covered</div>
        </div>
        <div class="hstat">
          <div class="hstat__num">{totalScoredReviews}</div>
          <div class="hstat__label">Independent carrier reviews</div>
        </div>
        <div class="hstat">
          <div class="hstat__num">{totalGuides}<span class="hstat__num-suffix">+</span></div>
          <div class="hstat__label">In-depth guides published</div>
        </div>
        <div class="hstat">
          <div class="hstat__num">{totalLocations}</div>
          <div class="hstat__label">State-specific pages</div>
        </div>
        <div class="hstat">
          <div class="hstat__num">{allPosts.length}</div>
          <div class="hstat__label">Dispatch articles</div>
        </div>
      </div>
    </div>
  </section>

  <section class="explore" id="explore">
    <div class="container">
      <header class="explore__header">
        <p class="eyebrow eyebrow--dark">Pick a line of coverage</p>
        <h2>Eight categories. <span class="serif-italic">One yeti.</span></h2>
        <p class="explore__lede">Every category gets its own dedicated research, ranked carriers, and editorial team. Pick yours below.</p>
      </header>
      <div class="explore__grid">
        {VERTICAL_LIST.map((v, i) => (
          <a href={v.path} class="vcard" style={`--card-accent: ${v.accent}; --card-accent-soft: ${v.accentSoft};`}>
            <div class="vcard__head">
              <div class="vcard__icon"><img src={v.icon} alt="" width="22" height="22" loading="lazy" /></div>
              <span class="vcard__num">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="vcard__body">
              <h3 class="vcard__title">{v.label}</h3>
              <p class="vcard__desc">{v.description}</p>
            </div>
            <div class="vcard__meta">
              {scoredReviewCounts[v.key] > 0 && <span class="vcard__meta-item">{scoredReviewCounts[v.key]} reviews</span>}
              {guideCounts[v.key] > 0 && <span class="vcard__meta-item">{guideCounts[v.key]} guides</span>}
            </div>
            <span class="vcard__cta">
              <span class="vcard__cta-label">Compare {v.short.toLowerCase()}</span>
              <span class="vcard__cta-arrow" aria-hidden="true">
                <svg width="14" height="12" viewBox="0 0 14 12" fill="none"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container"><FootprintDivider width="medium" margin="tight" /></div>

  <section class="manifesto">
    <div class="container">
      <div class="manifesto__inner">
        <p class="manifesto__quote">
          <span class="manifesto__open" aria-hidden="true">"</span>
          We're not in the business of selling insurance. We're in the business of <em>finding the right one</em> — and getting out of your way.
          <span class="manifesto__close" aria-hidden="true">"</span>
        </p>
        <p class="manifesto__attribution">— The QuoteYeti editorial team</p>
      </div>
    </div>
  </section>

  <section class="promises">
    <div class="container">
      <header class="promises__header">
        <p class="eyebrow">What we promise</p>
        <h2>Four commitments. <span class="serif-italic">No exceptions.</span></h2>
      </header>
    </div>

    <article class="promise promise--left">
      <div class="container promise__inner">
        <span class="promise__numeral" aria-hidden="true">01</span>
        <div class="promise__body">
          <h3 class="promise__heading">No paid rankings.</h3>
          <p class="promise__copy">Our editorial rankings are independent of who pays us. Carriers and licensed partners pay us a commission only when you buy through our quote flow — but they have no influence on who appears on our best-of lists or how a carrier is scored. We'd rather lose a referral than recommend a carrier we don't actually believe in.</p>
          <a href="/methodology/" class="promise__link">
            <span>How we score carriers</span>
            <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </article>

    <article class="promise promise--right">
      <div class="container promise__inner">
        <span class="promise__numeral" aria-hidden="true">02</span>
        <div class="promise__body">
          <h3 class="promise__heading">No data routing without your okay.</h3>
          <p class="promise__copy">Most comparison sites auto-route your contact info to every carrier they can. We don't. Your information goes only to the carriers you specifically choose in the quote flow you explicitly initiate. We never sell personal data, and we don't sell email lists.</p>
          <a href="/editorial/" class="promise__link">
            <span>Read our editorial standards</span>
            <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </article>

    <article class="promise promise--left">
      <div class="container promise__inner">
        <span class="promise__numeral" aria-hidden="true">03</span>
        <div class="promise__body">
          <h3 class="promise__heading">Eight verticals. One editorial team.</h3>
          <p class="promise__copy">Most insurance research sites focus on one or two categories — usually auto and home. We built across all eight because the same household typically needs multiple types of coverage, and the same carriers compete across multiple verticals. Cross-vertical knowledge produces better recommendations than single-vertical expertise.</p>
          <a href="/about/team/" class="promise__link">
            <span>Meet the editorial team</span>
            <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </article>

    <article class="promise promise--right">
      <div class="container promise__inner">
        <span class="promise__numeral" aria-hidden="true">04</span>
        <div class="promise__body">
          <h3 class="promise__heading">Editorial honesty over SEO.</h3>
          <p class="promise__copy">If a carrier overcharges, we say so. If a popular product is structurally bad math — looking at you, indexed universal life — we say so. The result: smaller search traffic on some terms, more trust where it counts. We publish for buyers, not for ranking algorithms.</p>
          <a href="/blog/" class="promise__link">
            <span>Read The Dispatch</span>
            <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </article>
  </section>

  {/* THE DISPATCH — publication identity beat, replaces the cut Process section */}
  {featuredPosts.length > 0 && (
    <section class="dispatch-band">
      <div class="container">
        <div class="dispatch-band__inner">
          <div class="dispatch-band__copy">
            <p class="dispatch-band__masthead">
              <span class="dispatch-band__masthead-name">The Dispatch</span>
              <span class="dispatch-band__masthead-sep" aria-hidden="true">·</span>
              <span class="dispatch-band__masthead-issue">QuoteYeti's weekly publication</span>
            </p>
            <h2 class="dispatch-band__h2">
              We publish what the comparison sites <span class="serif-italic">won't</span>.
            </h2>
            <p class="dispatch-band__lede">
              Honest analysis, regulatory updates, and carrier deep-dives. No clickbait. No sponsored content. One editorial brief every Tuesday for readers who want signal, not noise.
            </p>
            <div class="dispatch-band__actions">
              <a href="/newsletter/" class="dispatch-band__cta">
                <span>Subscribe to The Dispatch</span>
                <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                  <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="/blog/" class="dispatch-band__link">Browse all issues →</a>
            </div>
          </div>
          {featuredPosts[0] && (
            <aside class="dispatch-band__featured" aria-label="Latest issue">
              <p class="dispatch-band__featured-eyebrow">Latest issue</p>
              <a href={`/blog/${featuredPosts[0].id}/`} class="dispatch-band__featured-link">
                {featuredPosts[0].data.category && (
                  <p class="dispatch-band__featured-cat">{featuredPosts[0].data.category}</p>
                )}
                <h3 class="dispatch-band__featured-title">{featuredPosts[0].data.title}</h3>
                {featuredPosts[0].data.excerpt && (
                  <p class="dispatch-band__featured-excerpt">{featuredPosts[0].data.excerpt}</p>
                )}
                <span class="dispatch-band__featured-cta">Read the issue →</span>
              </a>
            </aside>
          )}
        </div>
      </div>
    </section>
  )}

  {featuredGuides.length > 0 && (
    <section class="hguides">
      <div class="container">
        <header class="hguides__header">
          <div><p class="eyebrow">Most-read guides</p><h2>In-depth on the decisions <span class="serif-italic">that move the needle</span>.</h2></div>
          <p class="hguides__lede">Long-form guides on the specific decisions that produce real savings or real protection. Written for buyers, not for search engines.</p>
        </header>
        <div class="hguides__grid">
          {featuredGuides.map((guide: any, i: number) => (
            <a href={`/${guide._verticalSlug}/guides/${guide.id}/`} class="hguide-card" style={`--g-accent: ${guide._accent};`}>
              <div class="hguide-card__head"><span class="hguide-card__cat">{guide._verticalLabel}</span><span class="hguide-card__num">{String(i + 1).padStart(2, "0")}</span></div>
              <h3 class="hguide-card__title">{guide.data.title}</h3>
              {guide.data.description && <p class="hguide-card__desc">{guide.data.description}</p>}
              <span class="hguide-card__cta">Read the guide →</span>
            </a>
          ))}
        </div>
        <div class="hguides__footer">
          <a href="/sitemap/" class="hguides__more">See every guide we've published
            <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {featuredPosts.length > 0 && (
    <section class="hposts">
      <div class="container">
        <FootprintDivider width="medium" margin="tight" />
        <header class="hposts__header">
          <div><p class="eyebrow">From The Dispatch</p><h2>Reading that <span class="serif-italic">pays for itself</span>.</h2></div>
          <a href="/blog/" class="hposts__view-all">All Dispatch posts
            <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </header>
        <div class="hposts__grid">
          {featuredPosts.map((post: any, i: number) => (
            <a href={`/blog/${post.id}/`} class={`hpost-card ${i === 0 ? "hpost-card--feature" : ""}`}>
              {post.data.category && <span class="hpost-card__cat">{post.data.category}</span>}
              <h3 class="hpost-card__title">{post.data.title}</h3>
              {post.data.excerpt && <p class="hpost-card__excerpt">{post.data.excerpt}</p>}
              <span class="hpost-card__arrow">Read post →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="home-faq">
    <div class="container">
      <div class="home-faq__layout">
        <aside class="home-faq__sidebar">
          <p class="eyebrow">About QuoteYeti</p>
          <h2 class="home-faq__h2">Why <span class="serif-italic">QuoteYeti</span>?</h2>
          <p class="home-faq__sub">The questions we would ask before trusting an insurance research site with our money.</p>
          <a href="/editorial/" class="home-faq__support-link">
            <span>Read our full editorial standards</span>
            <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true"><path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </aside>
        <div class="home-faq__list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-item__summary">
                <span class="faq-item__q">{faq.q}</span>
                <span class="faq-item__icon" aria-hidden="true"><svg viewBox="0 0 14 14" width="14" height="14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
              </summary>
              <div class="faq-item__answer"><p>{faq.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="container"><FootprintDivider width="medium" margin="tight" /></div>

  <section class="hfinal">
    <div class="container">
      <div class="hfinal__inner">
        <MastheadPill eyebrow="Vol. II" value="The Wilderness Edition" tone="ghost" />
        <p class="hfinal__eyebrow">Ready when you are</p>
        <h2 class="hfinal__h2">Start where the <span class="serif-italic">coverage</span> lives.</h2>
        <p class="hfinal__lede">
          Eight verticals. Independent research. No data routing. No relentless sales calls. Pick a category and we'll take it from there.
        </p>
        <ul class="hfinal__verticals">
          {VERTICAL_LIST.map((v) => (
            <li>
              <a href={v.path} class="hfinal__vertical" style={`--v-accent: ${v.accent};`}>
                <span class="hfinal__vertical-icon" aria-hidden="true">
                  <img src={v.icon} alt="" width="20" height="20" loading="lazy" />
                </span>
                <span class="hfinal__vertical-label">{v.short}</span>
                <span class="hfinal__vertical-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="hfinal__tertiary-wrap">
          <a href="/sitemap/" class="hfinal__tertiary">
            Or browse every page on QuoteYeti
            <svg width="11" height="9" viewBox="0 0 14 12" fill="none" aria-hidden="true">
              <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </p>
      </div>
    </div>
  </section>

  <style>
    .serif-italic { font-family: var(--font-serif, "Plantin", Georgia, serif); font-style: italic; font-weight: 500; letter-spacing: -0.01em; }
    .eyebrow { display: inline-block; font-family: var(--font-display); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--color-ship-cove); margin: 0 0 var(--space-4); }
    .eyebrow--dark { color: var(--color-resolution); }

    .hero {
      position: relative;
      padding-block: clamp(4rem, 9vw, 8rem) clamp(3.5rem, 7vw, 6rem);
      overflow: hidden;
      background: linear-gradient(180deg, var(--color-alice) 0%, var(--color-white) 100%);
    }
    .hero__art { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
    .hero__clouds { position: absolute; top: 4%; left: -8%; width: 56%; max-width: 600px; opacity: 0.32; height: auto; }
    .hero__peaks { position: absolute; bottom: 0; left: 0; width: 100%; opacity: 0.55; height: auto; }
    .hero__inner {
      position: relative; z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 500px;
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
    }
    .hero__copy { min-width: 0; }
    .hero__eyebrow {
      font-family: var(--font-display);
      font-size: 0.75rem; font-weight: 600;
      letter-spacing: 0.16em;
