---
import VerticalHub from "~/layouts/VerticalHub.astro";
import { VERTICALS } from "~/data/verticals";

const v = VERTICALS.renters;
---

<VerticalHub
  vertical={v}
  hero={{
    headline: "$15/month coverage you'll actually appreciate.",
    lede: "Cover your stuff and your liability for less than a streaming subscription. Compare renters quotes from major carriers in one place.",
    ctaLabel: "Get renters quotes",
    ctaHref: "/renters-insurance/quotes/",
  }}
  pillars={[
    {
      title: "See the best renters carriers",
      body: "Lemonade, State Farm, Allstate, GEICO, USAA, and the regional players — independently ranked on price, ease of claims, and policy substance.",
      href: "/renters-insurance/best/",
      cta: "See top carriers",
    },
    {
      title: "Bundle with auto for savings",
      body: "Renters policies are cheap on their own (typically $15-$25/month). Bundling with auto often more than offsets the renters premium through auto discount.",
      href: "/renters-insurance/quotes/",
      cta: "Get a quote",
    },
    {
      title: "Read renters guides",
      body: "What's covered (and what's not), how scheduled riders work, what to do for roommates, when bedbugs and pets matter — the practical stuff.",
      href: "/renters-insurance/guides/",
      cta: "Browse guides",
    },
  ]}
  intro={{
    eyebrow: "How we think about renters insurance",
    heading: "Cheapest insurance you'll ever buy. Most renters skip it anyway.",
    body: `<p>Renters insurance is unfairly underrated. For roughly <strong>$15-$25 per month</strong>, you get $20K-$50K of personal property coverage, $100K-$300K of personal liability protection, and loss of use coverage if a covered disaster makes your unit uninhabitable.</p>
<p>The biggest value isn't actually the contents coverage — it's the <strong>liability protection</strong>. If a guest is injured at your apartment, your dog bites someone on a walk, or a kitchen fire damages neighboring units, your renters policy is what stands between you and a lawsuit.</p>
<p>Where to start: <a href="/renters-insurance/best/">see who actually competes on price for renters</a>, then <a href="/renters-insurance/quotes/">get quotes</a>. We focus on <a href="/renters-insurance/guides/">the decisions that matter</a> — replacement cost vs. actual cash value, scheduled riders for jewelry, what happens with roommates.</p>`,
  }}
  stats={[
    { number: "$15-25", label: "Monthly premium", context: "Typical for $30K personal property + $100K liability" },
    { number: "5-10%", label: "Auto bundle discount", context: "Often offsets the entire renters premium" },
    { number: "$1,500", label: "Jewelry sublimit", context: "Standard renters cap — schedule items above this" },
    { number: "100K-300K", label: "Liability protection", context: "Why renters policies are about more than your stuff" },
  ]}
  subtopics={[
    {
      title: "Best renters insurance",
      href: "/renters-insurance/best/",
      desc: "Top renters carriers ranked — Lemonade, State Farm, USAA, Allstate, GEICO. Where each wins on price and customer experience."
    },
    {
      title: "Carrier reviews",
      href: "/renters-insurance/reviews/",
      desc: "Independent reviews of major renters carriers. Premium spreads, claim handling, app quality, and policy substance compared."
    },
    {
      title: "Renters guides",
      href: "/renters-insurance/guides/",
      desc: "In-depth coverage of the decisions that matter — replacement cost, scheduled riders, roommates, what's not covered."
    },
    {
      title: "Get quotes",
      href: "/renters-insurance/quotes/",
      desc: "Compare renters insurance quotes from carriers competing in your area. Most policies issue same-day."
    },
  ]}
  myths={[
    {
      myth: "My landlord's insurance covers my stuff.",
      reality: "Your landlord's policy covers the building and their property — not your belongings. If your apartment is destroyed by fire, your landlord's insurance rebuilds the unit; your stuff is your problem unless you have renters coverage."
    },
    {
      myth: "I don't have enough stuff to need renters insurance.",
      reality: "Most renters underestimate their belongings by 50%+. Furniture, electronics, clothing, kitchen items, and personal effects add up faster than you think. The liability protection alone justifies the $15-25/month."
    },
    {
      myth: "Renters insurance is too expensive.",
      reality: "$15-25 per month is the cheapest insurance most consumers can buy. Less than a streaming subscription. Bundled with auto, the auto discount often eclipses the renters premium entirely."
    },
    {
      myth: "I'm fine because I don't have anything valuable.",
      reality: "The value is in liability. One liability claim — a guest tripping at your apartment, your dog biting someone, a kitchen fire damaging the unit above yours — can cost tens or hundreds of thousands without coverage."
    },
  ]}
  faqs={[
    { q: "What does renters insurance actually cover?", a: "Personal property (your belongings), personal liability (claims against you for injury or damage), loss of use (temporary housing if your unit is uninhabitable), and limited medical payments for guests injured at your unit. Standard exclusions: flood, earthquake, intentional damage." },
    { q: "How much renters insurance do I need?", a: "Personal property: enough to replace what you actually have (typically $20K-$50K for most renters). Liability: $100K minimum, $300K is the safer baseline. Bump to $500K plus an umbrella policy if you have meaningful assets." },
    { q: "Replacement cost or actual cash value?", a: "Always replacement cost. ACV depreciates older items — your 8-year-old TV pays out $80 instead of $400. Replacement cost typically costs only $30-$50 more per year and pays out dramatically more at claim time." },
    { q: "Does renters insurance cover roommates?", a: "Only if your roommate is named on the policy. Otherwise, each roommate needs their own policy. Most carriers will let you add a non-related roommate to your policy for a small premium increase." },
    { q: "Does renters insurance cover bedbugs or rodent damage?", a: "Almost never. Pest-related damage is excluded under standard policies. Bedbug treatment and damage are your responsibility (or, depending on your lease and state law, potentially your landlord's)." },
    { q: "Will renters insurance pay if my apartment floods?", a: "From plumbing (burst pipe, overflow): yes. From outside water rising (rain, river overflow): no — that's flood, and you'd need a separate NFIP policy. The distinction matters in coastal markets and ground-floor apartments." },
  ]}
/>
