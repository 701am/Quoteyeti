---
/**
 * Carrier comparison picker for each vertical.
 *
 * Route: /<vertical>/compare/
 *
 * Shows all carriers in the vertical, lets the user select 2 or 3, and
 * navigates to the comparison page. Also surfaces popular pre-built
 * comparisons.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import ZipForm from "~/components/ZipForm.astro";
import { getCollection } from "astro:content";
import { VERTICAL_LIST, type VerticalKey } from "~/data/verticals";

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const v of VERTICAL_LIST) {
    let reviews: any[] = [];
    try {
      reviews = await getCollection(`${v.key}-reviews` as any, ({ data }: any) => !data.draft);
    } catch {
      continue;
    }
    if (reviews.length < 2) continue;
    paths.push({ params: { vertical: v.slug }, props: { vertical: v, reviews } });
  }
  return paths;
}

const { vertical, reviews } = Astro.props as { vertical: any; reviews: any[] };

// Sort by rank then score
const sorted = [...reviews].sort((a, b) => {
  const ra = a.data.overallRank ?? 99;
  const rb = b.data.overallRank ?? 99;
  if (ra !== rb) return ra - rb;
  return (b.data.overallScore ?? 0) - (a.data.overallScore ?? 0);
});

// Build a list of "popular" pre-built comparisons (top-1 vs top-N for N in 2..5)
const popular: Array<{ slug: string; title: string; carriers: any[] }> = [];
if (sorted.length >= 2) {
  const top = sorted[0];
  for (let i = 1; i < Math.min(sorted.length, 5); i++) {
    const c = sorted[i];
    // Slug must be alphabetical to match the URL generated by getStaticPaths
    // in /[vertical]/compare/[slug].astro
    const slugIds = [top.id, c.id].sort();
    popular.push({
      slug: slugIds.join("-vs-"),
      title: `${top.data.company} vs ${c.data.company}`,
      carriers: [top, c],
    });
  }
  // Add a top-3 if we have at least 3
  if (sorted.length >= 3) {
    const top3 = sorted.slice(0, 3);
    const slugIds = top3.map((x) => x.id).sort();
    popular.push({
      slug: slugIds.join("-vs-"),
      title: top3.map((x) => x.data.company).join(" vs "),
      carriers: top3,
    });
  }
}

const pageTitle = `Compare ${vertical.label} Carriers`;
const pageDesc = `Build a side-by-side comparison of ${vertical.short.toLowerCase()} insurance carriers. Pick any 2 or 3 to see ratings, cost, coverage, pros and cons head to head.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: vertical.short, url: vertical.path },
    { name: "Compare", url: `${vertical.path}compare/` },
  ]}
>
  <article class="cmppick" style={`--c-accent: ${vertical.accent}; --c-accent-soft: ${vertical.accentSoft};`}>
    <header class="cmppick-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs__sep" aria-hidden="true">›</span>
          <a href={vertical.path}>{vertical.short}</a>
          <span class="breadcrumbs__sep" aria-hidden="true">›</span>
          <span aria-current="page">Compare</span>
        </nav>
        <p class="eyebrow">
          <img src={vertical.icon} alt="" width="18" height="18" />
          {vertical.label} Comparison
        </p>
        <h1>Compare {vertical.label} <span class="serif-italic">side by side</span>.</h1>
        <p class="cmppick-hero__lede">
          Pick 2 or 3 carriers below. We'll show you ratings, cost, coverage, pros, cons, and what each one's best at — all in a single view.
        </p>
      </div>
    </header>

    {popular.length > 0 && (
      <section class="cmppick-section">
        <div class="container">
          <h2 class="cmppick-section__title">Popular comparisons</h2>
          <p class="cmppick-section__lede">The carrier combinations most {vertical.short.toLowerCase()} shoppers want to see compared.</p>
          <div class="cmppick-popular">
            {popular.map((p) => (
              <a href={`${vertical.path}compare/${p.slug}/`} class="cmppick-popular__card">
                <span class="cmppick-popular__count">{p.carriers.length}-way</span>
                <h3 class="cmppick-popular__title">{p.title}</h3>
                <span class="cmppick-popular__cta">
                  Compare
                  <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                    <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="cmppick-section cmppick-section--alt">
      <div class="container">
        <h2 class="cmppick-section__title">Build your own comparison</h2>
        <p class="cmppick-section__lede">Tap up to 3 carriers, then hit "Compare". You can swap any selection before you commit.</p>

        <div class="cmppick-builder" id="cmppick-builder" data-base-path={`${vertical.path}compare/`}>
          <div class="cmppick-grid">
            {sorted.map((c) => (
              <label class="cmppick-chip">
                <input type="checkbox" name="carrier" value={c.id} data-name={c.data.company} />
                <span class="cmppick-chip__inner">
                  <span class="cmppick-chip__name">{c.data.company}</span>
                  <span class="cmppick-chip__meta">
                    <span class="cmppick-chip__score">★ {c.data.overallScore.toFixed(2)}</span>
                    {c.data.overallRank && <span class="cmppick-chip__rank">#{c.data.overallRank}</span>}
                  </span>
                  <span class="cmppick-chip__check" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                      <circle cx="7" cy="7" r="7" fill="currentColor"/>
                      <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                  </span>
                </span>
              </label>
            ))}
          </div>

          <div class="cmppick-actions" id="cmppick-actions">
            <div class="cmppick-actions__status">
              <span class="cmppick-actions__count">0</span> of 3 selected
              <span class="cmppick-actions__hint" data-empty>· Pick at least 2</span>
            </div>
            <button type="button" class="cmppick-actions__btn" id="cmppick-go" disabled>
              <span>Compare selected</span>
              <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="cmppick-finalcta">
      <div class="container container--narrow">
        <h2>Or skip the comparison and <span class="serif-italic">get a real quote</span>.</h2>
        <p>Comparing carriers is useful research — but your final price comes from your ZIP, your profile, and the carrier's actual underwriting. See the real number in 60 seconds.</p>
        <div class="cmppick-finalcta__cta">
          <ZipForm variant="band" vertical={vertical.key} eyebrow="60 seconds" heading={`Get personalized ${vertical.short.toLowerCase()} quotes`} lede="Real rates. No phone calls." />
        </div>
      </div>
    </section>
  </article>

  <style>
    .breadcrumbs { font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: var(--space-5); display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .breadcrumbs a { color: var(--color-text-muted); text-decoration: none; }
    .breadcrumbs a:hover { color: var(--c-accent); }
    .breadcrumbs__sep { opacity: 0.4; }
    .container--narrow { max-width: 720px; margin: 0 auto; padding: 0 var(--space-4); }
    .serif-italic { font-family: var(--font-serif, "Plantin", Georgia, serif); font-style: italic; font-weight: 500; color: var(--c-accent); }
    .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--c-accent); margin: 0 0 var(--space-3); padding: 4px 12px; background: var(--c-accent-soft); border-radius: 100px; }

    .cmppick-hero { padding-block: var(--space-14) var(--space-12); background: linear-gradient(180deg, var(--c-accent-soft) 0%, var(--color-white) 100%); }
    .cmppick-hero h1 { font-size: clamp(2.25rem, 5vw, 3.75rem); letter-spacing: -0.03em; line-height: 1.05; margin: 0 0 var(--space-5); color: var(--color-resolution); }
    .cmppick-hero__lede { font-size: 1.1875rem; line-height: 1.55; color: var(--color-text-strong); margin: 0; max-width: 640px; }

    .cmppick-section { padding-block: var(--space-12); background: var(--color-white); }
    .cmppick-section--alt { background: var(--color-alice); }
    .cmppick-section__title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.625rem, 3vw, 2.125rem); letter-spacing: -0.025em; line-height: 1.1; color: var(--color-resolution); margin: 0 0 var(--space-3); }
    .cmppick-section__lede { font-size: 1.0625rem; line-height: 1.55; color: var(--color-text); margin: 0 0 var(--space-8); max-width: 640px; }

    /* Popular comparisons grid */
    .cmppick-popular { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-4); }
    .cmppick-popular__card { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-5) var(--space-6); background: var(--color-white); border: 1px solid var(--color-border); border-radius: 12px; text-decoration: none; transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s; }
    .cmppick-popular__card:hover { border-color: var(--c-accent); transform: translateY(-2px); box-shadow: 0 10px 24px -8px color-mix(in srgb, var(--c-accent) 35%, transparent); }
    .cmppick-popular__count { display: inline-block; align-self: flex-start; font-family: var(--font-display); font-size: 0.6875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--c-accent); padding: 2px 8px; background: var(--c-accent-soft); border-radius: 4px; }
    .cmppick-popular__title { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--color-resolution); margin: 0; line-height: 1.25; letter-spacing: -0.015em; }
    .cmppick-popular__cta { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-display); font-weight: 700; font-size: 0.8125rem; color: var(--c-accent); margin-top: var(--space-2); }
    .cmppick-popular__card:hover .cmppick-popular__cta svg { transform: translateX(3px); }
    .cmppick-popular__cta svg { transition: transform 0.2s; }

    /* Builder grid */
    .cmppick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-8); }
    .cmppick-chip { display: block; cursor: pointer; }
    .cmppick-chip input { position: absolute; opacity: 0; pointer-events: none; }
    .cmppick-chip__inner {
      position: relative;
      display: flex; flex-direction: column; gap: 4px;
      padding: var(--space-4) var(--space-5);
      padding-right: 44px;
      background: var(--color-white);
      border: 1.5px solid var(--color-border);
      border-radius: 10px;
      transition: border-color 0.15s, background 0.15s, transform 0.15s;
    }
    .cmppick-chip__inner:hover { border-color: var(--c-accent); transform: translateY(-1px); }
    .cmppick-chip input:checked + .cmppick-chip__inner {
      border-color: var(--c-accent);
      background: var(--c-accent-soft);
    }
    .cmppick-chip__name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--color-resolution); letter-spacing: -0.005em; }
    .cmppick-chip__meta { display: flex; gap: var(--space-3); font-family: var(--font-display); font-size: 0.8125rem; color: var(--color-text-muted); font-weight: 600; }
    .cmppick-chip__score { color: var(--c-accent); }
    .cmppick-chip__check {
      position: absolute;
      top: 50%;
      right: var(--space-4);
      transform: translateY(-50%) scale(0);
      color: var(--c-accent);
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .cmppick-chip input:checked + .cmppick-chip__inner .cmppick-chip__check { transform: translateY(-50%) scale(1); }
    .cmppick-chip input:disabled + .cmppick-chip__inner { opacity: 0.4; cursor: not-allowed; }

    /* Action bar */
    .cmppick-actions {
      position: sticky;
      bottom: 16px;
      display: flex; align-items: center; justify-content: space-between;
      gap: var(--space-4); flex-wrap: wrap;
      padding: var(--space-4) var(--space-6);
      background: var(--color-resolution);
      color: var(--color-white);
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      z-index: 5;
    }
    .cmppick-actions__status {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.9375rem;
      color: rgba(255,255,255,0.85);
    }
    .cmppick-actions__count {
      display: inline-block;
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--c-accent);
      margin-right: 4px;
    }
    .cmppick-actions__hint { color: rgba(255,255,255,0.55); font-weight: 500; font-size: 0.875rem; margin-left: 4px; }
    .cmppick-actions__hint.is-hidden { display: none; }
    .cmppick-actions__btn {
      display: inline-flex; align-items: center; gap: var(--space-2);
      padding: 12px 20px;
      background: var(--c-accent);
      color: var(--color-resolution);
      border: none;
      border-radius: 100px;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 0.875rem;
      cursor: pointer;
      transition: background 0.15s, transform 0.15s, opacity 0.15s;
    }
    .cmppick-actions__btn:hover:not(:disabled) { background: var(--color-white); transform: translateY(-1px); }
    .cmppick-actions__btn:disabled { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.4); cursor: not-allowed; }

    .cmppick-finalcta { padding-block: var(--space-16); background: var(--color-white); text-align: center; }
    .cmppick-finalcta h2 { font-size: clamp(1.875rem, 4vw, 2.5rem); letter-spacing: -0.025em; line-height: 1.1; margin: 0 0 var(--space-4); color: var(--color-resolution); }
    .cmppick-finalcta p { font-size: 1.0625rem; line-height: 1.6; color: var(--color-text); margin: 0 auto var(--space-8); max-width: 600px; }
    .cmppick-finalcta__cta { max-width: 640px; margin: 0 auto; }
  </style>

  <script>
    (function () {
      const builder = document.getElementById("cmppick-builder");
      if (!builder) return;
      const basePath = builder.getAttribute("data-base-path") || "/";
      const inputs = Array.from(builder.querySelectorAll('input[name="carrier"]')) as HTMLInputElement[];
      const countEl = document.querySelector(".cmppick-actions__count")!;
      const hintEl = document.querySelector("[data-empty]")!;
      const btn = document.getElementById("cmppick-go") as HTMLButtonElement;

      function getSelected(): HTMLInputElement[] {
        return inputs.filter((i) => i.checked);
      }
      function update() {
        const sel = getSelected();
        countEl.textContent = String(sel.length);
        if (sel.length >= 2) {
          hintEl.classList.add("is-hidden");
          btn.disabled = false;
        } else {
          hintEl.classList.remove("is-hidden");
          btn.disabled = true;
        }
        // Cap at 3: disable unchecked when 3 selected
        const max = sel.length >= 3;
        inputs.forEach((i) => { if (!i.checked) i.disabled = max; });
      }
      inputs.forEach((i) => i.addEventListener("change", update));

      btn.addEventListener("click", () => {
        const sel = getSelected();
        if (sel.length < 2) return;
        // Canonical slug order: alphabetical, so /a-vs-b/ and /b-vs-a/
        // both resolve to a generated route. (getStaticPaths generates the
        // alphabetically-sorted version.)
        const slug = sel.map((i) => i.value).sort().join("-vs-");
        window.location.href = basePath + slug + "/";
      });
      update();
    })();
  </script>
</BaseLayout>
