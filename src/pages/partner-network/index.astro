---
import BaseLayout from "~/layouts/BaseLayout.astro";

/**
 * QuoteYeti Partner Network — B2B conversion landing page.
 *
 * Sells confirmed appointments and live consumer conversations to licensed
 * insurance agents and agencies. This is the *agent-facing* sales page —
 * distinct from /partners/ (the consumer-facing transparency disclosure).
 *
 * Aesthetic per blueprint: brutal-minimal. Navy + single orange accent.
 * Massive type. No stock photos, no insurance imagery, no motion.
 * Two CTAs only: Apply (primary form) and Book a Call (secondary text link).
 */

// Pricing data — kept in arrays so the tables stay maintainable
const appointmentPricing = [
  { product: "Auto Insurance Consultation", single: "$20", pack100: "$1,800", pack500: "$8,200" },
  { product: "Home Insurance Review", single: "$22", pack100: "$1,980", pack500: "$9,020" },
  { product: "Life Insurance Needs Analysis", single: "$24", pack100: "$2,160", pack500: "$9,840" },
  { product: "Medicare / Health Plan Guidance", single: "$24", pack100: "$2,160", pack500: "$9,840" },
];

const conversationPricing = [
  { product: "Auto Insurance Consultation", single: "$42", pack100: "$3,780", pack500: "$17,220" },
  { product: "Home Insurance Review", single: "$45", pack100: "$4,050", pack500: "$18,450" },
  { product: "Life Insurance Needs Analysis", single: "$48", pack100: "$4,320", pack500: "$19,680" },
  { product: "Medicare / Health Plan Guidance", single: "$48", pack100: "$4,320", pack500: "$19,680" },
];

const guaranteeRows = [
  { trigger: "Wrong number, disconnected line", action: "Replace it" },
  { trigger: "Consumer was not shopping for insurance", action: "Replace it" },
  { trigger: "Appointment no-show without notice", action: "Replace it" },
  { trigger: "Live call drops before 3 minutes", action: "Replace it" },
  { trigger: "Missing or invalid consent documentation", action: "Replace it" },
];

const steps = [
  { num: "01", title: "Define your territory", body: "State. County. Metro. Product lines. Risk appetite. You set the boundaries. We don't send you conversations you can't write." },
  { num: "02", title: "Set your weekly target", body: "3 appointments per week. 10. 30. You choose the density that matches your capacity. Pause anytime. Resume anytime." },
  { num: "03", title: "Receive your calendar", body: "Confirmed appointments arrive with full consumer context — what they're comparing, what they need, when they're available. Live conversations ring your phone with the consumer already engaged." },
  { num: "04", title: "Convert or credit", body: "Close the policy. Or tell us why the appointment didn't qualify. We schedule the replacement or return the credit. Your choice." },
];

const audience = [
  { title: "Solo producers", body: "Who want calendar density without building a marketing operation." },
  { title: "Agency principals", body: "Scaling headcount and needing predictable pipeline per producer." },
  { title: "Call center operators", body: "Who measure success in conversations per hour, not leads per dollar." },
];
---

<BaseLayout
  title="QuoteYeti Partner Network — Confirmed Insurance Appointments & Live Transfers"
  description="Wake up to confirmed appointments and live consumer conversations with people who requested an insurance conversation. You quote and close — finding, qualifying, and scheduling is ours. Pay only for conversations that happen."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Partner Network", url: "/partner-network/" },
  ]}
>
  <!--
    Netlify Forms detection placeholder. The real interactive form is below;
    this hidden static duplicate lets Netlify register the form at build time.
  -->
  <form name="partner-application" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="tel" name="phone" />
    <input type="text" name="agency" />
    <input type="text" name="license-states" />
    <input type="text" name="product-lines" />
    <input type="text" name="weekly-target" />
    <textarea name="message"></textarea>
  </form>

  <!-- ===================== HERO ===================== -->
  <section class="pn-hero">
    <div class="pn-container">
      <p class="pn-hero__eyebrow">QuoteYeti Partner Network</p>
      <h1 class="pn-hero__h1">
        Your calendar. Filled.
        <span class="pn-serif">Every morning.</span>
      </h1>
      <p class="pn-hero__lede">
        Wake up to 3, 5, 10 confirmed appointments with consumers who requested an insurance conversation yesterday. Not someday. Not "interested." Requested. Verified. Scheduled.
      </p>
      <p class="pn-hero__line">
        You quote. You advise. You close. Everything before that — finding them, qualifying them, getting them to show up — is ours.
      </p>
      <div class="pn-hero__actions">
        <a href="#apply" class="pn-btn pn-btn--primary">
          <span>Apply for partnership</span>
          <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true">
            <path d="M9 1l6 6-6 6M1 7h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#how" class="pn-btn pn-btn--text">See how it works</a>
      </div>
    </div>
  </section>

  <!-- ===================== PROBLEM ===================== -->
  <section class="pn-section pn-problem">
    <div class="pn-container pn-narrow">
      <h2 class="pn-h2">Most agencies spend 60% of the week on work that produces no revenue.</h2>
      <ul class="pn-problem__list">
        <li>Chasing cold lists</li>
        <li>Leaving voicemails that never get returned</li>
        <li>Sitting through no-shows</li>
        <li>Arguing with lead vendors about "quality"</li>
      </ul>
      <p class="pn-problem__resolve">
        We eliminate all of it. You receive only conversations that have already started. Your job begins where the hard part ends.
      </p>
    </div>
  </section>

  <!-- ===================== WHAT YOU BUY ===================== -->
  <section class="pn-section pn-buy">
    <div class="pn-container">
      <h2 class="pn-h2 pn-h2--center">What you actually buy</h2>
      <div class="pn-buy__grid">
        <div class="pn-buy__col">
          <h3 class="pn-buy__title">Confirmed appointments</h3>
          <dl class="pn-buy__dl">
            <dt>What you receive</dt>
            <dd>A time slot on your calendar. A consumer profile. A person who asked to speak with an agent today.</dd>
            <dt>What's guaranteed</dt>
            <dd>They confirmed the time. They verified their contact. They stated their need.</dd>
            <dt>What you do</dt>
            <dd>Show up prepared. Quote. Close.</dd>
            <dt>Best for</dt>
            <dd>Producers who prepare, consult, and build trust.</dd>
          </dl>
        </div>
        <div class="pn-buy__col pn-buy__col--accent">
          <h3 class="pn-buy__title">Live conversations</h3>
          <dl class="pn-buy__dl">
            <dt>What you receive</dt>
            <dd>Your phone rings. A consumer who just finished comparing options is on the line, expecting you.</dd>
            <dt>What's guaranteed</dt>
            <dd>3+ minutes of live dialogue. If they hang up early, it doesn't count.</dd>
            <dt>What you do</dt>
            <dd>Listen. Qualify. Close.</dd>
            <dt>Best for</dt>
            <dd>Producers who think fast and convert on rapport.</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section class="pn-section pn-pricing" id="pricing">
    <div class="pn-container">
      <h2 class="pn-h2 pn-h2--center">Pricing</h2>

      <div class="pn-pricing__block">
        <h3 class="pn-pricing__label">Confirmed appointments</h3>
        <div class="pn-table-wrap">
          <table class="pn-table">
            <thead>
              <tr>
                <th scope="col">Outcome</th>
                <th scope="col">Single</th>
                <th scope="col" class="pn-table__emph">100-Pack</th>
                <th scope="col" class="pn-table__emph">500-Pack</th>
              </tr>
            </thead>
            <tbody>
              {appointmentPricing.map((row) => (
                <tr>
                  <td>{row.product}</td>
                  <td>{row.single}</td>
                  <td class="pn-table__emph">{row.pack100}</td>
                  <td class="pn-table__emph">{row.pack500}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="pn-pricing__block">
        <h3 class="pn-pricing__label">Live conversations</h3>
        <div class="pn-table-wrap">
          <table class="pn-table">
            <thead>
              <tr>
                <th scope="col">Outcome</th>
                <th scope="col">Single</th>
                <th scope="col" class="pn-table__emph">100-Pack</th>
                <th scope="col" class="pn-table__emph">500-Pack</th>
              </tr>
            </thead>
            <tbody>
              {conversationPricing.map((row) => (
                <tr>
                  <td>{row.product}</td>
                  <td>{row.single}</td>
                  <td class="pn-table__emph">{row.pack100}</td>
                  <td class="pn-table__emph">{row.pack500}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="pn-pricing__note">
        Buy what you need. Scale when your numbers prove it. No minimums. No contracts on self-serve.
      </p>
    </div>
  </section>

  <!-- ===================== GUARANTEE ===================== -->
  <section class="pn-section pn-guarantee">
    <div class="pn-container pn-narrow">
      <p class="pn-guarantee__eyebrow">The QuoteYeti guarantee</p>
      <h2 class="pn-h2">You pay only for conversations that actually happen.</h2>
      <dl class="pn-guarantee__list">
        {guaranteeRows.map((row) => (
          <div class="pn-guarantee__row">
            <dt>{row.trigger}</dt>
            <dd>{row.action}</dd>
          </div>
        ))}
      </dl>
      <p class="pn-guarantee__close">
        No cap. No window. No argument. If the conversation doesn't occur, you don't pay.
      </p>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section class="pn-section pn-how" id="how">
    <div class="pn-container">
      <h2 class="pn-h2 pn-h2--center">How it works</h2>
      <ol class="pn-how__steps">
        {steps.map((step) => (
          <li class="pn-how__step">
            <span class="pn-how__num">{step.num}</span>
            <h3 class="pn-how__title">{step.title}</h3>
            <p class="pn-how__body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== WHO FOR ===================== -->
  <section class="pn-section pn-who">
    <div class="pn-container">
      <h2 class="pn-h2 pn-h2--center">Who this is for</h2>
      <div class="pn-who__grid">
        {audience.map((a) => (
          <div class="pn-who__card">
            <h3 class="pn-who__title">{a.title}</h3>
            <p class="pn-who__body">{a.body}</p>
          </div>
        ))}
      </div>
      <p class="pn-who__close">
        We verify licenses. We monitor show rates. We terminate partners who waste consumer time. This is a performance relationship, not a vendor transaction.
      </p>
    </div>
  </section>

  <!-- ===================== COMMITMENTS ===================== -->
  <!--
    NOTE: This section deliberately does NOT contain customer testimonials.
    QuoteYeti's editorial standard is no invented claims and no fabricated
    statistics — that standard applies to the sales pages too. When real,
    attributable partner results exist (with permission to publish), they
    belong here. Until then, we make our commitments explicit rather than
    inventing social proof. To add real testimonials later, restore a
    `.pn-proof__quote <figure>` block per the styles still defined below.
  -->
  <section class="pn-section pn-proof">
    <div class="pn-container pn-narrow">
      <p class="pn-proof__eyebrow">What we commit to</p>
      <h2 class="pn-h2">No vanity metrics. Just terms we'll put in writing.</h2>
      <p class="pn-proof__lede">
        We're a new network, and we'd rather earn your trust with guarantees we honor than with testimonials you can't verify. Here's what every partnership is built on:
      </p>
      <ul class="pn-commitments">
        <li class="pn-commitment">
          <span class="pn-commitment__num">01</span>
          <div>
            <h3 class="pn-commitment__title">You pay only for conversations that happen.</h3>
            <p class="pn-commitment__body">Every scenario in our guarantee above is replaced or credited, no window and no cap. If the conversation doesn't occur, it's not billed.</p>
          </div>
        </li>
        <li class="pn-commitment">
          <span class="pn-commitment__num">02</span>
          <div>
            <h3 class="pn-commitment__title">We don't oversell a territory.</h3>
            <p class="pn-commitment__body">We cap how many partners we route to in any given area so the consumers you speak with haven't already been called five times today.</p>
          </div>
        </li>
        <li class="pn-commitment">
          <span class="pn-commitment__num">03</span>
          <div>
            <h3 class="pn-commitment__title">Consent is documented on every contact.</h3>
            <p class="pn-commitment__body">Every consumer we route to you opted in to an insurance conversation. If consent documentation is missing or invalid, the contact is replaced.</p>
          </div>
        </li>
        <li class="pn-commitment">
          <span class="pn-commitment__num">04</span>
          <div>
            <h3 class="pn-commitment__title">No contracts on self-serve.</h3>
            <p class="pn-commitment__body">Buy what you need, scale when your own numbers prove it out, pause anytime. We earn the next order by delivering on the last one.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ===================== APPLY / FINAL CTA ===================== -->
  <section class="pn-section pn-apply" id="apply">
    <div class="pn-container pn-narrow">
      <h2 class="pn-h2 pn-h2--center">Stop prospecting. Start quoting.</h2>
      <p class="pn-apply__lede">
        Your next appointment is already scheduled. The only question is whether it's on your calendar or your competitor's.
      </p>

      <form
        class="pn-form"
        name="partner-application"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        action="/partner-network/thanks/"
      >
        <input type="hidden" name="form-name" value="partner-application" />
        <p class="pn-form__hp" hidden>
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="pn-form__row">
          <div class="pn-field">
            <label for="pn-name">Full name</label>
            <input id="pn-name" type="text" name="name" required autocomplete="name" />
          </div>
          <div class="pn-field">
            <label for="pn-agency">Agency / business name</label>
            <input id="pn-agency" type="text" name="agency" autocomplete="organization" />
          </div>
        </div>

        <div class="pn-form__row">
          <div class="pn-field">
            <label for="pn-email">Email</label>
            <input id="pn-email" type="email" name="email" required autocomplete="email" />
          </div>
          <div class="pn-field">
            <label for="pn-phone">Phone</label>
            <input id="pn-phone" type="tel" name="phone" required autocomplete="tel" />
          </div>
        </div>

        <div class="pn-form__row">
          <div class="pn-field">
            <label for="pn-states">Licensed states</label>
            <input id="pn-states" type="text" name="license-states" placeholder="e.g. TX, OK, NM" />
          </div>
          <div class="pn-field">
            <label for="pn-lines">Product lines</label>
            <input id="pn-lines" type="text" name="product-lines" placeholder="e.g. Auto, Home, Medicare" />
          </div>
        </div>

        <div class="pn-field">
          <label for="pn-target">Weekly volume target</label>
          <select id="pn-target" name="weekly-target">
            <option value="">Select a range…</option>
            <option value="1-5">1–5 per week (testing)</option>
            <option value="6-15">6–15 per week</option>
            <option value="16-30">16–30 per week</option>
            <option value="30+">30+ per week (team)</option>
          </select>
        </div>

        <div class="pn-field">
          <label for="pn-message">Anything else? <span class="pn-field__optional">(optional)</span></label>
          <textarea id="pn-message" name="message" rows="3" placeholder="Territory specifics, current volume, questions…"></textarea>
        </div>

        <button type="submit" class="pn-btn pn-btn--primary pn-btn--full">
          <span>Apply for partnership</span>
          <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true">
            <path d="M9 1l6 6-6 6M1 7h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <p class="pn-form__alt">
          Prefer to talk first? <a href="/contact/">Book a 10-minute call</a> to review your territory and volume targets.
        </p>
      </form>

      <p class="pn-apply__tag">QuoteYeti Partner Network. Conversations delivered. Revenue yours.</p>
    </div>
  </section>

  <style>
    /* ============================================================
       QuoteYeti Partner Network — brutal-minimal B2B landing.
       Navy dominant, single orange accent, massive confident type,
       no imagery, no motion. Reading sections capped at 720px.
       ============================================================ */

    .pn-container {
      max-width: 1080px;
      margin-inline: auto;
      padding-inline: var(--space-6);
    }
    .pn-narrow { max-width: 720px; }

    .pn-section { padding-block: clamp(3.5rem, 8vw, 6.5rem); }

    .pn-h2 {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.12;
      color: var(--color-resolution);
      margin: 0 0 var(--space-8);
      max-width: 20ch;
    }
    .pn-h2--center {
      margin-inline: auto;
      text-align: center;
      max-width: 24ch;
    }
    .pn-serif {
      font-family: var(--font-serif);
      font-style: italic;
      font-weight: 400;
    }

    /* ---------- HERO ---------- */
    .pn-hero {
      background: var(--color-resolution);
      color: var(--color-white);
      padding-block: clamp(4.5rem, 12vw, 9rem);
      position: relative;
      overflow: hidden;
    }
    .pn-hero::before {
      /* faint topographic grain so it isn't a flat navy slab */
      content: "";
      position: absolute; inset: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.04) 1px, transparent 0);
      background-size: 22px 22px;
      pointer-events: none;
    }
    .pn-hero__eyebrow {
      position: relative;
      font-family: var(--font-display);
      font-size: 0.8125rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--color-orange);
      margin: 0 0 var(--space-6);
    }
    .pn-hero__h1 {
      position: relative;
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 8vw, 5rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 0.98;
      margin: 0 0 var(--space-8);
      color: var(--color-white);
    }
    .pn-hero__h1 .pn-serif { color: var(--color-malibu); display: block; }
    .pn-hero__lede {
      position: relative;
      font-family: var(--font-display);
      font-size: clamp(1.125rem, 2vw, 1.4375rem);
      line-height: 1.5;
      color: rgba(255,255,255,0.92);
      max-width: 40ch;
      margin: 0 0 var(--space-6);
    }
    .pn-hero__line {
      position: relative;
      font-family: var(--font-display);
      font-size: clamp(1rem, 1.5vw, 1.1875rem);
      line-height: 1.6;
      color: rgba(255,255,255,0.66);
      max-width: 46ch;
      margin: 0 0 var(--space-10);
    }
    .pn-hero__actions {
      position: relative;
      display: flex;
      align-items: center;
      gap: var(--space-6);
      flex-wrap: wrap;
    }

    /* ---------- BUTTONS ---------- */
    .pn-btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.0625rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
    }
    .pn-btn svg { transition: transform var(--transition); }
    .pn-btn--primary {
      background: var(--color-orange);
      color: var(--color-white);
      padding: var(--space-4) var(--space-8);
      border-radius: var(--radius-pill);
      box-shadow: 0 6px 16px rgba(229, 90, 43, 0.28);
    }
    .pn-btn--primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(229, 90, 43, 0.36);
    }
    .pn-btn--primary:hover svg { transform: translateX(4px); }
    .pn-btn--text {
      color: var(--color-white);
      font-weight: 600;
      border-bottom: 1px solid rgba(255,255,255,0.4);
      padding-bottom: 2px;
    }
    .pn-btn--text:hover { border-bottom-color: var(--color-malibu); color: var(--color-malibu); }
    .pn-btn--full { width: 100%; justify-content: center; padding-block: var(--space-5); font-size: 1.125rem; }

    /* ---------- PROBLEM ---------- */
    .pn-problem { background: var(--color-white); }
    .pn-problem__list {
      list-style: none;
      margin: 0 0 var(--space-8);
      padding: 0;
      display: grid;
      gap: var(--space-3);
    }
    .pn-problem__list li {
      font-family: var(--font-display);
      font-size: 1.125rem;
      color: var(--color-text-strong);
      padding-left: var(--space-6);
      position: relative;
      line-height: 1.5;
    }
    .pn-problem__list li::before {
      content: "—";
      position: absolute;
      left: 0;
      color: var(--color-orange);
      font-weight: 700;
    }
    .pn-problem__resolve {
      font-family: var(--font-display);
      font-size: clamp(1.1875rem, 2vw, 1.5rem);
      font-weight: 600;
      line-height: 1.4;
      color: var(--color-resolution);
      margin: 0;
      max-width: 46ch;
    }

    /* ---------- WHAT YOU BUY ---------- */
    .pn-buy { background: var(--color-alice); }
    .pn-buy__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
    .pn-buy__col {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-9) var(--space-8);
    }
    .pn-buy__col--accent {
      border-color: var(--color-resolution);
      border-width: 2px;
      box-shadow: 0 12px 32px -12px rgba(30, 42, 74, 0.18);
    }
    .pn-buy__title {
      font-family: var(--font-display);
      font-size: 1.375rem;
      font-weight: 700;
      color: var(--color-resolution);
      margin: 0 0 var(--space-6);
      letter-spacing: -0.01em;
    }
    .pn-buy__dl { margin: 0; }
    .pn-buy__dl dt {
      font-family: var(--font-display);
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--color-orange);
      margin-bottom: var(--space-2);
    }
    .pn-buy__dl dd {
      margin: 0 0 var(--space-5);
      font-family: var(--font-display);
      font-size: 1rem;
      line-height: 1.55;
      color: var(--color-text);
    }
    .pn-buy__dl dd:last-child { margin-bottom: 0; }

    /* ---------- PRICING ---------- */
    .pn-pricing { background: var(--color-white); }
    .pn-pricing__block { margin-bottom: var(--space-12); }
    .pn-pricing__block:last-of-type { margin-bottom: var(--space-8); }
    .pn-pricing__label {
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
