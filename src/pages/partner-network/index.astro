  <script>
    // Interactive pricing configurator — vanilla, no deps.
    const root = document.querySelector(".pn-config");
    if (root) {
      const data = JSON.parse(root.getAttribute("data-pricing"));
      const state = { product: "appointment", line: "auto", pack: "single" };

      const linePills = root.querySelector("[data-line-pills]");
      const packPills = root.querySelector("[data-pack-pills]");
      const sumLabel = root.querySelector("[data-sum-label]");
      const sumTotal = root.querySelector("[data-sum-total]");
      const sumPer = root.querySelector("[data-sum-per]");
      const sumDetail = root.querySelector("[data-sum-detail]");
      const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");

      function renderLinePills() {
        const lines = data.products[state.product].lines;
        linePills.innerHTML = "";
        lines.forEach((ln) => {
          const b = document.createElement("button");
          b.className = "pn-pill" + (ln.id === state.line ? " is-active" : "");
          b.setAttribute("role", "radio");
          b.setAttribute("aria-checked", String(ln.id === state.line));
          b.textContent = ln.name.replace(/ (insurance|plan).*/i, "").replace(/ consultation| review| needs analysis| guidance/i, "");
          b.dataset.line = ln.id;
          b.addEventListener("click", () => { state.line = ln.id; renderLinePills(); update(); });
          linePills.appendChild(b);
        });
      }

      function renderPackPills() {
        packPills.innerHTML = "";
        data.packs.forEach((pk) => {
          const b = document.createElement("button");
          b.className = "pn-toggle__btn" + (pk.id === state.pack ? " is-active" : "");
          b.setAttribute("role", "radio");
          b.setAttribute("aria-checked", String(pk.id === state.pack));
          b.innerHTML = pk.label + (pk.discount > 0 ? `<span class="pn-toggle__save">save ${Math.round(pk.discount*100)}%</span>` : "");
          b.dataset.pack = pk.id;
          b.addEventListener("click", () => { state.pack = pk.id; renderPackPills(); update(); });
          packPills.appendChild(b);
        });
      }

      function update() {
        const prod = data.products[state.product];
        const line = prod.lines.find((l) => l.id === state.line) || prod.lines[0];
        const pack = data.packs.find((p) => p.id === state.pack);
        const unit = line.single * (1 - pack.discount);
        const total = unit * pack.qty;
        const noun = state.product === "appointment" ? "appointment" : "live conversation";

        // Always headline the PER-LEAD price; volume tiers lower it via discount.
        sumTotal.textContent = fmt(unit);
        sumPer.textContent = "per lead";

        if (pack.qty === 1) {
          sumDetail.textContent = `${fmt(unit)} per ${noun} · fund any amount from $${data.account.minFunding}`;
        } else {
          sumDetail.textContent = `${fmt(unit)} per lead at ${pack.qty}+ (${Math.round(pack.discount*100)}% volume discount) · ${fmt(total)} buys ${pack.qty}`;
        }
        sumLabel.textContent = `${prod.label} · ${line.name.split(" ")[0]} · ${pack.label}`;
      }

      root.querySelectorAll("[data-product]").forEach((btn) => {
        btn.addEventListener("click", () => {
          state.product = btn.dataset.product;
          root.querySelectorAll("[data-product]").forEach((b) => {
            const on = b === btn;
            b.classList.toggle("is-active", on);
            b.setAttribute("aria-checked", String(on));
          });
          renderLinePills();
          update();
        });
      });

      renderLinePills();
      renderPackPills();
      update();
    }
  </script>

