---
import PlatformLayout from "~/layouts/PlatformLayout.astro";
import FootprintDivider from "~/components/editorial/FootprintDivider.astro";

/**
 * QuoteYeti Partner Network — B2B self-serve lead platform.
 * Redesigned to feel like a product you buy from, not a brochure you read.
 * Consumer megamenu (nav.ts) is untouched. No fabricated testimonials.
 */

const PRODUCTS = {
  appointment: {
    label: "Confirmed appointment",
    blurb: "A scheduled slot with a consumer who asked to speak with an agent.",
    lines: [
      { id: "auto",     name: "Auto insurance consultation",     single: 20 },
      { id: "home",     name: "Home insurance review",           single: 22 },
      { id: "life",     name: "Life insurance needs analysis",   single: 24 },
      { id: "medicare", name: "Medicare / health plan guidance", single: 24 },
    ],
  },
  live: {
    label: "Live conversation",
    blurb: "A warm transfer — your phone rings with the consumer already engaged.",
    lines: [
      { id: "auto",     name: "Auto insurance consultation",     single: 42 },
      { id: "home",     name: "Home insurance review",           single: 45 },
      { id: "life",     name: "Life insurance needs analysis",   single: 48 },
      { id: "medicare", name: "Medicare / health plan guidance", single: 48 },
    ],
  },
};

const PACKS = [
  { id: "single", label: "Per lead",  qty: 1,   discount: 0 },
  { id: "p100",   label: "100 leads", qty: 100, discount: 0.10 },
  { id: "p500",   label: "500 leads", qty: 500, discount: 0.18 },
];

// Account terms — the self-serve funding model
const ACCOUNT = {
  minFunding: 250,
  newAccountBonus: 10,   // bonus leads on first funding
  referralBonus: 10,     // free leads per referred agent
};

const pricingData = JSON.stringify({ products: PRODUCTS, packs: PACKS, account: ACCOUNT });

const steps = [
  { num: "01", title: "Tell us where you write", body: "State, county, metro, product lines, risk appetite. We only send conversations you can actually close — no out-of-area noise, no lines you don't carry." },
  { num: "02", title: "Set your weekly pace", body: "3 a week or 30. You set the volume, you pause when your pipeline's full, you resume when it's not. Nobody upsells you past your capacity." },
  { num: "03", title: "Your phone starts ringing", body: "Appointments land on your calendar with full context. Live transfers ring through with the consumer already on the line — not a name on a list you have to chase." },
  { num: "04", title: "Close it, or it's free", body: "Quote and close. If a conversation didn't qualify, flag it — we replace it or credit it. You never pay for a lead that wasn't real." },
];

const guaranteeRows = [
  { trigger: "Wrong number or disconnected line", action: "Replaced" },
  { trigger: "Consumer wasn't shopping for insurance", action: "Replaced" },
  { trigger: "Appointment no-show without notice", action: "Replaced" },
  { trigger: "Live call drops before 3 minutes", action: "Replaced" },
  { trigger: "Missing or invalid consent documentation", action: "Replaced" },
];

const audience = [
  { tag: "Solo", title: "Solo producers", body: "You want a full calendar without becoming a part-time marketer to get one." },
  { tag: "Agency", title: "Agency principals", body: "You need pipeline you can forecast per producer — not a lead bill that swings every month." },
  { tag: "Center", title: "Call center operators", body: "You live and die by conversations per hour, and you're done paying for dead air." },
];

const commitments = [
  { num: "01", title: "Bad leads aren't yours to eat.", body: "Wrong number, never opted in, no-show, dropped call — every one is replaced or credited. No window, no cap, no argument. The risk is ours, not yours." },
  { num: "02", title: "Your competitor isn't getting the same lead.", body: "We cap how many partners we route to per area. The consumer you call hasn't already been dialed five times this afternoon." },
  { num: "03", title: "Every contact opted in. On the record.", body: "Documented consent on each lead, or it's replaced. You're not cold-calling strangers — you're calling people who raised their hand." },
  { num: "04", title: "You're never locked in.", body: "No contract on self-serve. Fund what you want, pause anytime, scale when your own numbers say so. We re-earn it every single order." },
];

// White-label localized lead platform — the productized "own your leads" offer
const whiteLabel = {
  setupFee: 250,
  monthly: 250,
  leadCredit: 100,
  buildDays: 7,
  features: [
    { title: "Your brand, not ours", body: "A lead platform built around your name, your city, and the verticals you actually write — modeled on what powers QuoteYeti." },
    { title: "Live in 7 days", body: "We design it, build it, and host it. You're taking real leads inside a week, not waiting on a dev shop for a quarter." },
    { title: "You own every lead", body: "Connected straight to your CRM. Every lead that comes in is yours to keep — forever. No sharing, no renting, no middleman." },
    { title: "Marketing included", body: "Fully hosted with SEO and digital marketing handled every month. The pipeline keeps filling without you touching it." },
  ],
};
---

<PlatformLayout
  title="QuoteYeti Partner Network — Confirmed Insurance Appointments & Live Transfers"
  description="Buy confirmed insurance appointments and live consumer transfers. Self-serve, no contracts, pay only for conversations that happen."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Partner Network", url: "/partner-network/" },
  ]}
>
  <form name="partner-application" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" /><input type="email" name="email" />
    <input type="tel" name="phone" /><input type="text" name="agency" />
    <input type="text" name="license-states" /><input type="text" name="product-lines" />
    <input type="text" name="weekly-target" /><textarea name="message"></textarea>
  </form>

  <!-- ===================== HERO ===================== -->
  <section class="pn-hero">
    <span class="pn-hero__paw" aria-hidden="true">
      <svg viewBox="0 0 54.6 83.1" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M42.5,16.9c1.4-2,3.8-2.7,5.4-1.6c1.6,1.1,1.8,3.6,0.4,5.6c-1.4,2-3.8,2.7-5.4,1.6S41.1,18.9,42.5,16.9z"/>
        <path d="M32.6,11.9c1-2.8,3.5-4.4,5.8-3.7c2.2,0.8,3.3,3.7,2.3,6.4c-1,2.8-3.5,4.4-5.8,3.7C32.6,17.6,31.7,14.7,32.6,11.9z"/>
        <path d="M26,3.7c2.6,0.2,4.6,2.9,4.4,6.2s-2.5,5.8-5.1,5.6s-4.6-2.9-4.4-6.2C21.1,6.1,23.3,3.6,26,3.7z"/>
        <path d="M0.4,12.6C-1.1,6.9,1.5,1.4,6,0.2c4.6-1.2,9.5,2.5,10.9,8.2c1.5,5.7-1.1,11.2-5.6,12.4S1.8,18.3,0.4,12.6z"/>
        <path d="M49.6,47.1c-0.5,3.5-1.6,6.8-3,10.1c-2.1,5.1-4.6,9.9-7.8,14.3c-2.4,3.4-5.1,6.5-8.6,8.8c-1.3,0.9-8.8,5-15.8,1.3c-4.5-2.4-5.2-7.5-2.9-10.7c1.3-1.9,2.9-3.5,4.4-5.1c7.1-7.4,8.8-14.4,5.5-18.3c-1.9-2.2-4.3-3.7-7-4.8c-1.4-0.6-2.8-1.3-3.8-2.5c-2.3-2.6-2.5-5.7-1.8-8.9s2.3-5.9,4.5-8.3c2-2.2,4.5-3.7,7.4-4.3c5.4-1,10.6,0,15.6,2.3c3.2,1.5,5.9,3.6,8.4,6.1c2.7,2.7,4.5,5.9,5.1,9.7C50.4,40.2,50.1,43.7,49.6,47.1z"/>
        <path d="M53.2,28.2c-1.5,1.3-3.6,1.4-4.6,0.2c-1.1-1.2-0.7-3.2,0.8-4.5s3.6-1.4,4.6-0.2S54.7,26.9,53.2,28.2z"/>
      </svg>
    </span>
    <div class="pn-wrap pn-hero__grid">
      <div class="pn-hero__copy">
        <span class="pn-badge">
          <span class="pn-badge__dot" aria-hidden="true"></span>
          Self-serve lead platform for licensed agents
        </span>
        <h1 class="pn-hero__h1">Spend your day closing. Not chasing.</h1>
        <p class="pn-hero__lede">
          Every other lead source sells you a list and wishes you luck. We hand you people who already raised their hand and asked to talk — booked on your calendar or live on your line.
        </p>
        <p class="pn-hero__guarantee">
          <span class="pn-hero__guarantee-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          And if a conversation doesn't actually happen? <strong>You don't pay for it.</strong> Period.
        </p>
        <div class="pn-hero__actions">
          <a href="#pricing" class="pn-btn pn-btn--primary pn-btn--lg">
            <span>See what a lead costs</span>
            <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true"><path d="M9 1l6 6-6 6M1 7h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#apply" class="pn-btn pn-btn--ghost pn-btn--lg">Fund an account</a>
        </div>
        <ul class="pn-hero__trust">
          <li>License-verified partners only</li>
          <li>Territory caps enforced</li>
          <li>Documented consent on every lead</li>
        </ul>
      </div>

      <aside class="pn-preview" aria-label="Example partner dashboard">
        <div class="pn-preview__bar">
          <span class="pn-preview__dot"></span><span class="pn-preview__dot"></span><span class="pn-preview__dot"></span>
          <span class="pn-preview__title">Today · Houston metro</span>
        </div>
        <div class="pn-preview__body">
          <div class="pn-preview__stat">
            <span class="pn-preview__num">7</span>
            <span class="pn-preview__label">confirmed appointments<br>on your calendar today</span>
          </div>
          <ul class="pn-preview__feed">
            <li><span class="pn-preview__time">9:00a</span> Auto · clean record <span class="pn-preview__tag">confirmed</span></li>
            <li><span class="pn-preview__time">10:30a</span> Home · new purchase <span class="pn-preview__tag">confirmed</span></li>
            <li><span class="pn-preview__time">1:15p</span> Medicare · turning 65 <span class="pn-preview__tag pn-preview__tag--live">live now</span></li>
            <li><span class="pn-preview__time">3:00p</span> Auto · multi-vehicle <span class="pn-preview__tag">confirmed</span></li>
          </ul>
          <p class="pn-preview__foot">Illustrative dashboard — not live data.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== STAT STRIP ===================== -->
  <section class="pn-stats">
    <div class="pn-wrap pn-stats__grid">
      <div class="pn-stat"><span class="pn-stat__num">$250</span><span class="pn-stat__label">minimum to fund an account</span></div>
      <div class="pn-stat"><span class="pn-stat__num">+10</span><span class="pn-stat__label">bonus leads on new accounts</span></div>
      <div class="pn-stat"><span class="pn-stat__num">+10</span><span class="pn-stat__label">free leads per agent you refer</span></div>
      <div class="pn-stat"><span class="pn-stat__num">$0</span><span class="pn-stat__label">paid for conversations that don't happen</span></div>
    </div>
  </section>

  <!-- ===================== THE DIFFERENCE (friction contrast) ===================== -->
  <section class="pn-section pn-diff" id="why">
    <div class="pn-wrap">
      <header class="pn-section__head pn-section__head--center">
        <p class="pn-eyebrow">Why this is different</p>
        <h2 class="pn-h2">You already know what bad leads feel like.</h2>
        <p class="pn-section__sub">You've bought leads before. You know the drill. Here's the drill — and here's what we do instead.</p>
      </header>
      <div class="pn-diff__grid">
        <div class="pn-diff__col pn-diff__col--bad">
          <p class="pn-diff__label">Every other lead vendor</p>
          <ul class="pn-diff__list">
            <li>Sells the same "exclusive" lead to four other agents</li>
            <li>Bills you whether the number connects or not</li>
            <li>Hands you a name and a prayer — you do all the chasing</li>
            <li>Locks you into a monthly spend you can't pause</li>
            <li>Argues every time you flag a junk lead</li>
          </ul>
        </div>
        <div class="pn-diff__col pn-diff__col--good">
          <p class="pn-diff__label">QuoteYeti Partner Network</p>
          <ul class="pn-diff__list">
            <li>Caps partners per territory so the lead stays fresh</li>
            <li>Bills you only when a real conversation happens</li>
            <li>Books the appointment or transfers the live call to you</li>
            <li>Self-serve, no contract, pause the second you're full</li>
            <li>Replaces or credits junk on sight — no argument</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHAT YOU BUY ===================== -->
  <section class="pn-section" id="products">
    <div class="pn-wrap">
      <header class="pn-section__head pn-section__head--center">
        <p class="pn-eyebrow">Two ways to buy</p>
        <h2 class="pn-h2">However you close best, we've got the lead for it.</h2>
      </header>
      <div class="pn-buy">
        <article class="pn-buy__card">
          <div class="pn-buy__head">
            <h3 class="pn-buy__title">Confirmed appointments</h3>
            <span class="pn-buy__from"><span class="pn-buy__from-label">from</span>$20<span class="pn-buy__from-unit">/lead</span></span>
          </div>
          <p class="pn-buy__blurb">A time slot on your calendar with a consumer who asked to speak with an agent today.</p>
          <ul class="pn-buy__list">
            <li><strong>You receive</strong> a scheduled slot, a consumer profile, and verified contact.</li>
            <li><strong>Guaranteed</strong> they confirmed the time and stated their need.</li>
            <li><strong>You do</strong> show up prepared, quote, close.</li>
            <li><strong>Best for</strong> producers who prepare, consult, and build trust.</li>
          </ul>
        </article>
        <article class="pn-buy__card pn-buy__card--accent">
          <div class="pn-buy__head">
            <h3 class="pn-buy__title">Live conversations</h3>
            <span class="pn-buy__from"><span class="pn-buy__from-label">from</span>$42<span class="pn-buy__from-unit">/lead</span></span>
          </div>
          <p class="pn-buy__blurb">Your phone rings. A consumer who just finished comparing options is on the line, expecting you.</p>
          <ul class="pn-buy__list">
            <li><strong>You receive</strong> a warm transfer, consumer already engaged.</li>
            <li><strong>Guaranteed</strong> 3+ minutes of live dialogue, or it doesn't count.</li>
            <li><strong>You do</strong> listen, qualify, close.</li>
            <li><strong>Best for</strong> producers who think fast and convert on rapport.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING CONFIGURATOR (the self-serve core) ===================== -->
  <section class="pn-section pn-pricing" id="pricing">
    <div class="pn-wrap">
      <header class="pn-section__head pn-section__head--center">
        <p class="pn-eyebrow">Pricing</p>
        <h2 class="pn-h2">Start with $250. Get 10 leads free. Refer an agent, get 10 more.</h2>
        <p class="pn-section__sub">Fund your account once, then draw down per lead — no subscription, no monthly minimum. The configurator below shows your real per-lead cost.</p>
      </header>

      <div class="pn-config" data-pricing={pricingData}>
        <div class="pn-config__controls">
          <div class="pn-config__group">
            <span class="pn-config__legend">Product type</span>
            <div class="pn-toggle" role="radiogroup" aria-label="Product type">
              <button class="pn-toggle__btn is-active" data-product="appointment" role="radio" aria-checked="true">Confirmed appointments</button>
              <button class="pn-toggle__btn" data-product="live" role="radio" aria-checked="false">Live conversations</button>
            </div>
          </div>

          <div class="pn-config__group">
            <span class="pn-config__legend">Insurance line</span>
            <div class="pn-pills" role="radiogroup" aria-label="Insurance line" data-line-pills></div>
          </div>

          <div class="pn-config__group">
            <span class="pn-config__legend">Volume</span>
            <div class="pn-toggle" role="radiogroup" aria-label="Volume" data-pack-pills></div>
          </div>
        </div>

        <div class="pn-config__summary" aria-live="polite">
          <p class="pn-config__sumlabel" data-sum-label>Confirmed appointment · Auto · Per lead</p>
          <div class="pn-config__price">
            <span class="pn-config__amount" data-sum-total>$20</span>
            <span class="pn-config__per" data-sum-per>per lead</span>
          </div>
          <p class="pn-config__detail" data-sum-detail>$20 per lead · fund any amount from $250</p>
          <div class="pn-config__bonus" data-sum-bonus>
            <span class="pn-config__bonus-icon" aria-hidden="true">★</span>
            <span>Your first $250 comes with <strong>10 bonus leads</strong> — that's real money back before you've closed a thing.</span>
          </div>
          <a href="#apply" class="pn-btn pn-btn--primary pn-btn--full pn-btn--lg">
            <span>Fund my account</span>
            <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true"><path d="M9 1l6 6-6 6M1 7h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <p class="pn-config__fineprint">$250 minimum funding. Self-serve checkout opens after license verification.</p>
        </div>
      </div>

      <!-- bonus / referral callout -->
      <div class="pn-bonuses">
        <div class="pn-bonus">
          <span class="pn-bonus__num">+10</span>
          <div>
            <h3 class="pn-bonus__title">Fund $250, get 10 leads free</h3>
            <p class="pn-bonus__body">Your first funding lands 10 bonus leads on top — so your money goes further the moment you start, not after some threshold.</p>
          </div>
        </div>
        <div class="pn-bonus">
          <span class="pn-bonus__num">+10</span>
          <div>
            <h3 class="pn-bonus__title">Refer an agent, get 10 more</h3>
            <p class="pn-bonus__body">Every agent you send who funds an account drops 10 free leads in your balance. <span class="pn-bonus__web">Web-exclusive — claimable only here, never over the phone.</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="pn-wrap"><FootprintDivider width="medium" margin="tight" /></div>

  <!-- ===================== HOW IT WORKS ===================== -->
  <section class="pn-section pn-how" id="how">
    <div class="pn-wrap">
      <header class="pn-section__head pn-section__head--center">
        <p class="pn-eyebrow">How it works</p>
        <h2 class="pn-h2">From signup to a ringing phone — fast.</h2>
      </header>
      <ol class="pn-how__steps pn-how__steps--timeline">
        {steps.map((step) => (
          <li class="pn-how__step">
            <span class="pn-how__num">{step.num}</span>
            <h3 class="pn-how__title">{step.title}</h3>
            <p class="pn-how__body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== GUARANTEE ===================== -->
  <section class="pn-section pn-guarantee" id="guarantee">
    <div class="pn-wrap pn-guarantee__grid">
      <div class="pn-guarantee__intro">
        <p class="pn-eyebrow pn-eyebrow--light">The guarantee</p>
        <h2 class="pn-h2 pn-h2--light">You pay only for conversations that actually happen.</h2>
        <p class="pn-guarantee__close">No cap. No window. No argument. If the conversation doesn't occur, you don't pay.</p>
      </div>
      <dl class="pn-guarantee__list">
        {guaranteeRows.map((row) => (
          <div class="pn-guarantee__row">
            <dt>{row.trigger}</dt>
            <dd>{row.action}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ===================== WHITE LABEL PLATFORM ===================== -->
  <section class="pn-section pn-wl" id="white-label">
    <div class="pn-wrap pn-wl__grid">
      <div class="pn-wl__copy">
        <p class="pn-eyebrow pn-eyebrow--light">Want to own the leads outright?</p>
        <h2 class="pn-h2 pn-h2--light">Your own lead platform. Your brand. Your city. In 7 days.</h2>
        <p class="pn-wl__lede">
          Buying leads is renting. This is owning. We build you a localized lead platform — same engine behind QuoteYeti — wrapped in your name and tuned to your market. Once it's wired to your CRM, every lead that comes through is yours to keep. Forever.
        </p>
        <ul class="pn-wl__features">
          {whiteLabel.features.map((f) => (
            <li class="pn-wl__feature">
              <span class="pn-wl__check" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <h3 class="pn-wl__feature-title">{f.title}</h3>
                <p class="pn-wl__feature-body">{f.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <aside class="pn-wl__card">
        <p class="pn-wl__card-eyebrow">White-label platform</p>
        <div class="pn-wl__price">
          <span class="pn-wl__price-amount">${whiteLabel.monthly}</span>
          <span class="pn-wl__price-per">/ month</span>
        </div>
        <p class="pn-wl__price-note">Fully hosted · SEO &amp; digital marketing included</p>
        <ul class="pn-wl__terms">
          <li><span>Setup fee</span><strong>${whiteLabel.setupFee} one-time</strong></li>
          <li><span>Includes</span><strong>${whiteLabel.leadCredit} in exclusive web leads</strong></li>
          <li><span>Live in</span><strong>{whiteLabel.buildDays} days</strong></li>
          <li><span>Lead ownership</span><strong>100% yours</strong></li>
        </ul>
        <a href="#apply" class="pn-btn pn-btn--primary pn-btn--full pn-btn--lg">
          <span>Build my platform</span>
          <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true"><path d="M9 1l6 6-6 6M1 7h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <p class="pn-wl__card-foot">Tell us your city and verticals in the form below — we'll scope it on the intro call.</p>
      </aside>
    </div>
  </section>

  <!-- ===================== WHO FOR ===================== -->
  <section class="pn-section" id="who">
    <div class="pn-wrap">
      <header class="pn-section__head pn-section__head--center">
        <p class="pn-eyebrow">Who it's for</p>
        <h2 class="pn-h2">Built for producers who'd rather be closing.</h2>
      </header>
      <div class="pn-who">
        {audience.map((a) => (
          <article class="pn-who__card">
            <span class="pn-who__tag">{a.tag}</span>
            <h3 class="pn-who__title">{a.title}</h3>
            <p class="pn-who__body">{a.body}</p>
          </article>
        ))}
      </div>
      <p class="pn-who__close">
        We verify licenses. We monitor show rates. We cut partners who waste consumers' time. <strong>This is a performance relationship, not a vendor transaction.</strong>
      </p>
    </div>
  </section>

  <!-- ===================== COMMITMENTS (no fabricated testimonials) ===================== -->
  <section class="pn-section pn-commit">
    <div class="pn-wrap">
      <header class="pn-section__head">
        <p class="pn-eyebrow">What we commit to</p>
