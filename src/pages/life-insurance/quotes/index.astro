---
import FunnelLayout from "~/layouts/FunnelLayout.astro";
import LeadFlow from "~/components/lead-flow/LeadFlow.astro";
import { FLOWS } from "~/lib/lead-flow/vertical-flows";

const flow = FLOWS.life;
---

<FunnelLayout
  title="Get Life Insurance Quotes — Compare Offers"
  description="Compare life insurance offers from our partner network. Free, fast, and you choose who contacts you."
  noindex={true}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Life", url: "/life-insurance/" },
    { name: "See rates", url: "/life-insurance/quotes/" },
  ]}
>
  <LeadFlow config={flow} />
</FunnelLayout>
