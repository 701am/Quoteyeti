---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => !data.draft);
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const isNarrow = d.layout === "narrow" || !d.layout;
---

<BaseLayout title={d.seoTitle ?? d.title} description={d.seoDescription ?? d.description} noindex={d.noindex}>
  <article class="page-article">
    <header class="page-header">
      <div class={isNarrow ? "container-narrow" : "container"}>
        <h1>{d.title}</h1>
        {d.description && <p class="page-header__lede">{d.description}</p>}
      </div>
    </header>
    <div class={isNarrow ? "container-narrow page-body" : "container page-body"}>
      <Content />
    </div>
  </article>
  <style>
    .page-header { padding-block: var(--space-16) var(--space-8); background: var(--color-alice); }
    .page-header__lede { font-size: 1.25rem; color: var(--color-text-strong); max-width: 640px; }
    .page-body { padding-block: var(--space-12) var(--space-20); font-size: 1.0625rem; line-height: 1.7; }
    .page-body :global(h2) { margin-top: var(--space-10); margin-bottom: var(--space-5); }
    .page-body :global(h3) { margin-top: var(--space-8); margin-bottom: var(--space-4); }
    .page-body :global(p) { margin-bottom: var(--space-5); }
    .page-body :global(ul), .page-body :global(ol) { margin-bottom: var(--space-5); padding-left: var(--space-6); }
    .page-body :global(li) { margin-bottom: var(--space-2); }
    .page-body :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  </style>
</BaseLayout>
