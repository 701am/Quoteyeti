---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("bestOf");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.seo.metaTitle ?? entry.data.title}
  description={entry.data.seo.metaDescription}
  ogImage={entry.data.seo.ogImage ?? entry.data.heroImage}
  noindex={entry.data.seo.noindex}
>
  <article class="bestof">
    <header class="bestof__hero">
      <div class="container">
        <p class="bestof__overline">Best Car Insurance</p>
        <h1>{entry.data.title}</h1>
      </div>
    </header>
    <div class="container bestof__body prose">
      <Content />
    </div>
  </article>

  <style>
    .bestof__hero { padding-block: var(--space-16); background: var(--color-alice); }
    .bestof__overline {
      text-transform: uppercase; letter-spacing: 0.1em;
      font-size: 0.875rem; color: var(--color-ship-cove);
      margin-bottom: var(--space-2);
    }
    .bestof__body { padding-block: var(--space-16); max-width: 760px; }
    .prose :global(h2) { margin-top: var(--space-12); }
    .prose :global(h3) { margin-top: var(--space-10); color: var(--color-resolution); }
    .prose :global(p) { margin-block: 0 var(--space-5); line-height: 1.7; }
  </style>
</BaseLayout>
