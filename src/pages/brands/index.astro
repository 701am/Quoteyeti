---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const brands = (await getCollection("brands")).sort((a, b) =>
  a.data.brandName.localeCompare(b.data.brandName)
);
---

<BaseLayout
  title="All Car Brands - QuoteYeti"
  description="Lorem ipsum — research and expert insurance advice on all major makes and models."
>
  <section class="archive-hero">
    <div class="container">
      <h1>All <span class="highlight">Brands</span></h1>
      <p class="archive-hero__lede">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Research and expert
        insurance advice on all major makes and models.
      </p>
    </div>
  </section>

  <section class="container archive-grid-section">
    {brands.length === 0 ? (
      <p class="archive-empty">No brand entries yet. Add them from the <a href="/admin/">CMS</a>.</p>
    ) : (
      <ul class="archive-grid">
        {brands.map((entry) => (
          <li>
            <a href={`/brands/${entry.data.slug}/`} class="archive-card">
              {entry.data.logo && <img src={entry.data.logo} alt="" class="archive-card__logo" />}
              <h2 class="h5 archive-card__title">{entry.data.brandName}</h2>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <style>
    .archive-hero {
      padding-block: var(--space-16);
      background: linear-gradient(180deg, var(--color-alice) 0%, var(--color-white) 100%);
      text-align: center;
    }
    .archive-hero__lede {
      max-width: 640px;
      margin: 0 auto;
      font-size: 1.125rem;
    }
    .archive-grid-section { padding-block: var(--space-16); }
    .archive-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
    .archive-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-8) var(--space-4);
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      text-align: center;
      transition: all var(--transition);
    }
    .archive-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
      border-color: var(--color-malibu);
    }
    .archive-card__logo { height: 48px; object-fit: contain; }
    .archive-card__title { margin: 0; }
    .archive-empty {
      text-align: center;
      padding: var(--space-16);
      color: var(--color-text-muted);
    }
    @media (max-width: 950px) { .archive-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 600px) { .archive-grid { grid-template-columns: repeat(2, 1fr); } }
  </style>
</BaseLayout>
