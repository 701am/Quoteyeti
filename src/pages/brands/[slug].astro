---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ZipForm from "~/components/ZipForm.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const brands = await getCollection("brands");
  return brands.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.seo.metaTitle ?? entry.data.title}
  description={entry.data.seo.metaDescription}
  ogImage={entry.data.seo.ogImage ?? entry.data.heroImage}
  noindex={entry.data.seo.noindex}
>
  <article class="single">
    <header class="single__hero">
      <div class="container single__hero-inner">
        <p class="single__overline">Brand</p>
        <h1>{entry.data.brandName} <span class="highlight">insurance</span></h1>
        {entry.data.averageRate && (
          <p class="single__rate">Average rate: <strong>{entry.data.averageRate}</strong></p>
        )}
      </div>
    </header>

    <div class="container single__layout">
      <div class="single__body prose">
        <Content />
      </div>
      <aside class="single__aside">
        <div class="card">
          <h3 class="h5">Get a quote in 60 seconds</h3>
          <ZipForm variant="inline" ctaLabel="Get Quotes" />
        </div>
        {entry.data.popularModels.length > 0 && (
          <div class="card">
            <h3 class="h5">Popular models</h3>
            <ul class="aside-list">
              {entry.data.popularModels.map((m: string) => <li>{m}</li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>

  <style>
    .single__hero {
      padding-block: var(--space-16);
      background: var(--color-alice);
    }
    .single__overline {
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.875rem;
      color: var(--color-ship-cove);
      margin-bottom: var(--space-2);
    }
    .single__rate { margin-top: var(--space-5); font-size: 1.125rem; }
    .single__layout {
      display: grid;
      grid-template-columns: minmax(0,1fr) 320px;
      gap: var(--space-12);
      padding-block: var(--space-16);
    }
    .single__aside { display: flex; flex-direction: column; gap: var(--space-6); }
    .card {
      padding: var(--space-6);
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
    }
    .aside-list { list-style: none; margin: 0; padding: 0; }
    .aside-list li {
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-border);
    }
    .aside-list li:last-child { border-bottom: 0; }

    /* prose body */
    .prose :global(h2) { margin-top: var(--space-12); }
    .prose :global(h3) { margin-top: var(--space-10); }
    .prose :global(p) { margin-block: 0 var(--space-5); line-height: 1.7; }
    .prose :global(ul), .prose :global(ol) { margin-block: 0 var(--space-5); padding-left: 1.5em; }
    .prose :global(li) { margin-bottom: var(--space-2); }
    .prose :global(a) { text-decoration: underline; }

    @media (max-width: 950px) {
      .single__layout { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
