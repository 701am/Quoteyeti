---
import FunnelLayout from "~/layouts/FunnelLayout.astro";
import LeadFlow from "~/components/lead-flow/LeadFlow.astro";
import { FLOWS } from "~/lib/lead-flow/vertical-flows";

const flow = FLOWS.health;
---

<FunnelLayout
  title="Get Health Insurance Quotes — Compare Offers"
  description="Compare health insurance offers from our partner network. Free, fast, and you choose who contacts you."
  noindex={true}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Health", url: "/health-insurance/" },
    { name: "See rates", url: "/health-insurance/quotes/" },
  ]}
>
  <LeadFlow config={flow} />
</FunnelLayout>
