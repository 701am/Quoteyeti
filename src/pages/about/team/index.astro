---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { AUTHOR_LIST } from "~/data/authors";
---

<BaseLayout
  title="The QuoteYeti editorial team"
  description="Meet the writers, editors, and data scientists behind QuoteYeti's independent insurance research. Every guide is written, reviewed, and verified by named experts."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "About", url: "/about/" },
    { name: "Team", url: "/about/team/" },
  ]}
>
  <section class="team-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumbs__sep" aria-hidden="true">›</span>
        <a href="/about/">About</a>
        <span class="breadcrumbs__sep" aria-hidden="true">›</span>
        <span aria-current="page">Team</span>
      </nav>
      <p class="eyebrow">Editorial team</p>
      <h1>
        The people behind
        <span class="serif-italic">QuoteYeti</span>.
      </h1>
      <p class="team-hero__lede">
        Every guide, review, and analysis on QuoteYeti is written, reviewed, and verified by named experts. No anonymous SEO content. No paid placements. Just a small editorial team that takes editorial standards seriously.
      </p>
      <div class="team-hero__principles">
        <div class="team-principle">
          <span class="team-principle__num">01</span>
          <span class="team-principle__text"><strong>Every article has a named writer.</strong> Bylines link to that writer's profile, credentials, and the rest of their work.</span>
        </div>
        <div class="team-principle">
          <span class="team-principle__num">02</span>
          <span class="team-principle__text"><strong>Every article is reviewed by our editor-in-chief.</strong> No piece publishes without sign-off against the QuoteYeti methodology.</span>
        </div>
        <div class="team-principle">
          <span class="team-principle__num">03</span>
          <span class="team-principle__text"><strong>Rate and pricing content is verified by our data scientist.</strong> Every number traces back to documented sources.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="team-grid-section">
    <div class="container">
      <div class="team-grid">
        {AUTHOR_LIST.map((author) => (
          <a href={`/about/team/${author.slug}/`} class="team-card" style={`--card-accent: ${author.accent ?? "#64BCE1"};`}>
            <div class="team-card__avatar">
              <img src={author.avatar} alt="" width="120" height="120" loading="lazy" />
            </div>
            <div class="team-card__body">
              <h2 class="team-card__name">
                {author.name}
                <span class="team-card__check" aria-label="Verified author">
                  <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="7" fill="currentColor"/>
                    <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                  </svg>
                </span>
              </h2>
              <p class="team-card__role">{author.title}</p>
              <p class="team-card__bio">{author.bio.split(". ").slice(0, 2).join(". ")}.</p>
              <div class="team-card__expertise">
                {author.expertise.slice(0, 3).map((e) => <span class="team-card__tag">{e}</span>)}
              </div>
              <span class="team-card__cta">
                Read full profile
                <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                  <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="team-cta">
    <div class="container">
      <div class="team-cta__inner">
        <h2>
          See how we
          <span class="serif-italic">work</span>.
        </h2>
        <p>
          Our <a href="/methodology/">methodology</a> documents how we rank carriers. Our <a href="/editorial/">editorial standards</a> document what we will and won't do. Our <a href="/about/">about page</a> explains why QuoteYeti exists.
        </p>
      </div>
    </div>
  </section>

  <style>
    .breadcrumbs { font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: var(--space-5); display: flex; align-items: center; gap: var(--space-2); }
    .breadcrumbs a { color: var(--color-text-muted); text-decoration: none; }
    .breadcrumbs a:hover { color: var(--color-malibu); }
    .breadcrumbs__sep { opacity: 0.4; }

    .serif-italic { font-family: var(--font-serif, "Plantin", Georgia, serif); font-style: italic; font-weight: 500; color: var(--color-malibu); }
    .eyebrow { display: inline-block; font-family: var(--font-display); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-malibu); margin: 0 0 var(--space-4); }

    .team-hero { padding-block: var(--space-16) var(--space-12); background: linear-gradient(180deg, var(--color-alice) 0%, var(--color-white) 100%); }
    .team-hero h1 { font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.03em; line-height: 1; margin: 0 0 var(--space-5); color: var(--color-resolution); }
    .team-hero__lede { font-size: 1.1875rem; color: var(--color-text-strong); line-height: 1.6; margin: 0 0 var(--space-10); max-width: 720px; }

    .team-hero__principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); padding-top: var(--space-8); border-top: 1px solid var(--color-border); }
    .team-principle { display: flex; gap: var(--space-4); align-items: flex-start; }
    .team-principle__num { font-family: var(--font-serif, "Plantin", Georgia, serif); font-style: italic; font-weight: 500; font-size: 2rem; line-height: 0.9; color: var(--color-malibu); opacity: 0.7; flex-shrink: 0; }
    .team-principle__text { font-size: 0.9375rem; line-height: 1.55; color: var(--color-text); }
    .team-principle__text strong { color: var(--color-resolution); }
    @media (max-width: 800px) {
      .team-hero__principles { grid-template-columns: 1fr; gap: var(--space-5); }
    }

    .team-grid-section { padding-block: var(--space-16) var(--space-20); background: var(--color-white); }
    .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
    .team-card { display: flex; flex-direction: column; padding: var(--space-7); background: var(--color-white); border: 1px solid var(--color-border); border-radius: 14px; text-decoration: none; color: inherit; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
    .team-card:hover { border-color: var(--card-accent); transform: translateY(-4px); box-shadow: 0 16px 32px -12px color-mix(in srgb, var(--card-accent) 35%, transparent); }

    .team-card__avatar { margin-bottom: var(--space-5); }
    .team-card__avatar img { width: 96px; height: 96px; border-radius: 50%; display: block; }

    .team-card__name { display: flex; align-items: center; gap: var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; letter-spacing: -0.015em; color: var(--color-resolution); margin: 0 0 var(--space-2); line-height: 1.15; }
    .team-card__check { display: inline-flex; align-items: center; color: var(--card-accent); flex-shrink: 0; }
    .team-card__role { font-family: var(--font-display); font-weight: 600; font-size: 0.875rem; color: var(--color-text-muted); margin: 0 0 var(--space-4); }
    .team-card__bio { font-size: 0.9375rem; line-height: 1.55; color: var(--color-text); margin: 0 0 var(--space-4); flex-grow: 1; }
    .team-card__expertise { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--space-5); }
    .team-card__tag { display: inline-block; padding: 3px 10px; background: var(--color-alice); border: 1px solid var(--color-border); border-radius: 100px; font-family: var(--font-display); font-size: 0.6875rem; font-weight: 700; color: var(--color-text-muted); letter-spacing: 0.04em; }
    .team-card__cta { display: inline-flex; align-items: center; gap: var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: 0.8125rem; color: var(--card-accent); padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
    .team-card__cta svg { transition: transform 0.2s; }
    .team-card:hover .team-card__cta svg { transform: translateX(3px); }
    @media (max-width: 980px) { .team-grid { grid-template-columns: 1fr; } }

    .team-cta { padding-block: var(--space-16); background: var(--color-alice); }
    .team-cta__inner { max-width: 640px; margin: 0 auto; text-align: center; }
    .team-cta h2 { font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.025em; line-height: 1.1; margin: 0 0 var(--space-5); color: var(--color-resolution); }
    .team-cta p { font-size: 1.0625rem; line-height: 1.65; color: var(--color-text); margin: 0; }
    .team-cta a { color: var(--color-malibu); text-decoration: underline; text-underline-offset: 3px; }
  </style>
</BaseLayout>
