---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentByline from "~/components/ContentByline.astro";
import CompareOutline from "~/components/CompareOutline.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Map the post category to the most relevant vertical for both the byline
// "Compare rates" pill (variant E) and the in-body outline card (variant D).
const ctaVerticalMap: Record<string, string> = {
  "Auto": "auto", "Auto insurance": "auto",
  "Home": "home", "Home insurance": "home",
  "Life": "life", "Life insurance": "life",
  "Business": "business", "Business insurance": "business",
  "Health": "health", "Health insurance": "health",
  "Renters": "renters", "Renters insurance": "renters",
  "Pet": "pet", "Pet insurance": "pet",
  "Travel": "travel", "Travel insurance": "travel",
};
const ctaVertical = (ctaVerticalMap[d.category ?? ""] ?? "auto") as any;
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.seoDescription ?? d.description ?? d.excerpt ?? ""}
  ogImage={d.ogImage ?? d.heroImage}
  pageType="article"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "The Dispatch", url: "/blog/" },
    { name: d.title, url: `/blog/${entry.id}/` },
  ]}
  article={{
    publishDate: d.publishDate ? new Date(d.publishDate).toISOString() : new Date().toISOString(),
    modifiedDate: d.updatedDate ? new Date(d.updatedDate).toISOString() : (d.publishDate ? new Date(d.publishDate).toISOString() : new Date().toISOString()),
    authorName: d.author,
    imageUrl: d.heroImage,
    tags: d.category ? [d.category] : [],
  }}
>
  <article>
    <header class="entry-hero">
      <div class="container-narrow">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> › <a href="/blog/">The Dispatch</a> › <span>{d.title}</span>
        </nav>
        {d.category && <p class="eyebrow">{d.category}</p>}
        <ContentByline
          variant="inline"
          author={d.author}
          publishDate={d.publishDate}
          updatedDate={d.updatedDate}
          compareVertical={ctaVertical}
        />
        <h1>{d.title}</h1>
        {d.excerpt && <p class="entry-hero__lede">{d.excerpt}</p>}
      </div>
    </header>

    <div class="container-narrow entry-body">
      <!-- Variant D outline card — sits at the top of the body so it's
           visible without crowding the editorial hero. -->
      <div class="entry-body__cta">
        <CompareOutline vertical={ctaVertical} />
      </div>
      <Content />
    </div>
  </article>

  <style>
    .entry-hero { padding-block: var(--space-12) var(--space-8); background: var(--color-alice); }
    .breadcrumbs { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: var(--space-5); }
    .breadcrumbs a { color: var(--color-text-muted); }
    .breadcrumbs a:hover { color: var(--color-malibu); }
    .eyebrow {
      display: inline-block; font-family: var(--font-display); font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-malibu); margin: 0 0 var(--space-3);
    }
    .entry-hero h1 { margin: var(--space-3) 0 var(--space-4); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; letter-spacing: -0.025em; }
    .entry-hero__lede { font-size: 1.1875rem; color: var(--color-text-strong); line-height: 1.55; margin: 0; max-width: 640px; }
    .entry-body { padding-block: var(--space-8) var(--space-20); font-size: 1.0625rem; line-height: 1.7; }
    .entry-body__cta { margin: 0 0 var(--space-8); }
    .entry-body :global(h2) { margin-top: var(--space-10); margin-bottom: var(--space-5); }
    .entry-body :global(h3) { margin-top: var(--space-8); margin-bottom: var(--space-4); }
    .entry-body :global(p) { margin-bottom: var(--space-5); }
    .entry-body :global(ul), .entry-body :global(ol) { margin-bottom: var(--space-5); padding-left: var(--space-6); }
  </style>
</BaseLayout>
