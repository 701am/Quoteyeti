---
/**
 * CompareOutline — Variant D from the mockup.
 *
 * Small framed widget with a pin icon, a single line of copy, and an inline
 * ZIP + button. Designed for blog posts and other lighter content where a
 * margin rail would be overkill but we still want a visible affordance.
 *
 * Designed to sit horizontally — single row on desktop, stacked on mobile.
 */
import { VERTICALS, type VerticalKey } from "~/data/verticals";

interface Props {
  vertical: VerticalKey;
  /** Override heading. */
  heading?: string;
  /** Override sub-text. */
  sub?: string;
  /** Override CTA label. */
  cta?: string;
}

const { vertical, heading, sub, cta } = Astro.props;
const v = VERTICALS[vertical];
const formAction = `${v.path}quotes/`;
const inputId = `co-${vertical}-${Math.random().toString(36).slice(2, 8)}`;
---

<aside
  class="compare-outline"
  style={`--co-accent: ${v.accent};`}
  aria-label={`Compare ${v.short.toLowerCase()} rates in your area`}
>
  <div class="compare-outline__left">
    <i class="ti-pin" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
      </svg>
    </i>
    <div class="compare-outline__copy">
      <div class="compare-outline__heading">
        {heading ?? `Compare ${v.short.toLowerCase()} rates in your area`}
      </div>
      <div class="compare-outline__sub">
        {sub ?? "Live rates from the carriers we've reviewed"}
      </div>
    </div>
  </div>
  <form class="compare-outline__form" action={formAction} method="get" novalidate>
    <label class="sr-only" for={inputId}>ZIP code</label>
    <input
      id={inputId}
      name="zip"
      type="text"
      inputmode="numeric"
      pattern="[0-9]{5}"
      maxlength="5"
      placeholder="ZIP"
      required
      autocomplete="postal-code"
    />
    <button type="submit">
      {cta ?? "See rates"}
      <svg width="10" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true">
        <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </form>
</aside>

<style>
  .compare-outline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: 14px var(--space-5);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-family: var(--font-display);
  }
  .compare-outline__left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .compare-outline .ti-pin {
    color: var(--co-accent);
    display: inline-flex;
    flex-shrink: 0;
  }
  .compare-outline__copy { min-width: 0; }
  .compare-outline__heading {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-resolution);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .compare-outline__sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-top: 2px;
  }
  .compare-outline__form {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .compare-outline__form input {
    width: 80px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-resolution);
    background: var(--color-white);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .compare-outline__form input:focus {
    outline: none;
    border-color: var(--co-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--co-accent) 25%, transparent);
  }
  .compare-outline__form button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--co-accent);
    color: var(--color-white);
    border: 0;
    border-radius: 6px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.15s;
    white-space: nowrap;
  }
  .compare-outline__form button:hover { opacity: 0.92; transform: translateY(-1px); }

  @media (max-width: 640px) {
    .compare-outline { flex-direction: column; align-items: stretch; gap: var(--space-3); }
    .compare-outline__form input { flex: 1; }
  }
</style>
