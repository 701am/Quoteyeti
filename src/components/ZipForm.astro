<script>
  // Picker variant: swap form action + active state when user picks a vertical
  document.querySelectorAll<HTMLElement>("[data-zip-picker]").forEach((picker) => {
    const buttons = picker.querySelectorAll<HTMLButtonElement>("[data-vert-key]");
    const form = picker.querySelector<HTMLFormElement>("[data-zip-picker-form]");
    if (!form) return;
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-checked", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-checked", "true");
        const path = btn.dataset.vertPath;
        if (path) form.action = `${path}quotes/`;
      });
    });
  });
</script>
