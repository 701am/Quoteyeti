---
const brands = [
  ["Acura", "/brands/acura/"], ["Alfa Romeo", "/brands/alfa-romeo/"],
  ["Aston Martin", "/brands/aston-martin/"], ["Audi", "/brands/audi/"],
  ["Bentley", "/brands/bentley/"], ["BMW", "/brands/bmw/"],
  ["Buick", "/brands/buick/"], ["Cadillac", "/brands/cadillac/"],
  ["Chevrolet", "/brands/chevrolet/"], ["Chrysler", "/brands/chrysler/"],
  ["Dodge", "/brands/dodge/"], ["Fiat", "/brands/fiat/"],
  ["Ferrari", "/brands/ferrari/"], ["Ford", "/brands/ford/"],
  ["Genesis", "/brands/genesis-insurance-rates/"], ["GMC", "/brands/gmc-insurance-rates/"],
  ["Honda", "/brands/honda-insurance-rates/"], ["Hyundai", "/brands/hyundai-insurance-rates/"],
  ["Infiniti", "/brands/infiniti-car-insurance/"], ["Jaguar", "/brands/jaguar-insurance-rates/"],
  ["Jeep", "/brands/jeep-insurance-rates/"], ["Kia", "/brands/kia-insurance-rates/"],
  ["Lamborghini", "/brands/lamborghini-insurance-rates/"], ["Land Rover", "/brands/land-rover-insurance-rates/"],
  ["Lexus", "/brands/lexus-insurance-rates/"], ["Lincoln", "/brands/lincoln-insurance-rates/"],
  ["Lotus", "/brands/lotus-insurance-rates/"], ["Maserati", "/brands/maserati-insurance-rates/"],
  ["Mazda", "/brands/mazda-insurance-rates/"], ["McLaren", "/brands/mclaren/"],
  ["Mini", "/brands/mini-insurance-rates/"], ["Mitsubishi", "/brands/mitsubishi-insurance-rates/"],
  ["Nissan", "/brands/nissan-insurance-rates/"], ["Polestar", "/brands/polestar-insurance-rates/"],
  ["Porsche", "/brands/porsche-insurance-rates/"], ["Ram", "/brands/ram-insurance-rates/"],
  ["Rivian", "/brands/rivian-insurance-rates/"], ["Rolls-Royce", "/brands/rolls-royce-insurance-rates/"],
  ["Subaru", "/brands/subaru-insurance-rates/"], ["Tesla", "/brands/tesla-insurance-rates/"],
  ["Toyota", "/brands/toyota-insurance-rates/"], ["Volkswagen", "/brands/volkswagen-insurance-rates/"],
  ["Volvo", "/brands/volvo-insurance-rates/"], ["Vuhl", "/brands/vuhl-insurance-rates/"],
];

// Truncated for brevity; full list lives in the source HTML for migration
const providers = [
  ["AAA", "/reviews/aaa-auto-insurance/"], ["Acuity", "/reviews/acuity-car-insurance/"],
  ["AIG", "/reviews/aig-insurance/"], ["Allstate", "/reviews/allstate-insurance/"],
  ["American Family", "/reviews/american-family-insurance/"],
  ["Amica Mutual", "/reviews/amica-mutual-insurance/"], ["Auto-Owners", "/reviews/auto-owners-insurance/"],
  ["Chubb", "/reviews/chubb-auto-insurance/"], ["Esurance", "/reviews/esurance-car-insurance/"],
  ["Farmers", "/reviews/farmers-insurance/"], ["GEICO", "/reviews/geico-insurance/"],
  ["Hanover", "/reviews/hanover-car-insurance/"], ["Kemper", "/reviews/kemper-auto-insurance/"],
  ["Liberty Mutual", "/reviews/liberty-mutual-insurance/"], ["MetLife", "/reviews/metlife-car-insurance/"],
  ["Mercury", "/reviews/mercury-car-insurance/"], ["Nationwide", "/reviews/nationwide-insurance/"],
  ["Progressive", "/reviews/progressive-insurance/"], ["Safeco", "/reviews/safeco-insurance/"],
  ["State Farm", "/reviews/state-farm-insurance/"], ["The Hartford", "/reviews/the-hartford-insurance/"],
  ["Travelers", "/reviews/travelers-insurance/"], ["USAA", "/reviews/usaa-insurance/"],
  ["Westfield", "/reviews/westfield-insurance/"],
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <section class="site-footer__column">
      <h3 class="site-footer__heading">Brands</h3>
      <ul class="site-footer__list">
        {brands.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </section>

    <section class="site-footer__column">
      <h3 class="site-footer__heading">Providers</h3>
      <ul class="site-footer__list">
        {providers.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </section>
  </div>

  <div class="container site-footer__bottom">
    <a href="/" aria-label="QuoteYeti home" class="site-footer__mark">
      <img src="/assets/images/footprint.svg" alt="" width="40" height="40" />
    </a>
    <p>© {year} QuoteYeti.<br />All rights reserved.</p>
    <nav aria-label="Legal" class="site-footer__legal">
      <a href="/privacy-policy/">Privacy</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-alice);
    color: var(--color-text);
    padding-top: var(--space-16);
    margin-top: var(--space-24);
    border-top: 1px solid var(--color-border);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
  }
  .site-footer__heading {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ship-cove);
    margin-bottom: var(--space-5);
  }
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: 3;
    column-gap: var(--space-6);
  }
  .site-footer__list li {
    break-inside: avoid;
    margin-bottom: var(--space-2);
  }
  .site-footer__list a {
    color: var(--color-resolution);
    font-size: 0.9rem;
  }
  .site-footer__list a:hover {
    color: var(--color-malibu);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .site-footer__legal {
    margin-left: auto;
    display: flex;
    gap: var(--space-5);
  }
  .site-footer__legal a {
    color: var(--color-text-muted);
  }
  @media (max-width: 950px) {
    .site-footer__inner { grid-template-columns: 1fr; }
    .site-footer__list { column-count: 2; }
    .site-footer__bottom { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .site-footer__legal { margin-left: 0; }
  }
  @media (max-width: 600px) {
    .site-footer__list { column-count: 1; }
  }
</style>
