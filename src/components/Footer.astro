<script>
  /**
   * Footer tab switcher.
   *
   * On vertical-mode footers (any page inside /<vertical>/...), the footer
   * renders one panel per vertical with the page's own vertical opened by
   * default. Clicking any tab swaps the visible panel WITHOUT navigating —
   * users can survey what's in the home or life footer while reading an auto
   * page, then jump in via any pill.
   *
   * Implementation notes:
   *  - All 8 panels are server-rendered in the HTML so they're crawlable.
   *    The inactive ones get `[hidden]` which removes them from layout but
   *    keeps them in the DOM.
   *  - We bind one click handler at the footer root and delegate, so we don't
   *    pay per-tab listener cost.
   *  - The "active" state is reflected on both the tab and the panel via
   *    a data attribute on the wrapper for any CSS that wants to react.
   */
  (function () {
    const root = document.querySelector(".footer-vertical-mode");
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".footer-tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".footer-panel"));

    function activate(key: string) {
      for (const t of tabs) {
        const isActive = t.dataset.tab === key;
        t.classList.toggle("is-active", isActive);
        t.setAttribute("aria-selected", isActive ? "true" : "false");
      }
      for (const p of panels) {
        const isActive = p.dataset.panel === key;
        p.hidden = !isActive;
      }
      root.setAttribute("data-active-tab", key);
    }

    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".footer-tab");
      if (!btn) return;
      const key = btn.dataset.tab;
      if (key) activate(key);
    });
  })();
</script>
