---
/**
 * ScoreGauge — radial gauge for a 0-5 score.
 *
 * Pure SVG, no JS. Used everywhere a numeric score appears:
 * carrier review hero, Best Of carrier panels, ratings sub-scores,
 * methodology weight visuals.
 *
 * Design language:
 *   - Track: thin cream/gray hairline, 360°
 *   - Fill arc: thick navy stroke, starts at 12 o'clock, runs clockwise
 *   - Center: large display-font score (e.g. "4.86"), small "out of 5" below
 *   - On the largest size: optional sub-label and rank pill
 *
 * Props:
 *   score:       0-5 numeric. Required.
 *   max:         scale ceiling. Default 5.
 *   size:        'sm' (54px) | 'md' (88px) | 'lg' (128px) | 'xl' (180px)
 *   label:       optional small label below the gauge (e.g. "Overall score")
 *   rank:        optional rank pill below (e.g. "#1 of 6")
 *   tone:        'default' (navy fill) | 'accent' (section accent fill)
 *                | 'auto' (color shifts by score: red < amber < teal)
 */
interface Props {
  score: number;
  max?: number;
  size?: "sm" | "md" | "lg" | "xl";
  label?: string;
  rank?: string;
  tone?: "default" | "accent" | "auto";
}

const {
  score,
  max = 5,
  size = "md",
  label,
  rank,
  tone = "default",
} = Astro.props;

// Geometry — viewBox is 100×100 for easy math; we scale via CSS width/height
const RADIUS = 42;
const CIRC = 2 * Math.PI * RADIUS; // ≈ 263.9
const pct = Math.max(0, Math.min(1, score / max));
const dashOffset = CIRC * (1 - pct);

// Tone resolution. 'auto' mode colors the arc based on score (UX signal).
let arcColor = "var(--color-resolution)";
if (tone === "accent") arcColor = "var(--section-accent)";
if (tone === "auto") {
  if (pct < 0.6)      arcColor = "var(--color-error)";
  else if (pct < 0.8) arcColor = "var(--color-warning)";
  else                arcColor = "var(--color-teal)";
}

const display = score.toFixed(2);
const sizePx = { sm: 54, md: 88, lg: 128, xl: 180 }[size];
const scoreFontSize = { sm: 14, md: 22, lg: 30, xl: 40 }[size];
const subFontSize = { sm: 8, md: 9, lg: 10, xl: 11 }[size];
const strokeWidth = { sm: 6, md: 7, lg: 8, xl: 9 }[size];
---

<div class={`score-gauge score-gauge--${size}`} style={`--gauge-size: ${sizePx}px; --gauge-arc: ${arcColor}; --gauge-score-fs: ${scoreFontSize}px; --gauge-sub-fs: ${subFontSize}px;`}>
  <div class="score-gauge__ring">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      {/* Background track */}
      <circle
        cx="50" cy="50" r={RADIUS}
        fill="none"
        stroke="var(--color-gainsboro)"
        stroke-width={strokeWidth}
      />
      {/* Score arc — rotated -90 to start at 12 o'clock */}
      <circle
        cx="50" cy="50" r={RADIUS}
        fill="none"
        stroke="var(--gauge-arc)"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        stroke-dasharray={CIRC}
        stroke-dashoffset={dashOffset}
        transform="rotate(-90 50 50)"
      />
    </svg>
    <div class="score-gauge__center" role="img" aria-label={`Score ${display} out of ${max}`}>
      <div class="score-gauge__score">{display}</div>
      {size !== "sm" && (
        <div class="score-gauge__outof">out of {max}</div>
      )}
    </div>
  </div>
  {(label || rank) && (
    <div class="score-gauge__caption">
      {label && <span class="score-gauge__label">{label}</span>}
      {rank && <span class="score-gauge__rank">{rank}</span>}
    </div>
  )}
</div>

<style>
  .score-gauge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .score-gauge__ring {
    position: relative;
    width: var(--gauge-size);
    height: var(--gauge-size);
  }
  .score-gauge__ring svg {
    width: 100%;
    height: 100%;
    display: block;
    /* Subtle entrance: arc draws in. Browsers that don't support won't notice. */
    animation: gaugeReveal 900ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .score-gauge__center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .score-gauge__score {
    font-family: var(--font-display);
    font-size: var(--gauge-score-fs);
    font-weight: 600;
    color: var(--color-resolution);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .score-gauge__outof {
    font-family: var(--font-display);
    font-size: var(--gauge-sub-fs);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    line-height: 1;
    margin-top: 2px;
    text-transform: lowercase;
  }

  .score-gauge__caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .score-gauge__label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }
  .score-gauge__rank {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-resolution);
    background: var(--color-alice);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
  }

  @keyframes gaugeReveal {
    from { opacity: 0; transform: scale(0.85); }
    to   { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .score-gauge__ring svg { animation: none; }
  }
</style>
