---
/**
 * Byline component — the visible E-E-A-T signal that appears under the H1
 * of every article, guide, review, and support page.
 *
 * Renders Bankrate / NerdWallet style attribution:
 *   - Avatar + Writer name (with verified checkmark)
 *   - Avatar + Reviewer name (with verified checkmark)
 *   - Avatar + Data scientist name on rate/pricing pages (with checkmark)
 *   - Published date + "Updated" date
 *   - "Why trust us" expandable affordance
 *
 * Each name links to /about/team/<slug>/ — the canonical authority anchor
 * for that Person in JSON-LD and crawlers.
 *
 * Style:
 *   - Compact horizontal stack on desktop
 *   - Stacked rows on mobile (<700px)
 *   - Checkmark badges = QuoteYeti malibu blue, like Bankrate's green tick
 */

import { DEFAULT_BYLINE, resolveAuthor, isDataHeavyPage, type Author } from "~/data/authors";
import { VERTICALS, type VerticalKey } from "~/data/verticals";

interface Props {
  /** Author name or slug. Falls back to default writer (Rai Antonio). */
  author?: string;
  /** Override reviewer. Falls back to default reviewer (David Krug). */
  reviewer?: string;
  /** Force-include or exclude the data scientist. Auto-detects from URL when undefined. */
  showData?: boolean;
  /** ISO date string when the page was first published. */
  publishDate?: string | Date;
  /** ISO date string of the last update. */
  updatedDate?: string | Date;
  /** Optional read-time estimate (e.g. "8 min read"). */
  readTime?: string;
  /** Visual style:
   *  - "card" (default) — full Bankrate-style card with avatars + trust panel
   *  - "compact" — smaller avatars, no role-sub line, no trust panel
   *  - "inline" — MoneyGeek-style horizontal strip: "Updated · Written by NAME ✓ · Reviewed by NAME ✓"
   *                meant to render at the very top of the article hero, before H1
   */
  variant?: "card" | "compact" | "inline";
  /** Back-compat alias for variant="compact" */
  compact?: boolean;
  /** When set on the inline variant, renders a "Compare rates" pill that opens
   *  a small ZIP popover. Pass the vertical key to route to its quotes flow.
   *  Set to false to suppress. */
  compareVertical?: VerticalKey | false;
}

const {
  author,
  reviewer,
  showData,
  publishDate,
  updatedDate,
  readTime,
  variant,
  compact = false,
  compareVertical,
} = Astro.props;

// Resolve final variant (back-compat: compact prop → variant="compact")
const v: "card" | "compact" | "inline" = variant ?? (compact ? "compact" : "card");

// Default the compare-rates pill ON when rendering the inline variant
// (template can pass compareVertical={false} to suppress, or pass an explicit key)
const compareV: VerticalKey | null =
  compareVertical === false
    ? null
    : (compareVertical ?? null);
const compareVertObj = compareV ? VERTICALS[compareV] : null;
const compareAction = compareVertObj ? `${compareVertObj.path}quotes/` : null;
// Stable per-render id so the popover-trigger pairs uniquely
const compareId = `cmp-${Math.random().toString(36).slice(2, 9)}`;

const writer: Author = resolveAuthor(author);
const reviewerAuthor: Author = resolveAuthor(reviewer, DEFAULT_BYLINE.reviewer);
const dataAuthor: Author = DEFAULT_BYLINE.data;

// Auto-decide whether to show data scientist credit based on the URL
const pathname = Astro.url.pathname;
const shouldShowData = showData ?? isDataHeavyPage(pathname);

function fmtDate(d?: string | Date): string | null {
  if (!d) return null;
  const date = d instanceof Date ? d : new Date(d);
  if (isNaN(date.valueOf())) return null;
  return date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}

const publishedFmt = fmtDate(publishDate);
const updatedFmt = fmtDate(updatedDate);
const showUpdated = updatedFmt && publishedFmt !== updatedFmt;
---

{v === "inline" && (
  <div class="byline-inline" aria-label="Authors and review credits">
    <div class="byline-inline__row">
      {publishedFmt && (
        <span class="byline-inline__date">
          <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <rect x="2" y="3" width="10" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" fill="none"/>
            <path d="M2 6h10M5 1.5v2M9 1.5v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span>{showUpdated ? "Updated" : "Published"}: <strong>{showUpdated ? updatedFmt : publishedFmt}</strong></span>
        </span>
      )}

      <span class="byline-inline__sep" aria-hidden="true">·</span>

      <span class="byline-inline__person" data-role="writer">
        <span class="byline-inline__label">Written by</span>
        <a href={`/about/team/${writer.slug}/`} class="byline-inline__name">
          {writer.name}
          <span class="byline-inline__check" aria-label="Verified writer">
            <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="7" fill="currentColor"/>
              <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
        </a>
      </span>

      <span class="byline-inline__sep" aria-hidden="true">·</span>

      <span class="byline-inline__person" data-role="reviewer">
        <span class="byline-inline__label">Reviewed by</span>
        <a href={`/about/team/${reviewerAuthor.slug}/`} class="byline-inline__name">
          {reviewerAuthor.name}
          <span class="byline-inline__check" aria-label="Verified reviewer">
            <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="7" fill="currentColor"/>
              <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
        </a>
      </span>

      {shouldShowData && (
        <>
          <span class="byline-inline__sep" aria-hidden="true">·</span>
          <span class="byline-inline__person" data-role="data">
            <span class="byline-inline__label">Data by</span>
            <a href={`/about/team/${dataAuthor.slug}/`} class="byline-inline__name">
              {dataAuthor.name}
              <span class="byline-inline__check" aria-label="Verified data analyst">
                <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <circle cx="7" cy="7" r="7" fill="currentColor"/>
                  <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </span>
            </a>
          </span>
        </>
      )}

      {compareAction && compareVertObj && (
        <details class="byline-inline__compare" id={compareId}>
          <summary aria-label={`Compare ${compareVertObj.short.toLowerCase()} rates in your area`}>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>Compare rates in your area</span>
          </summary>
          <div class="byline-inline__compare-body">
            <p class="byline-inline__compare-eyebrow">
              <span style={`color: ${compareVertObj.accent};`}>● </span>
              {compareVertObj.label}
            </p>
            <p class="byline-inline__compare-text">
              See actual {compareVertObj.short.toLowerCase()} rates from the carriers covered here. Free, 60 seconds, no phone calls.
            </p>
            <form action={compareAction} method="get" class="byline-inline__compare-form" novalidate>
              <label class="sr-only" for={`${compareId}-zip`}>ZIP code</label>
              <input
                id={`${compareId}-zip`}
                name="zip"
                type="text"
                inputmode="numeric"
                pattern="[0-9]{5}"
                maxlength="5"
                placeholder="ZIP code"
                required
                autocomplete="postal-code"
              />
              <button type="submit" style={`background: ${compareVertObj.accent};`}>
                Get rates
                <svg width="10" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                  <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>
          </div>
        </details>
      )}

      <details class="byline-inline__trust">
        <summary aria-label="Why trust QuoteYeti">
          <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 1l5 2v4c0 3-2.5 5.5-5 6-2.5-.5-5-3-5-6V3l5-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
            <path d="M5 7l1.5 1.5L9.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span>Why trust QuoteYeti</span>
        </summary>
        <div class="byline-inline__trust-body">
          <p>QuoteYeti's editorial team has spent 30+ combined years researching insurance markets. Every piece is written by named writers, reviewed by our editor-in-chief against the <a href="/methodology/">QuoteYeti methodology</a>, and rate-heavy content is verified by our data team. No paid placements. <a href="/editorial/">Read our editorial standards →</a></p>
        </div>
      </details>
    </div>
  </div>
)}

{v !== "inline" && (
<aside class={`byline ${v === "compact" ? "byline--compact" : ""}`} aria-label="Authors and review credits">
  <div class="byline__people">
    <!-- WRITER -->
    <div class="byline__person" data-role="writer">
      <a href={`/about/team/${writer.slug}/`} class="byline__avatar-link" aria-label={`Profile of ${writer.name}`}>
        <img
          src={writer.avatar ?? "/assets/images/team/default.svg"}
          alt=""
          width="44"
          height="44"
          loading="lazy"
          class="byline__avatar"
        />
      </a>
      <div class="byline__meta">
        <span class="byline__role-label">Written by</span>
        <a href={`/about/team/${writer.slug}/`} class="byline__name">
          <span>{writer.name}</span>
          <span class="byline__check" aria-label="Verified author">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="7" fill="currentColor"/>
              <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
        </a>
        {v !== "compact" && <span class="byline__role-sub">{writer.role}</span>}
      </div>
    </div>

    <!-- REVIEWER -->
    <div class="byline__person" data-role="reviewer">
      <a href={`/about/team/${reviewerAuthor.slug}/`} class="byline__avatar-link" aria-label={`Profile of ${reviewerAuthor.name}`}>
        <img
          src={reviewerAuthor.avatar ?? "/assets/images/team/default.svg"}
          alt=""
          width="44"
          height="44"
          loading="lazy"
          class="byline__avatar"
        />
      </a>
      <div class="byline__meta">
        <span class="byline__role-label">Reviewed by</span>
        <a href={`/about/team/${reviewerAuthor.slug}/`} class="byline__name">
          <span>{reviewerAuthor.name}</span>
          <span class="byline__check" aria-label="Verified reviewer">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="7" fill="currentColor"/>
              <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
        </a>
        {v !== "compact" && <span class="byline__role-sub">{reviewerAuthor.role}</span>}
      </div>
    </div>

    <!-- DATA SCIENTIST (only on rate/pricing-heavy pages) -->
    {shouldShowData && (
      <div class="byline__person" data-role="data">
        <a href={`/about/team/${dataAuthor.slug}/`} class="byline__avatar-link" aria-label={`Profile of ${dataAuthor.name}`}>
          <img
            src={dataAuthor.avatar ?? "/assets/images/team/default.svg"}
            alt=""
            width="44"
            height="44"
            loading="lazy"
            class="byline__avatar"
          />
        </a>
        <div class="byline__meta">
          <span class="byline__role-label">Data analysis by</span>
          <a href={`/about/team/${dataAuthor.slug}/`} class="byline__name">
            <span>{dataAuthor.name}</span>
            <span class="byline__check" aria-label="Verified data analyst">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <circle cx="7" cy="7" r="7" fill="currentColor"/>
                <path d="M3.8 7.2l2 2 4.4-4.4" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </span>
          </a>
          {v !== "compact" && <span class="byline__role-sub">{dataAuthor.role}</span>}
        </div>
      </div>
    )}
  </div>

  {(publishedFmt || updatedFmt || readTime) && v !== "compact" && (
    <div class="byline__timestamps">
      {publishedFmt && (
        <span class="byline__date">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <rect x="2" y="3" width="10" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4" fill="none"/>
            <path d="M2 6h10M5 1.5v2M9 1.5v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span><strong>Published:</strong> {publishedFmt}</span>
        </span>
      )}
      {showUpdated && (
        <span class="byline__date">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7a5 5 0 1 1 1.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M2 4v3h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span><strong>Updated:</strong> {updatedFmt}</span>
        </span>
      )}
      {readTime && (
        <span class="byline__date">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4" fill="none"/>
            <path d="M7 4v3l2 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>
          </svg>
          <span>{readTime}</span>
        </span>
      )}
    </div>
  )}

  {v !== "compact" && (
    <details class="byline__trust">
      <summary class="byline__trust-summary">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1l5 2v4c0 3-2.5 5.5-5 6-2.5-.5-5-3-5-6V3l5-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
          <path d="M5 7l1.5 1.5L9.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
        <span>Why trust QuoteYeti</span>
        <span class="byline__trust-chev" aria-hidden="true">▾</span>
      </summary>
      <div class="byline__trust-body">
        <p>
          QuoteYeti's editorial team has spent a combined 30+ years researching insurance markets, pricing structures, and carrier behavior. Our reviews and rankings are independent of who pays us — every piece is reviewed by our editor-in-chief against the <a href="/methodology/">QuoteYeti methodology</a> before publication, and rate-heavy content is verified by our data team.
        </p>
        <p>
          We don't accept paid placements, we don't sell your information, and we won't recommend a carrier we wouldn't pick for our own families. <a href="/editorial/">Read our full editorial standards →</a>
        </p>
      </div>
    </details>
  )}
</aside>
)}

<style>
  /* ============================================
     Byline — visible E-E-A-T signal
  ============================================ */
  .byline {
    margin: var(--space-6) 0 var(--space-8);
    padding: var(--space-5) var(--space-6);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }
  .byline--compact {
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 0;
    margin: var(--space-4) 0;
  }

  .byline__people {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
  }

  .byline__person {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .byline__avatar-link {
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    display: inline-flex;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .byline__avatar-link:hover {
    transform: scale(1.04);
    box-shadow: 0 4px 12px rgba(44, 69, 119, 0.18);
  }
  .byline__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: block;
  }
  .byline--compact .byline__avatar,
  .byline--compact .byline__avatar-link img {
    width: 32px;
    height: 32px;
  }

  .byline__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .byline__role-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .byline__name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-resolution);
    text-decoration: none;
    line-height: 1.2;
    transition: color 0.15s;
  }
  .byline__name:hover {
    color: var(--color-malibu);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Verified checkmark — different color per role for visual hierarchy */
  .byline__check {
    display: inline-flex;
    align-items: center;
    color: var(--color-malibu);
    flex-shrink: 0;
  }
  [data-role="writer"] .byline__check { color: #64BCE1; }
  [data-role="reviewer"] .byline__check { color: #2C4577; }
  [data-role="data"] .byline__check { color: #14A38B; }

  .byline__role-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  /* Timestamps row */
  .byline__timestamps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .byline__date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .byline__date strong {
    color: var(--color-resolution);
    font-weight: 600;
  }

  /* Trust expander */
  .byline__trust {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .byline__trust-summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-resolution);
    user-select: none;
  }
  .byline__trust-summary::-webkit-details-marker { display: none; }
  .byline__trust-summary:hover { color: var(--color-malibu); }
  .byline__trust-chev {
    margin-left: 2px;
    transition: transform 0.2s;
    font-size: 0.625rem;
  }
  .byline__trust[open] .byline__trust-chev { transform: rotate(180deg); }
  .byline__trust-body {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
  }
  .byline__trust-body p {
    margin: 0 0 var(--space-3);
  }
  .byline__trust-body p:last-child { margin-bottom: 0; }
  .byline__trust-body a {
    color: var(--color-malibu);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .byline__trust-body a:hover {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 700px) {
    .byline__people {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .byline__person {
      width: 100%;
    }
    .byline__timestamps {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  /* ============================================
     Inline variant — MoneyGeek-style strip above H1
  ============================================ */
  .byline-inline {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .byline-inline__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    row-gap: 6px;
  }
  .byline-inline__date {
    display: inline-flex; align-items: center; gap: 6px;
  }
  .byline-inline__date strong {
    color: var(--color-resolution); font-weight: 600;
  }
  .byline-inline__sep {
    color: var(--color-text-muted); opacity: 0.45; user-select: none;
  }
  .byline-inline__person {
    display: inline-flex; align-items: center; gap: 6px;
  }
  .byline-inline__label {
    color: var(--color-text-muted);
  }
  .byline-inline__name {
    display: inline-flex; align-items: center; gap: 4px;
    color: var(--color-resolution);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s, color 0.15s;
  }
  .byline-inline__name:hover {
    color: var(--color-malibu);
    border-bottom-color: currentColor;
  }
  .byline-inline__check {
    display: inline-flex; align-items: center;
    color: var(--color-malibu);
  }
  [data-role="writer"] .byline-inline__check { color: #64BCE1; }
  [data-role="reviewer"] .byline-inline__check { color: #2C4577; }
  [data-role="data"] .byline-inline__check { color: #14A38B; }

  .byline-inline__trust {
    margin-left: auto;
    position: relative;
  }
  .byline-inline__trust summary {
    display: inline-flex; align-items: center; gap: 6px;
    cursor: pointer;
    list-style: none;
    color: var(--color-resolution);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
    background: var(--color-alice);
    transition: background 0.15s;
  }
  .byline-inline__trust summary::-webkit-details-marker { display: none; }
