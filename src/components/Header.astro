---
import { NAV } from "~/data/nav";
import { VERTICALS, detectVertical } from "~/data/verticals";

// Detect which vertical the user is currently browsing so the header
// CTA can adapt — "Get auto quotes" on /auto/*, "Get home quotes" on
// /home-insurance/*, etc. Falls back to auto on non-vertical pages.
const detected = detectVertical(Astro.url.pathname);
---

<header class="site-header">
  <!-- Thin accent strip at very top -->
  <div class="site-header__strip" aria-hidden="true">
    <span class="site-header__strip-bar" style="background: #F46036;"></span>
    <span class="site-header__strip-bar" style="background: #8FB339;"></span>
    <span class="site-header__strip-bar" style="background: #6B5B95;"></span>
    <span class="site-header__strip-bar" style="background: #14A38B;"></span>
    <span class="site-header__strip-bar" style="background: #E8A87C;"></span>
    <span class="site-header__strip-bar" style="background: #C06C84;"></span>
    <span class="site-header__strip-bar" style="background: #355C7D;"></span>
    <span class="site-header__strip-bar" style="background: #2E5266;"></span>
  </div>

  <div class="site-header__bar">
    <div class="container site-header__inner">
      <a href="/" class="brand" aria-label="QuoteYeti home">
        <img src="/assets/images/quoteyeti-logo.svg" alt="QuoteYeti" class="brand__logo" />
      </a>

      <nav class="megamenu" aria-label="Primary">
        <ul class="megamenu__list" role="menubar">
          {NAV.map((entry, i) => {
            const vertical = entry.verticalKey ? VERTICALS[entry.verticalKey] : null;
            const accentVar = vertical ? `--section-accent: ${vertical.accent}; --section-accent-soft: ${vertical.accentSoft};` : "";
            return (
              <li class="megamenu__item" role="none">
                {entry.href && !entry.panel ? (
                  <a href={entry.href} class="megamenu__top" role="menuitem">{entry.label}</a>
                ) : (
                  <>
                    <button
                      class="megamenu__top"
                      role="menuitem"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-controls={`mm-panel-${i}`}
                      data-mm-trigger={i}
                    >
                      <span>{entry.label}</span>
                      <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" class="megamenu__chevron">
                        <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                      </svg>
                    </button>
                    {entry.panel && (
                      <div
                        id={`mm-panel-${i}`}
                        class="megamenu__panel"
                        data-mm-panel={i}
                        style={accentVar}
                        role="region"
                        aria-label={`${entry.label} menu`}
                        hidden
                      >
                        <div class="container megamenu__panel-inner">
                          <div class="megamenu__columns">
                            {entry.panel.columns.map((col) => (
                              <div class="megamenu__column">
                                <h3 class="megamenu__col-title">{col.title}</h3>
                                <ul class="megamenu__links">
                                  {col.links.map((link) => (
                                    <li>
                                      <a href={link.href}>
                                        <span class="megamenu__link-label">{link.label}</span>
                                        {link.desc && <span class="megamenu__link-desc">{link.desc}</span>}
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            ))}
                          </div>

                          <aside class="megamenu__featured" aria-label="Featured">
                            {entry.panel.featured.image && (
                              <div class="megamenu__featured-art" aria-hidden="true">
                                <img src={entry.panel.featured.image} alt="" />
                              </div>
                            )}
                            <div class="megamenu__featured-body">
                              <p class="megamenu__featured-eyebrow">{entry.panel.featured.eyebrow}</p>
                              <h4 class="megamenu__featured-heading">{entry.panel.featured.heading}</h4>
                              <p class="megamenu__featured-text">{entry.panel.featured.body}</p>
                              <a href={entry.panel.featured.cta.href} class="megamenu__featured-cta">
                                <span>{entry.panel.featured.cta.label}</span>
                                <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                                  <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                              </a>
                            </div>
                          </aside>
                        </div>
                      </div>
                    )}
                  </>
                )}
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="site-header__actions">
        <a
          href={`${detected?.path ?? "/auto/"}quotes/`}
          class="header__cta"
        >
          <span>Get {detected?.short.toLowerCase() ?? "auto"} quotes</span>
          <svg width="12" height="10" viewBox="0 0 14 12" fill="none" aria-hidden="true">
            <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <button class="header__menu-toggle" aria-label="Open menu" aria-expanded="false" data-mobile-toggle>
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu — backdrop scrim + slide-in panel from right -->
  <div class="mobile-menu" data-mobile-drawer aria-hidden="true">
    <div class="mobile-menu__scrim" data-mobile-scrim aria-hidden="true"></div>
    <aside class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Site menu">
      <header class="mobile-menu__top">
        <a href="/" class="mobile-menu__brand" data-mobile-close>
          <img src="/assets/images/quoteyeti-logo.svg" alt="QuoteYeti" class="mobile-menu__logo" />
        </a>
        <button class="mobile-menu__close" data-mobile-close aria-label="Close menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </header>

      <div class="mobile-menu__zip">
        <a
          href={`${detected?.path ?? "/auto/"}quotes/`}
          class="mobile-menu__zip-cta"
          data-mobile-close
        >
          <span>Get {detected?.short.toLowerCase() ?? "auto"} quotes</span>
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
            <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <nav class="mobile-menu__nav" aria-label="Mobile navigation">
        <ul class="mobile-menu__list">
          {NAV.map((entry) => (
            <li class="mobile-menu__item">
              {entry.href && !entry.panel ? (
                <a href={entry.href} class="mobile-menu__top-link" data-mobile-close>
                  <span>{entry.label}</span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              ) : (
                <details class="mobile-menu__details">
                  <summary>
                    <span>{entry.label}</span>
                    <svg class="mobile-menu__chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="M2 5l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  {entry.panel && (
                    <div class="mobile-menu__panel-body">
                      {entry.panel.columns.map((col) => (
                        <div class="mobile-menu__col">
                          <p class="mobile-menu__col-title">{col.title}</p>
                          <ul>
                            {col.links.map((link) => (
                              <li>
                                <a href={link.href} data-mobile-close>{link.label}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                      {entry.panel.featured?.cta && (
                        <a href={entry.panel.featured.cta.href} class="mobile-menu__featured" data-mobile-close>
                          <span>{entry.panel.featured.cta.label}</span>
                          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                            <path d="M8 1l5 5-5 5M1 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      )}
                    </div>
                  )}
                </details>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <footer class="mobile-menu__footer">
        <p class="mobile-menu__footer-eyebrow">Independent insurance research</p>
        <p class="mobile-menu__footer-text">No paid placement. No relentless sales calls.</p>
      </footer>
    </aside>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
  }

  /* ---- Accent strip at very top ---- */
  .site-header__strip {
    display: flex;
    height: 4px;
    width: 100%;
  }
  .site-header__strip-bar {
    flex: 1;
    height: 100%;
  }

  /* ---- Main bar ---- */
  .site-header__bar {
    height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
    box-shadow: 0 1px 3px rgba(44, 69, 119, 0.02);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-8);
    height: 100%;
  }
  .brand {
    display: flex; align-items: center;
    text-decoration: none; flex-shrink: 0;
    transition: opacity 0.15s;
  }
  .brand:hover { opacity: 0.88; }
  .brand__logo {
    height: 38px;
    width: auto;
    display: block;
  }

  /* ---- Megamenu trigger row ---- */
  .megamenu { height: 100%; min-width: 0; }
  .megamenu__list {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: var(--space-1); height: 100%; align-items: stretch;
    justify-content: flex-start;
  }
  .megamenu__item { position: static; display: flex; align-items: stretch; }
  .megamenu__top {
    background: none; border: 0;
    font-family: var(--font-display); font-weight: 600; font-size: 0.9375rem;
    color: var(--color-resolution);
    padding: 0 var(--space-5);
    cursor: pointer;
    display: inline-flex; align-items: center; gap: var(--space-2);
    position: relative;
    transition: color 0.15s;
    text-decoration: none;
    letter-spacing: -0.005em;
  }
  .megamenu__top::after {
    content: "";
    position: absolute;
    bottom: -1px; left: var(--space-5); right: var(--space-5);
    height: 3px;
    background: var(--color-malibu);
    border-radius: 2px 2px 0 0;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }
  .megamenu__top:hover,
  .megamenu__top[aria-expanded="true"] {
    color: var(--color-malibu);
  }
  .megamenu__top:hover::after,
  .megamenu__top[aria-expanded="true"]::after {
    transform: scaleX(1);
  }
  .megamenu__chevron {
    transition: transform 0.2s ease;
    opacity: 0.7;
  }
  .megamenu__top[aria-expanded="true"] .megamenu__chevron {
    transform: rotate(180deg);
  }

  /* ---- Megamenu panel ---- */
  .megamenu__panel {
    position: absolute; top: calc(var(--header-height) + 4px); left: 0; right: 0;
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    border-bottom: 4px solid var(--section-accent);
    box-shadow: 0 12px 36px rgba(44, 69, 119, 0.12);
    z-index: 49;
    animation: mm-in 0.22s ease;
  }
  .megamenu__panel[hidden] { display: none; }
  @keyframes mm-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .megamenu__panel-inner {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-12);
    padding-block: var(--space-10);
  }
  .megamenu__columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
  .megamenu__col-title {
    font-family: var(--font-display);
    font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--section-accent);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .megamenu__links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .megamenu__links a {
    display: block; padding: var(--space-3) var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    border-radius: var(--radius-sm);
    color: var(--color-text-strong);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .megamenu__links a:hover {
    background: var(--section-accent-soft);
    color: var(--section-accent);
  }
  .megamenu__link-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    display: block;
    line-height: 1.3;
  }
  .megamenu__link-desc {
    display: block; font-size: 0.8125rem; color: var(--color-text-muted);
    font-weight: 400; margin-top: 2px;
  }

  /* ---- Featured card in panel ---- */
  .megamenu__featured {
    background: linear-gradient(135deg, var(--section-accent-soft), color-mix(in srgb, var(--section-accent-soft) 60%, white));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex; flex-direction: column;
    position: relative; overflow: hidden;
  }
  .megamenu__featured::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--section-accent);
  }
  .megamenu__featured-art {
    position: absolute; right: -30px; top: -10px;
    width: 160px; opacity: 0.16; pointer-events: none;
  }
  .megamenu__featured-art img { width: 100%; }
  .megamenu__featured-body { position: relative; }
  .megamenu__featured-eyebrow {
    font-family: var(--font-display);
    font-size: 0.6875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--section-accent);
    margin: 0 0 var(--space-3);
  }
  .megamenu__featured-heading {
    font-family: var(--font-display);
    font-size: 1.25rem; font-weight: 700;
    color: var(--color-resolution);
    margin: 0 0 var(--space-3);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .megamenu__featured-text { color: var(--color-text); margin: 0 0 var(--space-5); font-size: 0.9375rem; line-height: 1.55; }
  .megamenu__featured-cta {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-display); font-weight: 700;
    color: var(--section-accent);
    font-size: 0.8125rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    text-decoration: none;
    transition: gap 0.2s;
  }
  .megamenu__featured-cta:hover { gap: var(--space-3); }
  .megamenu__featured-cta svg { transition: transform 0.2s; }
  .megamenu__featured-cta:hover svg { transform: translateX(3px); }

  /* ---- Actions cluster ---- */
  .site-header__actions {
    display: flex; align-items: center; gap: var(--space-3);
    flex-shrink: 0;
  }
  .header__cta {
    display: inline-flex; align-items: center; gap: var(--space-2);
    background: var(--color-resolution);
    color: var(--color-white);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-display); font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.005em;
    border-radius: 100px;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(44, 69, 119, 0.15);
    transition: background 0.18s, color 0.18s, transform 0.15s, box-shadow 0.18s;
  }
  .header__cta:hover {
    background: var(--color-malibu);
    color: var(--color-resolution);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(100, 188, 225, 0.35);
  }
  .header__cta svg { transition: transform 0.2s; }
  .header__cta:hover svg { transform: translateX(3px); }

  .header__menu-toggle {
    display: none;
    background: var(--color-alice);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    width: 40px;
    height: 40px;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .header__menu-toggle:hover {
    background: var(--color-white);
    border-color: var(--color-malibu);
  }
  .header__menu-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-resolution);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .header__menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header__menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .header__menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ============================================
     Mobile menu — backdrop scrim + slide-in panel
  ============================================ */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    visibility: hidden;
  }
  .mobile-menu.is-open {
    pointer-events: auto;
    visibility: visible;
  }
  .mobile-menu__scrim {
    position: absolute;
    inset: 0;
    background: rgba(44, 69, 119, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mobile-menu.is-open .mobile-menu__scrim {
    opacity: 1;
  }
  .mobile-menu__panel {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: min(420px, 100vw);
    background: var(--color-white);
    box-shadow: -8px 0 32px rgba(44, 69, 119, 0.15);
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  /* Top bar */
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-white);
    z-index: 2;
  }
  .mobile-menu__brand {
    display: inline-flex;
    text-decoration: none;
    flex-shrink: 0;
  }
  .mobile-menu__logo {
    height: 32px;
    width: auto;
    display: block;
  }
  .mobile-menu__close {
    background: var(--color-alice);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-resolution);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .mobile-menu__close:hover {
    background: var(--color-white);
    border-color: var(--color-malibu);
    color: var(--color-malibu);
  }

  /* ZIP CTA at the top of the mobile drawer */
  .mobile-menu__zip {
    padding: var(--space-5) var(--space-6);
    background: linear-gradient(180deg, var(--color-alice) 0%, var(--color-white) 100%);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-menu__zip-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    padding: 14px 20px;
    background: var(--color-resolution);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.005em;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.18s, color 0.18s, transform 0.15s;
  }
  .mobile-menu__zip-cta:hover,
  .mobile-menu__zip-cta:focus-visible {
    background: var(--color-malibu);
    color: var(--color-resolution);
  }
  .mobile-menu__zip-cta:active {
    transform: translateY(1px);
  }
  .mobile-menu__zip-cta svg { transition: transform 0.2s; }
  .mobile-menu__zip-cta:hover svg { transform: translateX(3px); }

  /* Nav */
  .mobile-menu__nav {
    padding: var(--space-4) var(--space-6) var(--space-6);
    flex: 1;
  }
  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu__item + .mobile-menu__item {
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__top-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-resolution);
    text-decoration: none;
    transition: color 0.15s;
  }
  .mobile-menu__top-link:hover { color: var(--color-malibu); }
  .mobile-menu__top-link svg {
    color: var(--color-ship-cove);
    transition: transform 0.2s, color 0.15s;
  }
  .mobile-menu__top-link:hover svg {
    color: var(--color-malibu);
    transform: translateX(3px);
  }

  .mobile-menu__details {
    --indicator: var(--color-ship-cove);
  }
  .mobile-menu__details summary {
    cursor: pointer;
    list-style: none;
    padding: var(--space-5) 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-resolution);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.15s;
  }
  .mobile-menu__details summary:hover { color: var(--color-malibu); }
  .mobile-menu__details summary::-webkit-details-marker { display: none; }
  .mobile-menu__chev {
    color: var(--indicator);
    transition: transform 0.25s ease, color 0.15s;
    flex-shrink: 0;
  }
  .mobile-menu__details[open] .mobile-menu__chev {
    transform: rotate(180deg);
    color: var(--color-malibu);
  }

  .mobile-menu__panel-body {
    padding: 0 0 var(--space-5);
    animation: mobileMenuExpand 0.25s ease-out;
  }
  @keyframes mobileMenuExpand {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mobile-menu__col {
    padding-bottom: var(--space-4);
  }
  .mobile-menu__col + .mobile-menu__col {
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
  }
  .mobile-menu__col-title {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
  }
  .mobile-menu__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu__col li a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    color: var(--color-text-strong);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.15s, padding-left 0.15s;
  }
  .mobile-menu__col li a::before {
    content: "";
    width: 4px;
    height: 4px;
    background: var(--color-malibu);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .mobile-menu__col li a:hover {
    color: var(--color-malibu);
    padding-left: 4px;
  }
  .mobile-menu__col li a:hover::before {
    opacity: 1;
  }

  .mobile-menu__featured {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-5);
    background: var(--color-alice);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    color: var(--color-resolution);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .mobile-menu__featured:hover {
    background: var(--color-malibu);
    border-color: var(--color-malibu);
    color: var(--color-white);
  }
  .mobile-menu__featured svg { transition: transform 0.2s; }
  .mobile-menu__featured:hover svg { transform: translateX(3px); }

  /* Footer */
  .mobile-menu__footer {
    padding: var(--space-6);
    background: var(--color-alice);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }
  .mobile-menu__footer-eyebrow {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-malibu);
    margin: 0 0 var(--space-2);
  }
  .mobile-menu__footer-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 1100px) {
    .megamenu__panel-inner { grid-template-columns: 1fr; }
    .megamenu__featured { max-width: 540px; }
    .megamenu__columns { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  }
  @media (max-width: 950px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
    }
    .megamenu { display: none; }
    .header__menu-toggle { display: flex; }
    .site-header__actions {
      justify-content: flex-end;
      grid-column: 3;
    }
  }
  @media (max-width: 720px) {
    /* Below tablet — hide the inline CTA, leave only the hamburger.
       The mobile drawer has its own CTA at the top. */
    .header__cta { display: none; }
  }
  @media (max-width: 600px) {
    .megamenu__columns { grid-template-columns: 1fr; }
    .site-header__inner { gap: var(--space-3); }
    .brand__logo { height: 32px; }
  }
  @media (max-width: 380px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-2);
    }
    .brand__logo { height: 28px; }
    .header__menu-toggle {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-mm-trigger]");
  const panels = document.querySelectorAll<HTMLDivElement>("[data-mm-panel]");
  let hideTimer: number | null = null;
  let activeIndex: number | null = null;

  function show(index: number) {
    if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
    if (activeIndex !== null && activeIndex !== index) hideImmediate(activeIndex);
    const trigger = triggers[index];
    const panel = panels[index];
    if (!trigger || !panel) return;
    trigger.setAttribute("aria-expanded", "true");
    panel.hidden = false;
    activeIndex = index;
  }
  function hideImmediate(index: number) {
    triggers[index]?.setAttribute("aria-expanded", "false");
    if (panels[index]) panels[index].hidden = true;
    if (activeIndex === index) activeIndex = null;
  }
  function scheduleHide(index: number) {
    if (hideTimer) clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => hideImmediate(index), 180);
  }

  triggers.forEach((trigger, i) => {
    const item = trigger.closest("li");
    if (!item) return;
    item.addEventListener("mouseenter", () => show(i));
    item.addEventListener("mouseleave", () => scheduleHide(i));
    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      if (expanded) hideImmediate(i); else show(i);
    });
    trigger.addEventListener("focus", () => show(i));
  });

  panels.forEach((panel, i) => {
    panel.addEventListener("mouseenter", () => {
      if (activeIndex !== i) return;
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
    });
    panel.addEventListener("mouseleave", () => scheduleHide(i));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && activeIndex !== null) {
      const i = activeIndex;
      hideImmediate(i);
      triggers[i]?.focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (activeIndex === null) return;
    const target = e.target as Node;
    const trigger = triggers[activeIndex];
    const panel = panels[activeIndex];
    if (trigger && trigger.contains(target)) return;
    if (panel && panel.contains(target)) return;
    hideImmediate(activeIndex);
  });

  // ---- Mobile menu ----
  const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const mobileDrawer = document.querySelector<HTMLElement>("[data-mobile-drawer]");
  const mobileScrim = document.querySelector<HTMLElement>("[data-mobile-scrim]");
  const mobileCloseEls = document.querySelectorAll<HTMLElement>("[data-mobile-close]");

  function openMobileMenu() {
    if (!mobileDrawer || !mobileToggle) return;
    mobileDrawer.classList.add("is-open");
    mobileDrawer.setAttribute("aria-hidden", "false");
    mobileToggle.setAttribute("aria-expanded", "true");
    mobileToggle.setAttribute("aria-label", "Close menu");
    document.body.style.overflow = "hidden";
  }
  function closeMobileMenu() {
    if (!mobileDrawer || !mobileToggle) return;
    mobileDrawer.classList.remove("is-open");
    mobileDrawer.setAttribute("aria-hidden", "true");
    mobileToggle.setAttribute("aria-expanded", "false");
    mobileToggle.setAttribute("aria-label", "Open menu");
    document.body.style.overflow = "";
  }

  mobileToggle?.addEventListener("click", () => {
    if (mobileDrawer?.classList.contains("is-open")) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  mobileScrim?.addEventListener("click", closeMobileMenu);
  mobileCloseEls.forEach((el) => el.addEventListener("click", closeMobileMenu));

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Escape" && mobileDrawer?.classList.contains("is-open")) {
      closeMobileMenu();
    }
  });
</script>
