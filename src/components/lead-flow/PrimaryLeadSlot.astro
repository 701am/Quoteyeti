---
/**
 * PrimaryLeadSlot
 * ===============
 * The top "Our top match for you" slot on the thank-you page.
 * Reserved for the CUSTOM agent leadflow — i.e. the primary lead sale
 * that goes to QuoteYeti's preferred buyer at top dollar before any
 * partner offers are shown.
 *
 * Today: renders a clean "Connecting you with your dedicated agent…"
 * placeholder so the slot is visible in the layout even before wiring.
 *
 * TO WIRE (when you have the buyer adapter):
 *   1. Submit lead from the form's submit handler to your buyer's API
 *      (or to a Netlify Function that does the POST server-side).
 *   2. If the buyer accepts: render their agent contact info / next steps.
 *   3. If the buyer declines: hide this slot, let partner offers carry.
 *   4. Replace the contents of this component with the real card.
 *
 * Until then, the slot is a styled "We're working on it" card that
 * matches the visual rhythm of the partner-offers grid below.
 */
import type { Vertical } from "~/data/verticals";

interface Props {
  vertical: Vertical;
}
const { vertical } = Astro.props as Props;
---

<section class="primary-lead" aria-label="Your top match">
  <p class="primary-lead__eyebrow">Our top match for you</p>
  <div class="primary-lead__card">
    <div class="primary-lead__art" aria-hidden="true">
      <div class="primary-lead__pulse"></div>
      <svg viewBox="0 0 32 32" width="32" height="32" fill="none">
        <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="2"/>
        <path d="M11 16l4 4 6-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="primary-lead__body">
      <p class="primary-lead__label">Dedicated agent · {vertical.short} insurance</p>
      <h3 class="primary-lead__heading">
        We're connecting you with your <span class="serif-italic">dedicated agent</span>.
      </h3>
      <p class="primary-lead__text">
        Based on your profile, we've matched you with one of our top licensed agents who specializes in {vertical.short.toLowerCase()} insurance. They'll reach out within minutes at the email and phone you provided.
      </p>
      <ul class="primary-lead__list">
        <li>Personalized quote tailored to your situation</li>
        <li>Licensed in your state · zero pressure</li>
        <li>Hand-picked match — not a call-center auto-routing</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .primary-lead {
    margin-bottom: var(--space-10);
  }
  .primary-lead__eyebrow {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-malibu);
    margin: 0 0 var(--space-4);
    text-align: center;
  }
  .primary-lead__card {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: var(--space-6);
    background: linear-gradient(135deg, var(--color-resolution) 0%, #1F3361 100%);
    color: var(--color-white);
    border-radius: 20px;
    padding: var(--space-8) var(--space-8);
    box-shadow: 0 8px 28px rgba(44, 69, 119, 0.25);
    position: relative;
    overflow: hidden;
  }
  /* Subtle topographic accent */
  .primary-lead__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 90% 10%, rgba(100, 188, 225, 0.18) 0%, transparent 50%);
    pointer-events: none;
  }

  .primary-lead__art {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(100, 188, 225, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-malibu);
    position: relative;
    flex-shrink: 0;
  }
  .primary-lead__pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--color-malibu);
    opacity: 0;
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0%   { transform: scale(0.85); opacity: 0.7; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  .primary-lead__body { position: relative; }
  .primary-lead__label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-malibu);
    margin: 0 0 var(--space-3);
  }
  .primary-lead__heading {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-white);
    margin: 0 0 var(--space-4);
  }
  .primary-lead__heading .serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--color-malibu);
  }
  .primary-lead__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 var(--space-5);
  }
  .primary-lead__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .primary-lead__list li {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
    padding-left: var(--space-5);
    position: relative;
  }
  .primary-lead__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    background: var(--color-malibu);
    border-radius: 50%;
  }

  @media (max-width: 600px) {
    .primary-lead__card {
      grid-template-columns: 1fr;
      padding: var(--space-7) var(--space-6);
    }
    .primary-lead__art { margin: 0 auto; }
  }
</style>
